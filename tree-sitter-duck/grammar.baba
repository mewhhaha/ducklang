grammar Duck

skip _whitespace = /[ \t\r\n]+/ ;
skip comment = /\/\/[^\r\n]*/ ;
contextual _application_space priority 1 = /[ \t]+/ ;
contextual _condition_application_space priority 1 = /[ \t]+/ ;
contextual _type_application_space priority 1 = /[ \t]+/ ;
contextual _tactic_space priority 1 = /[ \t\r\n]+/ ;
contextual _immediate_type_open priority 3 = /\(/ ;
contextual _fixity_identifier priority 1 = /(infixl|infixr|infix|prefix)/ ;

token grouped_value_alternative_pattern priority 3 = /\([A-Za-z][A-Za-z0-9_]*([ \t\r\n]*\|[ \t\r\n]*[A-Za-z][A-Za-z0-9_]*)+\)/ ;
contextual lowercase_identifier priority 2 = /[a-z][A-Za-z0-9_]*/ ;
token identifier = /([A-Za-z][A-Za-z0-9_]{0,1}|[A-Za-df-z][A-Za-z0-9_]{2}|e[A-Za-mo-z0-9_][A-Za-z0-9_]|en[A-Zace-z0-9_]|[A-Za-km-z][A-Za-z0-9_]{3}|l[A-Za-np-z0-9_][A-Za-z0-9_]{2}|lo[A-Za-np-z0-9_][A-Za-z0-9_]|loo[A-Za-oq-z0-9_]|[A-Za-z][A-Za-z0-9_]{4}[A-Za-z0-9_]*)/ ;
contextual constructor_identifier priority 2 = /[A-Z][A-Za-z0-9_]*/ ;
token prefix_requires_keyword priority 3 = /requires/ ;
token prefix_ensures_keyword priority 3 = /ensures/ ;
token prefix_decreases_keyword priority 3 = /decreases/ ;
token prefix_implies_keyword priority 3 = /implies/ ;
token prefix_or_keyword priority 3 = /or/ ;
token prefix_and_keyword priority 3 = /and/ ;
token prefix_not_keyword priority 3 = /not/ ;
token prefix_forall_keyword priority 3 = /forall/ ;
token prefix_exists_keyword priority 3 = /exists/ ;
contextual prefix_proof_keyword priority 3 = /Proof/ ;
contextual proof_prefixed_identifier priority 4 = /Proof_[A-Za-z0-9_]*/ ;
token intrinsic_identifier = /@[A-Za-z][A-Za-z0-9_]*(\.[A-Za-z][A-Za-z0-9_]*)*/ ;
token operator_symbol priority 0 = /([-!$%&*+<>?@\\^|~:][.\-!$%&*+\/<=>?@\\^|~:]*|\/([.\-!$%&*+<=>?@\\^|~:][.\-!$%&*+\/<=>?@\\^|~:]*)?|=[.\-!$%&*+\/<=?@\\^|~:][.\-!$%&*+\/<=>?@\\^|~:]*)/ ;
contextual effect_identifier priority 1 = /[A-Z][A-Za-z0-9]*/ ;
token underscore_identifier = /_[A-Za-z0-9_]+/ ;
token number = /(0[xX][0-9a-fA-F]+([iu][1-9][0-9]*)?|[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?([iu][1-9][0-9]*|f(32|64))?)/ ;
token string = /"([^"\\\n\r]|\\[ntr"\\])*"/ ;
token character = /'([^'\\\n\r]|\\[ntr'\\])'/ ;
contextual template_start priority 2 = /`/ ;
contextual template_text priority 1 = /([^`{}\\]|\\[ntr`\\]|\{\{|\}\})+/ ;
document = (
             (
               module_header
               ((_module_statement (";")?))*
               module_return_statement
             )
             | ((_top_level_statement (";")?))+
           ) ;

module_header = ("module" parameters:(parameter_list) "where") ;

_top_level_statement = (_module_statement | top_level_return_statement) ;

_module_statement = (
                      declare_effect_statement
                      | effect_statement
                      | declare_record_statement
                      | prefix_signature_statement
                      | prefix_fact_statement
                      | prefix_unsafe_proof_statement
                      | type_declaration_statement
                      | duck_declaration_statement
                      | extension_declaration_statement
                      | fixity_declaration_statement
                      | module_binding_statement
                      | effect_binding_statement
                      | resume_dup_statement
                      | binding_statement
                      | type_pattern_statement
                      | for_statement
                      | break_statement
                      | continue_statement
                      | index_assignment
                      | assignment
                      | expression_statement
                    ) ;

_statement = (
               effect_binding_statement
               | resume_dup_statement
               | prefix_signature_statement
               | prefix_fact_statement
               | prefix_unsafe_proof_statement
               | binding_statement
               | type_pattern_statement
               | return_statement
               | for_statement
               | break_statement
               | continue_statement
               | index_assignment
               | assignment
               | expression_statement
             ) ;

binding_statement = (
                      (attribute:(attribute_group))*
                      ((kind:("let") (recursive:("rec"))?) | (kind:("const") (open:("open"))?))
                      (linear:("!"))?
                      name:(_binding_pattern)
                      ((":" type:(type_reference)))?
                      "="
                      value:(_expression)
                      (
                        (
                          "and"
                          mutual_name:(identifier)
                          ((":" mutual_type:(type_reference)))?
                          "="
                          mutual_value:(_expression)
                        )
                      )*
                      (("else" alternative:(block)))?
                      ";"
                    ) ;

prefix_unsafe_proof_statement = (
                                 unsafe:("unsafe")
                                 definition:(binding_statement)
                               ) ;

effect_row = _effect_row_expression ;

_effect_row_expression = (
                           effect_union_expression
                           | effect_intersection_expression
                           | effect_difference_expression
                           | parenthesized_effect_expression
                           | effect_family_reference
                           | effect_row_variable
                           | effect_operation_reference
                         ) ;

effect_union_expression = (left:(_effect_row_expression) ":|" right:(_effect_row_expression)) ;

effect_intersection_expression = (
                                   left:(_effect_row_expression)
                                   ":&"
                                   right:(_effect_row_expression)
                                 ) ;

effect_difference_expression = (left:(_effect_row_expression) ":-" right:(_effect_row_expression)) ;

parenthesized_effect_expression = ("(" value:(_effect_row_expression) ")") ;

effect_family_reference = effect:(effect_identifier) ;

effect_row_variable = name:(row_variable) ;

row_variable = (lowercase_identifier | "_" | underscore_identifier) ;

effect_operation_reference = (
                               effect:(effect_identifier)
                               "."
                               operation:((identifier | "end"))
                             ) ;

effect_binding_statement = (
                             name:(
                               (
                                 identifier
                                 | _fixity_identifier_alias
                                 | wildcard
                                 | unit_pattern
                               )
                             )
                             "<-"
                             value:(_expression)
                           ) ;

resume_dup_statement = (
                         "let"
                         "("
                         "!"
                         left:(identifier)
                         ","
                         "!"
                         right:(identifier)
                         ")"
                         "="
                         "dup"
                         value:(linear_reference)
                         ";"
                       ) ;

unit_pattern = ("(" ")") ;

type_pattern_statement = (
                           "let"
                           pattern:(type_pattern)
                           "="
                           value:(_expression)
                           ";"
                         ) ;

declare_effect_statement = (
                             (attribute:(attribute_group))*
                             "declare"
                             "effect"
                             name:(effect_identifier)
                             operations:(effect_operation_block)
                           ) ;

effect_statement = (
                     (attribute:(attribute_group))*
                     "effect"
                     name:(effect_identifier)
                     (parameter:(identifier))*
                     operations:(effect_operation_block)
                   ) ;

effect_operation_block = ("{" ((effect_operation (",")?))* "}") ;

effect_operation = (
                     ("suspending")?
                     name:((identifier | "end"))
                     ":"
                     (forall:(effect_operation_forall))?
                     parameters:(host_parameter_list)
                     "=>"
                     result:(host_result)
                   ) ;

effect_operation_forall = ("forall" (parameter:(identifier))+ ".") ;

declare_record_statement = (
                             (attribute:(attribute_group))*
                             "declare"
                             name:(identifier)
                             fields:(type_field_block)
                           ) ;

type_declaration_statement = (
                               (attribute:(attribute_group))*
                               "type"
                               name:(identifier)
                               (parameter:(identifier))*
                               "="
                               definition:(
                                 (
                                   type_sum
                                   | type_product
                                   | struct_type
                                   | newtype_type
                                   | packed_type
                                   | type_reference
                                 )
                               )
                             ) ;

newtype_type = ("newtype" representation:(type_reference)) ;

packed_type = ("packed" (type_product | struct_type)) ;

duck_declaration_statement = (
                               (attribute:(attribute_group))*
                               "duck"
                               name:(identifier)
                               (role:(identifier))+
                               members:(duck_member_block)
                             ) ;

duck_member_block = ("{" (((duck_type_member | duck_member) (",")?))+ "}") ;

duck_type_member = ("type" name:(identifier) (("=" default:(type_reference)))?) ;

duck_member = ("." name:((identifier | "end")) "=" type:(type_reference)) ;

extension_declaration_statement = (
                                    (attribute:(attribute_group))*
                                    "extend"
                                    type:(identifier)
                                    (parameter:(identifier))*
                                    members:(extension_member_block)
                                  ) ;

extension_member_block = (
                           "{"
                           (
                             (
                               (extension_type_member | shape_field)
                               (
                                 (("," | ";") (extension_type_member | shape_field))
                               )*
                               (("," | ";"))?
                             )
                           )?
                           "}"
                         ) ;

extension_type_member = ("type" name:(identifier) "=" type:(type_reference)) ;

fixity_declaration_statement = (
                                 (attribute:(attribute_group))*
                                 fixity:(("infixl" | "infixr" | "infix" | "prefix"))
                                 precedence:(number)
                                 operator:(operator_symbol)
                                 "="
                                 target:(fixity_target)
                               ) ;

prefix_signature_statement = (
                               "type"
                               name:(lowercase_identifier)
                               "="
                               signature:(prefix_signature_type)
                               clauses:(prefix_contract_clause)*
                             ) ;

prefix_signature_type = (
                         ("forall" (parameter:(prefix_signature_binder))+ "." body:(prefix_signature_type))
                         | prefix_signature_function_type
                       ) ;

prefix_signature_function_type = (
                                  parameters:(prefix_signature_parameter_list)
                                  "->"
                                  result:(prefix_signature_result)
                                ) ;

prefix_signature_parameter_list = (
                                   "("
                                   (((prefix_signature_parameter ("," prefix_signature_parameter)*) (",")?)?)
                                   ")"
                                 ) ;

prefix_signature_parameter = (
                              name:(identifier)
                              ":"
                              type:(prefix_signature_value_type)
                            ) ;

prefix_signature_binder = (
                           "("
                           name:(lowercase_identifier)
                           ":"
                           type:(type_reference)
                           ")"
                         ) ;

prefix_signature_result = (
                           ("(" name:("result") ":" type:(prefix_signature_value_type) ")")
                           | type:(prefix_signature_value_type)
                         ) ;

prefix_signature_value_type = (
                              prefix_proof_type
                              | prefix_refinement_type
                              | type_reference
                            ) ;

prefix_proof_type = (
                    prefix_proof_keyword
                    proposition:(prefix_proposition)
                  ) ;

prefix_refinement_type = (
                          "{"
                          name:(lowercase_identifier)
                          ":"
                          value:(type_reference)
                          "|"
                          proposition:(prefix_proposition)
                          "}"
                        ) ;

prefix_contract_clause = (
                          (prefix_requires_keyword proposition:(prefix_proposition))
                          | (prefix_ensures_keyword proposition:(prefix_proposition))
                          | (prefix_decreases_keyword metric:(_expression))
                        ) ;

prefix_proposition = (
                     prefix_quantified_proposition
                     | prefix_implication_proposition
                   ) ;

prefix_implication_proposition = (
                                  premise:(prefix_disjunction_proposition)
                                  ((prefix_implies_keyword conclusion:(prefix_implication_proposition)))?
                                ) ;

prefix_disjunction_proposition = (
                                  first:(prefix_conjunction_proposition)
                                  ((prefix_or_keyword rest:(prefix_conjunction_proposition)))*
                                ) ;

prefix_conjunction_proposition = (
                                  first:(prefix_negation_proposition)
                                  ((prefix_and_keyword rest:(prefix_negation_proposition)))*
                                ) ;

prefix_negation_proposition = (
                               (prefix_not_keyword proposition:(prefix_negation_proposition))
                               | prefix_atomic_proposition
                             ) ;

prefix_quantified_proposition = (
                                 quantifier:((prefix_forall_keyword | prefix_exists_keyword))
                                 binder:(prefix_proposition_binder)
                                 "."
                                 proposition:(prefix_proposition)
                               ) ;

prefix_proposition_binder = (
                             "("
                             name:(identifier)
                             ":"
                             type:(type_reference)
                             ")"
                           ) ;

prefix_atomic_proposition = (
                              "True"
                              | "False"
                              | ("(" proposition:(prefix_proposition) ")")
                              | (
                                  left:(prefix_proposition_term)
                                  operator:(("=" | "!=" | "<" | "<="))
                                  right:(prefix_proposition_term)
                                )
                              | (
                                  value:(prefix_proposition_term)
                                  operator:("is")
                                  type:(_prefix_membership_type)
                                )
                              | prefix_proposition_term
                            ) ;

_prefix_membership_type = (constructor_membership_type | type_reference) ;

constructor_membership_type = ("#" name:(constructor_identifier)) ;

prefix_proposition_term = (
                           prefix_proposition_binary_term
                           | prefix_proposition_unary_term
                           | prefix_proposition_postfix_term
                         ) ;

prefix_proposition_binary_term = (
                                  left:(prefix_proposition_term)
                                  operator:(operator_symbol)
                                  right:(prefix_proposition_term)
                                ) ;

prefix_proposition_unary_term = (
                                 operator:(("!" | "&" | "freeze" | "comptime" | operator_symbol))
                                 operand:(prefix_proposition_term)
                               ) ;

prefix_proposition_postfix_term = (
                                   prefix_proposition_call_term
                                   | prefix_proposition_field_term
                                   | prefix_proposition_index_term
                                   | prefix_proposition_parenthesized_term
                                   | number
                                   | string
                                   | character
                                   | boolean
                                   | atom_expression
                                   | import_meta_expression
                                   | intrinsic_identifier
                                   | identifier
                                   | _aggregate_constructor_identifier
                                   | _effect_identifier_alias
                                   | linear_reference
                                 ) ;

prefix_proposition_call_term = (
                                function:(prefix_proposition_postfix_term)
                                argument:(prefix_proposition_call_arguments)
                              ) ;

prefix_proposition_call_arguments = (
                                     "("
                                     (
                                       (
                                         prefix_proposition_term
                                         (("," prefix_proposition_term))*
                                       )
                                       (",")?
                                     )?
                                     ")"
                                   ) ;

prefix_proposition_field_term = (
                                 object:(prefix_proposition_postfix_term)
                                 "."
                                 field:((identifier | "end"))
                               ) ;

prefix_proposition_index_term = (
                                 object:(prefix_proposition_postfix_term)
                                 open:(_index_open)
                                 (_index_contents)?
                                 "]"
                               ) ;

prefix_proposition_parenthesized_term = ("(" prefix_proposition_term ")") ;

prefix_fact_statement = (
                         (("opaque")? "fact")
                         name:(lowercase_identifier)
                         "="
                         value:(prefix_fact_value)
                       ) ;

prefix_fact_value = (
                     parameters:(prefix_fact_parameters)
                     "=>"
                     body:(prefix_proposition)
                   ) ;

prefix_fact_parameters = (
                          name:(identifier)
                          | (
                              "("
                              (((name:(identifier) ("," name:(identifier))*) (",")?)?)
                              ")"
                            )
                        ) ;

prefix_by_proof_expression = (
                               "by"
                               (
                                 proof:(prefix_proof_term)
                                 | tactics:(prefix_tactic_block)
                               )
                             ) ;

prefix_tactic_block = (
                        "{"
                        (command:(prefix_tactic_command))*
                        (command:(prefix_final_tactic_command))?
                        "}"
                      ) ;

prefix_tactic_command = (
                          ("exact" _tactic_space proof:(prefix_proof_term))
                          | ("assumption" _tactic_space)
                          | ("intro" _tactic_space name:(identifier))
                          | ("constructor" _tactic_space)
                          | ("left" _tactic_space)
                          | ("right" _tactic_space)
                        ) ;

prefix_final_tactic_command = (
                                "assumption"
                                | "constructor"
                                | "left"
                                | "right"
                              ) ;

prefix_proof_term = (
                     (
                       name:(identifier)
                       "=>"
                       body:(prefix_proof_term)
                     )
                     | (
                         "unsafe"
                         "{"
                         "assume"
                         proposition:(prefix_proposition)
                         "}"
                       )
                     | (
                         "or_cases"
                         "("
                         proof:(prefix_proof_term)
                         ","
                         left_name:(identifier)
                         "=>"
                         left_body:(prefix_proof_term)
                         ","
                         right_name:(identifier)
                         "=>"
                         right_body:(prefix_proof_term)
                         (",")?
                         ")"
                       )
                     | (
                         "forall_apply"
                         "("
                         proof:(prefix_proof_term)
                         ","
                         argument:(prefix_proposition_term)
                         (",")?
                         ")"
                       )
                     | (
                         "exists_intro"
                         "("
                         witness:(prefix_proposition_term)
                         ","
                         proof:(prefix_proof_term)
                         (",")?
                         ")"
                       )
                     | (
                         "exists_elim"
                         "("
                         proof:(prefix_proof_term)
                         ","
                         witness_name:(identifier)
                         ","
                         evidence_name:(identifier)
                         "=>"
                         body:(prefix_proof_term)
                         (",")?
                         ")"
                       )
                     | (
                         "congr"
                         "("
                         parameter_name:(identifier)
                         "=>"
                         function:(prefix_proposition_term)
                         ","
                         proof:(prefix_proof_term)
                         (",")?
                         ")"
                       )
                     | (
                         "transport"
                         "("
                         equality:(prefix_proof_term)
                         ","
                         motive_name:(identifier)
                         "=>"
                         motive:(prefix_proposition)
                         ","
                         proof:(prefix_proof_term)
                         (",")?
                         ")"
                       )
                     | name:(identifier)
                     | "refl"
                     | "true_intro"
                     | (
                         operator:(
                           (
                             "symm"
                             | "and_left"
                             | "and_right"
                             | "or_left"
                             | "or_right"
                             | "false_elim"
                           )
                         )
                         "("
                         proof:(prefix_proof_term)
                         ")"
                       )
                     | (
                         operator:(
                           (
                             "trans"
                             | "and_intro"
                             | "implies_apply"
                           )
                         )
                         "("
                         left:(prefix_proof_term)
                         ","
                         right:(prefix_proof_term)
                         (",")?
                         ")"
                       )
                     | ("(" proof:(prefix_proof_term) ")")
                   ) ;


fixity_target = (
                  _intrinsic_fixity_target
                  | _qualified_fixity_target
                  | identifier
                  | intrinsic_identifier
                ) ;

qualified_identifier = (identifier "." identifier (("." identifier))*) ;

type_sum = (("|")? type_case (("|" type_case))*) ;

type_case = ("#" name:(constructor_identifier) (payload:(_type_intersection_reference))?) ;

type_product = positional_type_product ;

named_type_field = ("." name:((identifier | "end")) "=" type:(type_reference)) ;

positional_type_product = (
                            (
                              "("
                              ((type_reference "," (type_reference (("," type_reference))*)) (",")?)
                              ")"
                            )
                            | (
                                "("
                                element:(type_reference)
                                ";"
                                length:((_expression | wildcard))
                                ")"
                              )
                            | ("[" (((type_reference (("," type_reference))*) (",")?))? "]")
                          ) ;

module_binding_statement = (
                             (attribute:(attribute_group))*
                             "module"
                             name:(identifier)
                             "="
                             value:(_expression)
                           ) ;

host_parameter_list = ("(" (((host_parameter (("," host_parameter))*) (",")?))? ")") ;

host_parameter = (
                   (contract:(("&" | "#" | "scalar")) type:(type_reference))
                   | type:(type_reference)
                 ) ;

host_result = ((contract:(("#" | "scalar")) type:(type_reference)) | type:(type_reference)) ;

return_statement = ("return" ((value:(_expression) ";") | ";")) ;

top_level_return_statement = ("return" ((value:(_expression) ";") | ";")) ;

module_return_statement = ("return" exports:(shape_value) ";") ;

break_statement = ("break" (value:(_expression))? ";") ;

continue_statement = ("continue" ";") ;

assignment = (
               name:((identifier | _fixity_identifier_alias))
               operator:(("=" | ":="))
               value:(_expression)
             ) ;

index_assignment = (
                     name:((identifier | _fixity_identifier_alias))
                     open:(_index_open)
                     (_index_contents)?
                     "]"
                     "="
                     value:(_expression)
                   ) ;

for_statement = (
                  _array_union_for_statement
                  | (
                    "for"
                    first:(_match_pattern)
                    (("," second:(_match_pattern)))?
                    "in"
                    start_or_collection:(condition_expression)
                    (
                      (
                        (".." | "..=")
                        end:(condition_expression)
                        (("by" step:(condition_expression)))?
                      )
                    )?
                    body:(_collection_range_body)
                  )
                  | (
                      "for"
                      start:(condition_expression)
                      (".." | "..=")
                      end:(condition_expression)
                      (("by" step:(condition_expression)))?
                      body:(_numeric_range_body)
                    )
                ) ;

_array_union_for_statement = (
                               "for"
                               first:(
                                 _array_union_alternative_pattern
                                 | _array_union_pattern
                               )
                               (("," second:(_match_pattern)))?
                               "in"
                               start_or_collection:(condition_expression)
                               (
                                 (
                                   (".." | "..=")
                                   end:(condition_expression)
                                   (("by" step:(condition_expression)))?
                                 )
                               )?
                               body:(_collection_range_body)
                             ) ;

_array_union_alternative_pattern = _array_union_alternative_pattern_body ;

_array_union_alternative_pattern_body = (
                                          _array_union_pattern
                                          ((_pattern_pipe _single_match_pattern))+
                                        ) ;

_array_union_pattern = _array_union_pattern_body ;

_array_union_pattern_body = (
                              "#"
                              case:(constructor_identifier)
                              value:(_immediate_array_pattern)
                            ) ;

_immediate_array_pattern = _immediate_array_pattern_body ;

_immediate_array_pattern_body = (
                                  _index_open
                                  (
                                    (
                                      _array_pattern_element
                                      (("," _array_pattern_element))*
                                    )
                                    (",")?
                                  )?
                                  "]"
                                ) ;

expression_statement = _expression ;

_expression = (
                try_with_expression
                | loop_expression
                | arrow_function
                | recursive_function
                | recursive_call_expression
                | if_expression
                | case_function_expression
                | case_expression
                | binary_expression
                | is_expression
                | as_expression
                | unary_expression
                | application_expression
                | postfix_expression
                | effect_handler_expression
              ) ;

try_with_expression = ("try" body:(_expression) (("with" handler:(_expression)))?) ;

arrow_function = (_shape_arrow | _effect_arrow | _value_arrow) ;

recursive_function = (
                       "rec"
                       parameters:(
                         (
                           identifier
                           | _fixity_identifier_alias
                           | wildcard
                           | parameter_list
                           | bracket_parameter_list
                         )
                       )
                       "=>"
                       body:(_expression)
                     ) ;

recursive_call_expression = ("rec" argument:(parenthesized_or_product)) ;

parameter_list = ("(" (((parameter (("," parameter))*) (",")?))? ")") ;

bracket_parameter_list = ("[" (((parameter (("," parameter))*) (",")?))? "]") ;

parameter = (
              ((("const" ("...")?) | "!"))?
              name:((identifier | _fixity_identifier_alias | wildcard))
              ((":" type:(type_reference)))?
            ) ;

if_expression = (
                  "if"
                  (
                    ("let" pattern:(_match_pattern) "=" value:(condition_expression))
                    | ("(" ("let" pattern:(_match_pattern) "=" value:(condition_expression)) ")")
                    | condition:(condition_expression)
                  )
                  "then"
                  consequence:(conditional_branch)
                  (else_if_clause)*
                  (else_clause)?
                  "end"
                ) ;

else_if_clause = (
                   "else"
                   (
                     ("let" pattern:(_match_pattern) "=" value:(_expression))
                     | ("(" ("let" pattern:(_match_pattern) "=" value:(_expression)) ")")
                     | condition:(_expression)
                   )
                   "then"
                   consequence:(conditional_branch)
                 ) ;

else_clause = ("else" alternative:(conditional_branch)) ;

conditional_branch = ((_statement (";")?))+ ;

union_pattern = (
                  "#"
                  case:(constructor_identifier)
                  (
                    (
                      _application_space
                      value:(
                        identifier
                        | wildcard
                      )
                    )
                    | (
                      _application_space
                      value:(
                        unit_pattern
                        | union_pattern
                        | array_pattern
                        | positional_product_pattern
                      )
                    )
                    | value:(
                        unit_pattern
                        | union_pattern
                        | array_pattern
                        | positional_product_pattern
                      )
                  )?
                ) ;

condition_expression = (
                         condition_binary_expression
                         | condition_is_expression
                         | condition_unary_expression
                         | condition_application_expression
                         | condition_postfix_expression
                         | union_case
                       ) ;

condition_postfix_expression = (
                                 condition_call_expression
                                 | condition_field_expression
                                 | condition_index_expression
                                 | condition_parenthesized_expression
                                 | number
                                 | string
                         | character
                         | boolean
                         | atom_expression
                         | import_meta_expression
                         | intrinsic_identifier
                                 | identifier
                                 | _aggregate_constructor_identifier
                                 | _effect_identifier_alias
                                 | linear_reference
                               ) ;

condition_binary_expression = (
                                left:(condition_expression)
                                operator:(operator_symbol)
                                right:(condition_expression)
                              ) ;

condition_is_expression = (value:(condition_expression) operator:("is") type:(type_reference)) ;

condition_unary_expression = (
                               operator:(
                                 ("!" | "&" | "freeze" | "comptime" | "perform" | operator_symbol)
                               )
                               operand:(condition_expression)
                             ) ;

condition_call_expression = (
                              function:(condition_postfix_expression)
                              (_condition_application_space)?
                              argument:(condition_call_arguments)
                            ) ;

condition_call_arguments = (
                             "("
                             (
                               (
                                 condition_expression
                                 (("," condition_expression))*
                               )
                               (",")?
                             )?
                             ")"
                           ) ;

condition_application_expression = (
                                     function:(
                                       condition_application_expression
                                       | condition_postfix_expression
                                     )
                                     _condition_application_space
                                     argument:((condition_postfix_expression | union_case))
                                   ) ;

condition_field_expression = (
                               (
                                 object:(condition_postfix_expression)
                                 "."
                                 field:((identifier | "end"))
                               )
                               | (object:(_effect_identifier_alias) "." field:((identifier | "end")))
                             ) ;

condition_index_expression = (
                               object:((condition_postfix_expression | union_case))
                               open:(_index_open)
                               (_index_contents)?
                               "]"
                             ) ;

condition_parenthesized_expression = ("(" condition_expression ")") ;

condition_positional_product = (
                                 "("
                                 condition_expression
                                 ","
                                 (
                                   condition_expression
                                   (("," condition_expression))*
                                 )
                                 (",")?
                                 ")"
                               ) ;

binary_expression = (left:(_expression) operator:(operator_symbol) right:(_expression)) ;

is_expression = (value:(_expression) operator:("is") type:(type_reference)) ;

as_expression = (value:(_expression) as_keyword type:(type_reference)) ;

unary_expression = (
                     operator:(("!" | "&" | "freeze" | "comptime" | "perform" | operator_symbol))
                     operand:(_expression)
                   ) ;

scratch_expression = ("scratch" body:(block)) ;

loop_expression = ("loop" body:(block)) ;

case_function_expression = (
                             "case"
                             "=>"
                             "of"
                             arm:(case_arm)
                             (("," arm:(case_arm)))*
                           ) ;

case_expression = (
                    "case"
                    target:((condition_expression | condition_positional_product))
                    "of"
                    arm:(case_arm)
                    (("," arm:(case_arm)))*
                  ) ;

case_arm = (
             pattern:(_match_pattern)
             (("if" guard:(condition_expression)))?
             "=>"
             body:(_expression)
           ) ;

_match_pattern = (alternative_pattern | _single_match_pattern) ;

_binding_pattern = (_binding_alternative_pattern | _single_binding_pattern) ;

_binding_alternative_pattern = (
                                 _single_binding_pattern
                                 ((_pattern_pipe _single_binding_pattern))+
                               ) ;

_single_binding_pattern = (
                            const_value_pattern
                            | union_pattern
                            | number
                            | string
                            | character
                            | boolean
                            | identifier
                            | _aggregate_constructor_identifier
                            | wildcard
                            | array_pattern
                            | positional_product_pattern
                            | named_shape_pattern
                          ) ;

alternative_pattern = (_single_match_pattern ((_pattern_pipe _single_match_pattern))+) ;

_single_match_pattern = (
                          const_value_pattern
                          | type_pattern
                          | union_pattern
                          | number
                          | string
                          | character
                          | boolean
                          | identifier
                          | _aggregate_constructor_identifier
                          | wildcard
                          | array_pattern
                          | positional_product_pattern
                          | named_shape_pattern
                        ) ;

application_expression = (
                           function:((application_expression | postfix_expression))
                           _application_space
                           argument:(postfix_expression)
                         ) ;

postfix_expression = (
                       call_expression
                       | field_expression
                       | index_expression
                       | _primary_expression
                     ) ;

call_expression = (
                    function:(postfix_expression)
                    argument:(parenthesized_or_product)
                  ) ;

field_expression = (
                     (
                       object:(postfix_expression)
                       "."
                       field:((identifier | "end"))
                     )
                     | (object:(_effect_identifier_alias) "." field:((identifier | "end")))
                   ) ;

index_expression = (
                     object:(postfix_expression)
                     open:(_index_open)
                     (_index_contents)?
                     "]"
                   ) ;

effect_handler_expression = (
                              "handler"
                              effect:(effect_identifier)
                              clauses:(handler_clause_block)
                            ) ;

handler_clause_block = ("{" ((handler_operation_clause (",")?))* handler_return_clause (",")? "}") ;

handler_operation_clause = (
                             name:((identifier | "end"))
                             ":"
                             value:(arrow_function)
                           ) ;

handler_return_clause = ("return" ":" value:(arrow_function)) ;

_primary_expression = (
                        prefix_by_proof_expression
                        | number
                        | string
                        | character
                        | template_literal
                        | boolean
                        | identifier
                        | _fixity_identifier_alias
                        | wildcard
                        | _aggregate_constructor_identifier
                        | _effect_identifier_alias
                        | intrinsic_identifier
                        | atom_expression
                        | import_meta_expression
                        | import_expression
                        | include_expression
                        | named_product
                        | positional_product
                        | union_case
                        | linear_reference
                        | unit_pattern
                        | array_expression
                        | array_repeat_expression
                        | shape_value
                        | scratch_expression
                        | block
                        | parenthesized_expression
                      ) ;

template_literal = (
                     template_start
                     ((template_text | template_interpolation))*
                     "`"
                   ) ;

template_interpolation = ("{" value:(_expression) "}") ;

union_case = ("#" case:(constructor_identifier) ((_application_space value:(postfix_expression)))?) ;

linear_reference = ("!" name:(identifier)) ;

atom_expression = ("#" name:(_row_identifier_alias)) ;

import_meta_expression = ("import" "." "meta") ;

import_expression = ("import" path:(string)) ;

include_expression = ("include" path:(string)) ;

struct_type = ("struct" fields:(type_field_block)) ;

named_product = ("[" ((product_field (("," product_field))*) (",")?) "]") ;

product_field = (_named_product_dot name:((identifier | "end")) "=" value:(_expression)) ;

positional_product = ("(" (((_expression "," (_expression (("," _expression))*)) (",")?) | (_expression ",")) ")") ;

parenthesized_or_product = (
                             unit_pattern
                             | named_product
                             | positional_product
                             | parenthesized_expression
                           ) ;

array_expression = (
                     "["
                     (
                       (
                         ((_expression (("," _expression))*) (",")?)
                         | _array_spread_with_tail
                         | ((((_expression (("," _expression))*) ","))? array_spread)
                       )
                     )?
                     "]"
                   ) ;

array_spread = (_ellipsis_token value:(_expression)) ;

array_repeat_expression = (
                            "["
                            value:(_expression)
                            ";"
                            length:(_expression)
                            "]"
                          ) ;

_index_contents = (
                    ((_expression (("," _expression))*) (",")?)
                    | _array_spread_with_tail
                    | ((((_expression (("," _expression))*) ","))? array_spread)
                    | (_expression ";" _expression)
                  ) ;

array_pattern = ("[" (((_array_pattern_element (("," _array_pattern_element))*) (",")?))? "]") ;

_array_pattern_element = (
                           identifier
                           | wildcard
                           | union_pattern
                           | array_pattern
                           | positional_product_pattern
                           | array_rest_pattern
                         ) ;

array_rest_pattern = ("..." name:((identifier | wildcard))) ;

positional_product_pattern = (
                               "("
                               (
                                 _match_pattern
                                 ","
                                 (
                                   product_rest_pattern
                                   | (_match_pattern (("," _match_pattern))* (",")?)
                                 )
                               )
                               ")"
                             ) ;

product_rest_pattern = ("..." name:((identifier | wildcard))) ;

named_shape_pattern = (
                        "{"
                        (
                          (
                            (named_shape_pattern_field (("," named_shape_pattern_field))*)
                            (",")?
                          )
                        )?
                        "}"
                      ) ;

named_shape_pattern_field = (
                              "."
                              name:(identifier)
                              (("=" pattern:(_match_pattern)) | (":" type:(type_reference)))?
                            ) ;

shape_value = fields:(shape_field_block) ;

shape_field_block = ("{" (((shape_field | shorthand_field) (",")?))* "}") ;

shape_field = (
               "."
               name:((identifier | "end"))
               "="
               value:((shape_nullary_union_case | _expression))
             ) ;

shape_nullary_union_case = ("#" case:(constructor_identifier)) ;

shorthand_field = ("." name:((identifier | "end"))) ;

type_field_block = ("{" (((type_field | named_type_field) (",")?))* "}") ;

type_field = (name:(identifier) ":" type:(_identifier_type_reference)) ;

type_pattern = (
                 kind:(("struct" | "union"))
                 "{"
                 (((type_pattern_field | open:("..")) (",")?))*
                 "}"
               ) ;

type_pattern_field = ("." name:((identifier | "end")) "=" type:(type_reference)) ;

block = ("do" ((_statement (";")?))* "end") ;

parenthesized_expression = ("(" _expression ")") ;

type_reference = _type_expression ;

_type_expression = (forall_type | function_type | type_union) ;

forall_type = ("forall" (parameter:(identifier))+ "." body:(_type_expression)) ;

function_type = (
                  parameter:(type_union)
                  "->"
                  (effects:(latent_effect_row))?
                  result:(_type_expression)
                ) ;

type_union = (type_intersection | (left:(type_union) ":|" right:(type_intersection))) ;

type_intersection = (type_difference | (left:(type_intersection) ":&" right:(type_difference))) ;

type_difference = (_type_application | (left:(type_difference) ":-" right:(_type_application))) ;

latent_effect_row = ("<" row:(effect_row) ">") ;

_type_application = (type_application | _type_prefix) ;

type_application = (
                     (
                       constructor:((type_application | _type_prefix))
                       _type_application_space
                       argument:(_type_prefix)
                     )
                     | (
                         constructor:((type_application | _type_prefix))
                         argument:(immediate_type_argument)
                       )
                   ) ;

immediate_type_argument = (
                            _immediate_type_open
                            (
                              (
                                type_reference
                                ","
                                (type_reference (("," type_reference))*)
                                (",")?
                              )
                              | value:(type_reference)
                            )?
                            ")"
                          ) ;

_type_prefix = (atom_type | frozen_type | borrow_type | _type_atom) ;

atom_type = ("#" name:(_row_identifier_alias)) ;

frozen_type = ("freeze" (name:(_effect_identifier_alias) | type_parenthesized)) ;

borrow_type = ("&" (identifier | type_parenthesized)) ;

_type_atom = (
               _proof_prefixed_identifier_alias
               | _effect_identifier_alias
               | identifier
               | top_type
               | type_literal
               | unit_type
               | type_parenthesized
               | type_product
               | array_type
             ) ;

type_literal = (number | string | character | boolean) ;

unit_type = ("(" ")") ;

top_type = "_" ;

array_type = ("[" element:(_type_expression) ";" length:((_expression | wildcard)) "]") ;

type_parenthesized = ("(" value:(_type_expression) ")") ;

wildcard = "_" ;

_aggregate_constructor_identifier = _struct_identifier_alias ;

_named_product_dot = "." ;

_pattern_pipe = "|" ;

as_keyword = "as" ;

attribute_group = ("@" "[" (_expression (("," _expression))*) (",")? "]") ;

boolean = ("true" | "false") ;

const_value_pattern = ("#" "(" value:(_expression) ")") ;

_intrinsic_fixity_target = (intrinsic_identifier "." identifier (("." identifier))*) ;

_qualified_fixity_target = qualified_identifier ;

_type_intersection_reference = type_intersection ;

_collection_range_body = block ;

_numeric_range_body = block ;

_shape_arrow = _shape_arrow_expression ;

_effect_arrow = _effect_arrow_expression ;

_value_arrow = _value_arrow_expression ;

_effect_identifier_alias = effect_identifier ;

_proof_prefixed_identifier_alias = proof_prefixed_identifier ;

_row_identifier_alias = row_variable ;

_fixity_identifier_alias = _fixity_identifier ;

_array_spread_with_tail = (array_spread "," ((_expression (("," _expression))*) (",")?)) ;

_ellipsis_token = "..." ;

_index_open = "[" ;

_identifier_type_reference = identifier ;

_struct_keyword = "struct" ;

_struct_identifier_alias = _struct_keyword ;

_shape_arrow_expression = (parameters:(named_shape_pattern) "=>" body:(_expression)) ;

_effect_arrow_expression = (parameters:(_effect_identifier_alias) "=>" body:(_expression)) ;

_value_arrow_expression = (
                       parameters:(
                         (
                           parameter
                           | parameter_list
                           | bracket_parameter_list
                           | number
                           | string
                           | character
                           | boolean
                           | grouped_value_alternative_pattern
                         )
                       )
                       "=>"
                       body:(_expression)
                     ) ;
