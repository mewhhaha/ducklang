const { .struct, .slice } = import "duck:prelude" ();

effect Emit {
  byte: (I32) => Unit
}

type Builder = struct { .buffer = Bytes, .length = I32 }

let output_builder = capacity => do
  Builder.new {
    .buffer = Bytes.generate(capacity, _ => 0),
    .length = 0,
  }
end;

let append = (output, byte) => do
  let buffer = output.buffer;
  let capacity = @len buffer;
  let insertion_index = output.length;
  if insertion_index >= 0 && insertion_index < capacity then
    do
      buffer[insertion_index] = byte
      Builder.new { .buffer = buffer, .length = insertion_index + 1 }
    end
  else
    output
  end
end;

let byte_at = (bytes: Bytes, index: I32) => do
  let length = @len bytes;
  if index >= 0 && index < length then @get(bytes, index) else 0 end
end;

let collect = capacity => do
  let output = output_builder capacity;
  handler Emit {
    byte: (value, !resume) => do
      output = append(output, value)
      !resume(())
    end,
    return: _ => slice (&output.buffer, 0, output.length),
  }
end;

let emitted = try do
  _ <- Emit.byte(40)
  _ <- Emit.byte(2)
  ()
end with collect 4;

byte_at(emitted, 0) + byte_at(emitted, 1)
