effect Counter {
  add: (I32) => Unit
}

let run: () -> <Counter> Unit = () => do
  let values = [10, 20, 12];

  for value in values do
    _ <- Counter.add(value)
  end
  ()
end;

let counter = do
  let sum = 0;
  handler Counter {
    add: (value, !resume) => do
      sum = sum + value
      !resume(())
    end,
    return: _ => sum,
  }
end;

try run() with counter
