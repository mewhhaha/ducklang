module (!init: Init) where

declare effect Io {
  read: () => Text
  print: (&Text) => Unit
}

declare Init {
  io: Io
}

let read_name: () -> <Io.read> Text = () => do
  name <- Io.read()
  name
end;

let greet: () -> <Io.read :| Io.print> Text = () => do
  name <- read_name();
  _ <- Io.print(&name)
  name
end;

result <- greet();
return { .result = result };
