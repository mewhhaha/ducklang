const { .pipe: forall input output.[input, input -> output] -> output } =
  import "duck:prelude/functional" ();

// `_` marks a missing argument, so the call becomes a lambda. That keeps a
// pipeline stage a compile-time shape, which is what lets `|>` specialize it
// away instead of building a closure per stage — even when the stage closes
// over a runtime value.
let add = [a: I32, b: I32] => a + b;
let offset = 10;

let scaled = add [_, _];

1
|> add [offset, _]
|> add [30, _]
|> (value => scaled [value, 1])
