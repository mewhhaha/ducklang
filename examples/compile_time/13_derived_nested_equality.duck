const { .struct } = import "duck:prelude" ();
type Point = struct { .x = Int, .y = Int }
type Pixels = [Int; 2]
type Shape = | #Point Point | #Code Int

const derive_equal = rec (const target) => do
  const description = @describe_type target;

  if description.kind == #record then
    const [first, second] = @describe_fields target;
    const first_equal = derive_equal first.type;
    const second_equal = derive_equal second.type;
    (left, right) =>
      first_equal(@project(left, first), @project(right, first)) &&
      second_equal(@project(left, second), @project(right, second))
  else
    if description.kind == #array then
      const element_equal = derive_equal description.element;
      (left, right) => do
        let [left_first, left_second] = left;
        let [right_first, right_second] = right;
        element_equal(left_first, right_first) &&
          element_equal(left_second, right_second)
      end
    else
      if description.kind == #sum then
        const [first, second] = @describe_cases target;
        const first_equal = derive_equal first.type;
        const second_equal = derive_equal second.type;
        (left, right) => do
          if @is_case(left, first) then
            @is_case(right, first) &&
              first_equal(
                @project(left, first),
                @project(right, first),
              )
          else
            @is_case(left, second) &&
              @is_case(right, second) &&
              second_equal(
                @project(left, second),
                @project(right, second),
              )
          end
        end
      else
        (left, right) => left == right
      end;
    end;
  end;
end;

const equal_shape = comptime derive_equal Shape;
const equal_pixels = comptime derive_equal Pixels;

let left: Shape = #Point [.x = 20, .y = 22];
let right: Shape = #Point [.x = 20, .y = 22];
let pixel_left: Pixels = [20, 22];
let pixel_right: Pixels = [20, 22];

if equal_shape(left, right) then
  if equal_pixels(pixel_left, pixel_right) then
    42
  else
    0
  end;
else
  0
end;
