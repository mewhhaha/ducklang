type NumberCalc = | #Literal Int | #Add Int
type TextCalc = #Literal Text

let eval_number = expression => do
  if let #Literal value = expression then
    value
  else
    if let #Add left = expression then
      left + 22
    else
      0
    end;
  end;
end;

let expression: NumberCalc = #Add (20);

eval_number expression
