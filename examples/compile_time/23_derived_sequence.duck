const { .derive_sequence } = import "duck:prelude/collections" ();

@[derive_sequence(
  I32,
  () => #NoCommands,
  commands => do
    case commands of
      #MoreCommands node => do
        let [command, rest] = node;
        #Some [command, rest]
      end,
      _ => #None;
  end,
  (value: I32, tail) => #MoreCommands [value, tail],
)]
type Commands =
  | #NoCommands
  | #MoreCommands CommandNode

type CommandNode = [I32, Commands]

let values: Commands = Commands.prepend(
  2,
  Commands.prepend(40, Commands.empty()),
);

case values of
  #MoreCommands first => do
    let [first_value, remaining] = first;
    case remaining of
      #MoreCommands second => do
        let [second_value, _] = second;
        first_value + second_value
      end,
      _ => first_value;
  end,
  _ => 0;
