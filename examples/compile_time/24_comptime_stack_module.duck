type IntStack = | #Empty | #Node IntStackNode
type IntStackNode = [I32, IntStack]

const stack_module = (const item_type, const stack_type, const node_type) => comptime do
  const empty = () => do
    let values: stack_type = #Empty;
    values
  end;
  const push = (value: item_type, values: stack_type) => do
    let node: node_type = [value, values];
    let pushed: stack_type = #Node node;
    pushed
  end;
  const top = (values: stack_type, fallback: item_type) => do
    if let #Node node = values then
      let [head, _] = node;
      head
    else
      fallback
    end;
  end;
  const rest = (values: stack_type) => do
    if let #Node node = values then
      let [_, tail] = node;
      tail
    else
      values
    end;
  end;

  { .empty, .push, .top, .rest }
end;

const int_stack = comptime stack_module(I32, IntStack, IntStackNode);

let pushed_one = int_stack.push(40, int_stack.empty());
let pushed_two = int_stack.push(2, pushed_one);
let first = int_stack.top(pushed_two, 0);
let second = int_stack.top(int_stack.rest(pushed_two), 0);

first + second
