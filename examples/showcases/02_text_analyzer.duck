const { .append, .length, .slice } = import "duck:prelude/runtime" ();

let source = "lambda";
let head = slice(source, 0, 3);
let tail = slice(source, 3, length source);
let rebuilt = append(head, tail);
let checksum = 0;

for byte in rebuilt do
  checksum = checksum + byte
end

if rebuilt == source then
  checksum - 567
else
  0
end;
