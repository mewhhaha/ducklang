module (!init: Init) where

const { .length } = import "duck:prelude/runtime" ();
const { .struct } = import "duck:prelude" ();

declare effect Input {
  flag: () => Bool
}

declare Init { input: Input }

type PipelineResult error value = | #Ok value | #Err error
type User = struct { .name = Text, .score = Int }
type UserResult = PipelineResult Text User

flag <- Input.flag()
let outcome: UserResult = if flag then
  #Ok [.name = "Ada", .score = 42]
else
  #Err ("missing")
end;

let result: I32 = if let #Ok user = outcome then
  user.score
else
  length "missing" * 6
end;

return { .result = result };
