module () where

const {} = import "duck:prelude/types" ();
const { .list_length, .list_map, .list_reverse, .list_take } =
  import "duck:prelude/collections" ();

infixr 10 $ = apply
infixl 10 |> = pipe
infixl 55 <$> = Functor.map
infixl 55 <*> = Applicative.apply
infixl 50 >>= = Monad.bind
infixl 45 <|> = Alternative.or_else
infixr 50 <> = Semigroup.append
infixl 45 ||| = Bits.bit_or
infixl 50 ^^^ = Bits.bit_xor
infixl 55 &&& = Bits.bit_and
infixl 60 << = Bits.shift_left
infixl 60 >> = Bits.shift_right_unsigned

duck Eq Self {
  .eq = (Self, Self) -> Bool
}

duck Ord Self {
  .compare = (Self, Self) -> Ordering
}

duck Max Self {
  .max = (Self, Self) -> Self
}

const max = Max.max;

duck Monoid Self {
  .empty = () -> Self
  .append = (Self, Self) -> Self
}

duck Semigroup Self {
  .append = (Self, Self) -> Self
}

duck Bits Self {
  .bit_and = (Self, Self) -> Self
  .bit_or = (Self, Self) -> Self
  .bit_xor = (Self, Self) -> Self
  .shift_left = (Self, Self) -> Self
  .shift_right_unsigned = (Self, Self) -> Self
}

duck Semiring Self {
  .zero = () -> Self
  .one = () -> Self
  .add = (Self, Self) -> Self
  .multiply = (Self, Self) -> Self
}

duck Ring Self {
  .zero = () -> Self
  .one = () -> Self
  .add = (Self, Self) -> Self
  .multiply = (Self, Self) -> Self
  .negate = Self -> Self
  .subtract = (Self, Self) -> Self
}

duck EuclideanRing Self {
  .divide = (Self, Self) -> Self
  .remainder = (Self, Self) -> Self
}

duck Functor F A B {
  .map = (A -> B, F A) -> F B
}

duck Apply F A B {
  .apply = (F (A -> B), F A) -> F B
}

duck Applicative F A B {
  .pure = A -> F A
  .apply = (F (A -> B), F A) -> F B
}

duck Monad M A B {
  .pure = A -> M A
  .bind = (M A, A -> M B) -> M B
}

duck AffineMonad M A B {
  .pure_affine = A -> M A
  .bind_affine = (M A, A -> M B) -> M B
}

duck Bind M A B {
  .bind = (M A, A -> M B) -> M B
}

duck Foldable F A State {
  .fold = (F A, State, (State, A) -> State) -> State
}

duck Show Self {
  .show = Self -> Text
}

duck From Source Target {
  .from = Source -> Target
}

const from = From.from;

duck Into Source Target {
  .into = Source -> Target
}

duck TryFrom Source Target Error {
  .try_from = Source -> Result Error Target
}

duck Default Self {
  .default = () -> Self
}

duck Bounded Self {
  .minimum = () -> Self
  .maximum = () -> Self
}

duck Enum Self {
  .successor = Self -> Self
  .predecessor = Self -> Self
}

duck Alternative F A {
  .empty = () -> F A
  .or_else = (F A, F A) -> F A
}

duck Bifunctor F A B C D {
  .bimap = (F A B, A -> C, B -> D) -> F C D
}

duck Contravariant F A B {
  .contramap = (F A, B -> A) -> F B
}

duck Traversable T F A B {
  .traverse = (T A, A -> F B) -> F (T B)
}

duck Category C A B D {
  .identity = () -> C A A
  .compose = (C B D, C A B) -> C A D
}

duck Profunctor P A B C D {
  .dimap = (A -> B, C -> D, P B C) -> P A D
}

extend Option {
  .map = (transform, wrapped) => if let #Some value = wrapped then
    #Some (transform value)
  else
    #None
  end,
  .apply = (wrapped_transform, wrapped) => if let #Some transform = wrapped_transform then
    if let #Some value = wrapped then
      #Some (transform value)
    else
      #None
    end;
  else
    #None
  end,
  .pure = value => #Some value,
  .bind = (wrapped, transform) => if let #Some value = wrapped then
    transform value
  else
    #None
  end,
  .pure_affine = value => #Some value,
  .bind_affine = (wrapped, transform) => if let #Some value = wrapped then
    transform value
  else
    #None
  end,
  .empty = () => #None,
  .or_else = (left, right) => if let #Some value = left then
    #Some value
  else
    right
  end,
}

extend List {
  .pure = value => do
    let empty: List A = #Nil;
    let result: List A = #Cons [value, empty];
    result
  end,
  .bind = (wrapped, transform) => do
    let append: (List B, List B) -> List B = (left, right) => do
      let current_left = left;
      let reversed: List B = #Nil;
      let reverse_done = false;

      loop do
        if let #Cons node = current_left then
          let [value, tail] = node;
          reversed = #Cons [value, reversed]
          current_left = tail
        else
          reverse_done = true
        end;

        if reverse_done then
          break;
        end;
      end;

      let appended = right;
      let append_done = false;

      loop do
        if let #Cons node = reversed then
          let [value, tail] = node;
          appended = #Cons [value, appended]
          reversed = tail
        else
          append_done = true
        end;

        if append_done then
          break;
        end;
      end;

      appended
    end;

    let current = wrapped;
    let bound_values: List B = #Nil;
    let done = false;

    loop do
      if let #Cons node = current then
        let [value, tail] = node;
        let chunk = transform value;
        bound_values = append(bound_values, chunk)
        current = tail
      else
        done = true
      end;

      if done then
        break;
      end;
    end;

    bound_values
  end,
}

extend Text {
  .append = (left, right) => @append(left, right),
}

extend Bytes {
  .append = (left, right) => @append(left, right),
}

extend I32 {
  .bit_and = (left, right) => @bit_and(left, right),
  .bit_or = (left, right) => @bit_or(left, right),
  .bit_xor = (left, right) => @bit_xor(left, right),
  .shift_left = (value, amount) => @shift_left(value, amount),
  .shift_right_unsigned = (value, amount) => @shift_right_u(value, amount),
  .max = (left, right) => if left >= right then left else right end,
}

extend I64 {
  .bit_and = (left, right) => @bit_and(left, right),
  .bit_or = (left, right) => @bit_or(left, right),
  .bit_xor = (left, right) => @bit_xor(left, right),
  .shift_left = (value, amount) => @shift_left(value, amount),
  .shift_right_unsigned = (value, amount) => @shift_right_u(value, amount),
  .max = (left, right) => if left >= right then left else right end,
}

extend F32 {
  .max = (left, right) => if left >= right then left else right end,
}

extend F64 {
  .max = (left, right) => if left >= right then left else right end,
}

const identity = value => value;

const constant = value => _ => value;

const compose = (outer, inner) => value => outer(inner value);

const pipe: forall input output.(input, input -> output) -> output =
  (value, const transform) => transform value;

const flip = call => (left, right) => call(right, left);

const curry = call => left => right => call(left, right);

const uncurry = call => (left, right) => call left right;

const apply: forall input output.(input -> output, input) -> output =
  (const call, value) => call value;

const reverse_apply = (value, const call) => call value;

const on = (combine, project) => (left, right) => combine(
  project left,
  project right,
);

const swap = (left, right) => [right, left];

const first = (left, _) => left;

const second = (_, right) => right;

const fanout = (left, right) => value => [left value, right value];

const converge = (combine, left, right) => value => combine(
  left value,
  right value,
);

const iterate_i32 = (count: I32, initial: I32, const step) => do
  let state = initial;

  for 0..count do
    state = step state
  end

  state
end;

const list = (const value_type) => do
  const list_type = List value_type;
  const node_type = ListNode value_type;

  const empty: () -> List value_type = () => #Nil;
  const cons: ListNode value_type -> List value_type = node => #Cons node;

  const prepend = (value: value_type, values: List value_type) => do
    let node: ListNode value_type = @construct(node_type, [value, values]);
    cons node
  end;

  const reverse = (values: List value_type) => do
    let current = values;
    let reversed: List value_type = empty();
    let done = false;

    loop do
      if let #Cons node = current then
        let typed_node: ListNode value_type = node;
        let [head, tail] = typed_node;
        reversed = prepend(head, reversed)
        current = tail
      else
        done = true
      end;

      if done then
        break;
      end;
    end;

    reversed
  end;

  const append = (left: List value_type, right: List value_type) => do
    let current = left;
    let reversed: List value_type = empty();
    let done = false;

    loop do
      if let #Cons node = current then
        let typed_node: ListNode value_type = node;
        let [head, tail] = typed_node;
        reversed = prepend(head, reversed)
        current = tail
      else
        done = true
      end;

      if done then
        break;
      end;
    end;

    let appended = right;
    done = false

    loop do
      if let #Cons node = reversed then
        let typed_node: ListNode value_type = node;
        let [head, tail] = typed_node;
        appended = prepend(head, appended)
        reversed = tail
      else
        done = true
      end;

      if done then
        break;
      end;
    end;

    appended
  end;

  const singleton = (value: value_type) => prepend(value, empty());

  const filter =
    (values: List value_type, const predicate: value_type -> Bool) => do
      let current = values;
      let kept_reversed: List value_type = empty();
      let done = false;

      loop do
        if let #Cons node = current then
          let typed_node: ListNode value_type = node;
          let [head, tail] = typed_node;

          if predicate head then
            kept_reversed = prepend(head, kept_reversed)
          end;

          current = tail
        else
          done = true
        end;

        if done then
          break;
        end;
      end;

      reverse kept_reversed
    end;

  const take = (count: I32, values: List value_type) => do
    let current = values;
    let remaining = count;
    let taken_reversed: List value_type = empty();
    let done = remaining <= 0;

    loop do
      if done then
        break;
      end;

      if let #Cons node = current then
        let typed_node: ListNode value_type = node;
        let [head, tail] = typed_node;
        taken_reversed = prepend(head, taken_reversed)
        current = tail
        remaining = remaining - 1

        if remaining <= 0 then
          done = true
        end;
      else
        done = true
      end;
    end;

    reverse taken_reversed
  end;

  const drop = (count: I32, values: List value_type) => do
    let current = values;
    let remaining = count;
    let done = remaining <= 0;

    loop do
      if done then
        break;
      end;

      if let #Cons node = current then
        let typed_node: ListNode value_type = node;
        let [_, tail] = typed_node;
        current = tail
        remaining = remaining - 1

        if remaining <= 0 then
          done = true
        end;
      else
        done = true
      end;
    end;

    current
  end;

  const find =
    (values: List value_type, const predicate: value_type -> Bool) => do
      let current = values;
      let result: Option value_type = #None;
      let done = false;

      loop do
        if let #Cons node = current then
          let typed_node: ListNode value_type = node;
          let [head, tail] = typed_node;

          if predicate head then
            result = #Some head
            done = true
          else
            current = tail
          end;
        else
          done = true
        end;

        if done then
          break;
        end;
      end;

      result
    end;

  const length = (values: List value_type) => do
    let current = values;
    let count = 0;
    let done = false;

    loop do
      if let #Cons node = current then
        let typed_node: ListNode value_type = node;
        let [_, tail] = typed_node;
        count = count + 1
        current = tail
      else
        done = true
      end;

      if done then
        break;
      end;
    end;

    count
  end;

  const any =
    (values: List value_type, const predicate: value_type -> Bool) => do
      let current = values;
      let matched = false;
      let done = false;

      loop do
        if let #Cons node = current then
          let typed_node: ListNode value_type = node;
          let [head, tail] = typed_node;

          if predicate head then
            matched = true
            done = true
          else
            current = tail
          end;
        else
          done = true
        end;

        if done then
          break;
        end;
      end;

      matched
    end;

  const count =
    (values: List value_type, const predicate: value_type -> Bool) => do
      let current = values;
      let matched = 0;
      let done = false;

      loop do
        if let #Cons node = current then
          let typed_node: ListNode value_type = node;
          let [head, tail] = typed_node;

          if predicate head then
            matched = matched + 1
          end;

          current = tail
        else
          done = true
        end;

        if done then
          break;
        end;
      end;

      matched
    end;

  const nth_or =
    (fallback: value_type, index: I32, values: List value_type) => do
      let current = values;
      let result = fallback;
      let position = 0;
      let done = false;

      loop do
        if let #Cons node = current then
          let typed_node: ListNode value_type = node;
          let [head, tail] = typed_node;

          if position == index then
            result = head
            done = true
          else
            position = position + 1
            current = tail
          end;
        else
          done = true
        end;

        if done then
          break;
        end;
      end;

      result
    end;

  const fold_i32 = (values: List value_type, initial: I32, const combine: (
    I32,
    value_type,
  ) ->
      I32) => do
        let current = values;
        let state = initial;
        let done = false;

        loop do
          if let #Cons node = current then
            let typed_node: ListNode value_type = node;
            let [head, tail] = typed_node;
            state = combine(state, head)
            current = tail
          else
            done = true
          end;

          if done then
            break;
          end;
        end;

        state
      end;

  const sort_by = (
    values: List value_type,
    const before: (value_type, value_type) -> Bool,
  ) => do
    let current = values;
    let sorted = empty();
    let done = false;

    loop do
      if let #Cons node = current then
        let typed_node: ListNode value_type = node;
        let [value, tail] = typed_node;
        let remaining = sorted;
        let prefix_reversed = empty();
        let inserted = false;

        loop do
          if let #Cons sorted_node = remaining then
            let typed_sorted_node: ListNode value_type = sorted_node;
            let [sorted_value, sorted_tail] = typed_sorted_node;

            if before(value, sorted_value) then
              remaining = prepend(value, remaining)
              inserted = true
              break;
            else
              prefix_reversed = prepend(sorted_value, prefix_reversed)
              remaining = sorted_tail
            end;
          else
            remaining = singleton value
            inserted = true
            break;
          end;
        end;

        if inserted then
          let prefix = prefix_reversed;

          loop do
            if let #Cons prefix_node = prefix then
              let typed_prefix_node: ListNode value_type = prefix_node;
              let [prefix_value, prefix_tail] = typed_prefix_node;
              remaining = prepend(prefix_value, remaining)
              prefix = prefix_tail
            else
              break;
            end;
          end;
        end;

        sorted = remaining
        current = tail
      else
        done = true
      end;

      if done then
        break;
      end;
    end;

    sorted
  end;

  {
    .empty = empty,
    .prepend = prepend,
    .singleton = singleton,
    .reverse = reverse,
    .append = append,
    .filter = filter,
    .take = take,
    .drop = drop,
    .find = find,
    .length = length,
    .any = any,
    .count = count,
    .nth_or = nth_or,
    .fold_i32 = fold_i32,
    .sort_by = sort_by,
  }
end;

const list_fold_left: forall value state.(
  List value,
  state,
  (state, value) -> state,
) -> state =
  (values, initial, const combine) => do
    let current = values;
    let state = initial;
    let done = false;

    loop do
      if let #Cons node = current then
        let [head, tail] = node;
        state = combine(state, head)
        current = tail
      else
        done = true
      end;

      if done then
        break;
      end;
    end;

    state
  end;

const list_is_empty = values => if let #Cons _ = values then
  false
else
  true
end;

const list_any = (values, const predicate) => do
  list_fold_left(values, false, (matched, value) => do
    if matched then
      true
    else
      predicate value
    end;
  end)
end;

const list_all = (values, const predicate) => do
  list_fold_left(values, true, (matched, value) => do
    if matched then
      predicate value
    else
      false
    end;
  end)
end;

const list_count = (values, const predicate) => do
  list_fold_left(values, 0, (count, value) => do
    if predicate value then
      count + 1
    else
      count
    end;
  end)
end;

const list_last_or = (fallback, values) => do
  list_fold_left(values, fallback, (_, value) => value)
end;

const list_nth_or = (fallback, index: I32, values) => do
  let current = values;
  let result = fallback;
  let position = 0;
  let done = false;

  loop do
    if let #Cons node = current then
      let [head, tail] = node;

      if position == index then
        result = head
        done = true
      else
        position = position + 1
        current = tail
      end;

      ()
    else
      done = true
    end;

    if done then
      break;
    end;
  end;

  result
end;

const list_head_or = (fallback, values) => list_nth_or(fallback, 0, values);

const list_sum_i32 = values => do
  list_fold_left(values, 0, (total, value) => total + value)
end;

const list_product_i32 = values => do
  list_fold_left(values, 1, (product, value) => product * value)
end;

const option = (fallback, transform) => value => if let #Some item = value then
  transform item
else
  fallback
end;

const option_unwrap_or = (fallback, value) => if let #Some item = value then
  item
else
  fallback
end;

const option_is_some = value => if let #Some _ = value then true else false end;

const option_is_none = value => if let #Some _ = value then false else true end;

const option_fold = option;

const result_unwrap_or = (fallback, value) => if let #Ok item = value then
  item
else
  fallback
end;

const result_is_ok = value => if let #Ok _ = value then true else false end;

const result_is_err = value => if let #Err _ = value then true else false end;

const result_fold = (on_error, on_ok) => value => if let #Ok item = value then
  on_ok item
else let #Err error = value then
  on_error error
else
  @panic "Invalid Result value"
end;

const either_is_left = value => if let #Left _ = value then true else false end;

const either_is_right =
  value => if let #Right _ = value then true else false end;

