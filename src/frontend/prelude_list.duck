module () where

const {} = import "duck:prelude/types" ();

const list_empty = (const value_type) => () => do
  let values: List value_type = #Nil;
  values
end;

const list_prepend = (const value_type) => (value: value_type, values: List value_type) => do
  let node: ListNode value_type = [value, values];
  #Cons node
end;

const list_singleton = (const value_type) => do
  const empty = list_empty value_type;
  const prepend = list_prepend value_type;
  const singleton = (value: value_type) => prepend(value, empty());
  singleton
end;

const list_reverse = (const value_type) => do
  const empty = list_empty value_type;
  const prepend = list_prepend value_type;
  const reverse = (values: List value_type) => do
    let current = values;
    let reversed: List value_type = empty();

    loop do
      if let #Cons node = current then
        let typed_node: ListNode value_type = node;
        let [head, tail] = typed_node;
        reversed = prepend(head, reversed)
        current = tail
      else
        break;
      end;
    end;

    reversed
  end;
  reverse
end;

const list_append = (const value_type) => do
  const prepend = list_prepend value_type;
  const reverse = list_reverse value_type;
  const append = (left: List value_type, right: List value_type) => do
    let reversed = reverse left;
    let result = right;

    loop do
      if let #Cons node = reversed then
        let typed_node: ListNode value_type = node;
        let [head, tail] = typed_node;
        result = prepend(head, result)
        reversed = tail
      else
        break;
      end;
    end;

    result
  end;
  append
end;

const list_length = (const value_type) => (values: List value_type) => do
  let current = values;
  let count = 0;

  loop do
    if let #Cons node = current then
      let typed_node: ListNode value_type = node;
      let [_, tail] = typed_node;
      count = count + 1
      current = tail
    else
      break;
    end;
  end;

  count
end;

const list_take = (const value_type) => do
  const empty = list_empty value_type;
  const prepend = list_prepend value_type;
  const reverse = list_reverse value_type;
  const take = (count: I32, values: List value_type) => do
    let current = values;
    let remaining = count;
    let reversed: List value_type = empty();

    loop do
      if remaining <= 0 then
        break;
      end;
      if let #Cons node = current then
        let typed_node: ListNode value_type = node;
        let [head, tail] = typed_node;
        reversed = prepend(head, reversed)
        current = tail
        remaining = remaining - 1
      else
        break;
      end;
    end;

    reverse reversed
  end;
  take
end;

const list_drop = (const value_type) => (count: I32, values: List value_type) => do
  let current = values;
  let remaining = count;

  loop do
    if remaining <= 0 then
      break;
    end;
    if let #Cons node = current then
      let typed_node: ListNode value_type = node;
      let [_, tail] = typed_node;
      current = tail
      remaining = remaining - 1
    else
      break;
    end;
  end;

  current
end;

const list_nth_or = (const value_type) => (
  fallback: value_type,
  index: I32,
  values: List value_type,
) => do
  let current = values;
  let result = fallback;
  let position = 0;

  loop do
    if let #Cons node = current then
      let typed_node: ListNode value_type = node;
      let [head, tail] = typed_node;
      if position == index then
        result = head
        break;
      end;
      position = position + 1
      current = tail
    else
      break;
    end;
  end;

  result
end;

const list = (const value_type) => do
  {
    .empty = list_empty value_type,
    .prepend = list_prepend value_type,
    .singleton = list_singleton value_type,
    .reverse = list_reverse value_type,
    .append = list_append value_type,
    .length = list_length value_type,
    .take = list_take value_type,
    .drop = list_drop value_type,
    .nth_or = list_nth_or value_type,
  }
end;

return {
  .list,
  .list_empty,
  .list_prepend,
  .list_singleton,
  .list_reverse,
  .list_append,
  .list_length,
  .list_take,
  .list_drop,
  .list_nth_or,
};
