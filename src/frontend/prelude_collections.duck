module () where

const list_map = (const output_type, values, const transform) => do
  let current = values;
  let reversed: List output_type = #Nil;
  let done = false;

  loop do
    if let #Cons node = current then
      let [value, tail] = node;
      let mapped_node: ListNode output_type = [transform value, reversed];
      reversed = #Cons mapped_node
      current = tail
    else
      done = true
    end;

    if done then
      break;
    end;
  end;

  let mapped: List output_type = #Nil;
  done = false

  loop do
    if let #Cons node = reversed then
      let typed_node: ListNode output_type = node;
      let [value, tail] = typed_node;
      let mapped_node: ListNode output_type = [value, mapped];
      mapped = #Cons mapped_node
      reversed = tail
    else
      done = true
    end;

    if done then
      break;
    end;
  end;

  mapped
end;

const list_reverse = (const value_type, values: List value_type) => do
  let current = values;
  let reversed: List value_type = #Nil;
  let done = false;

  loop do
    if let #Cons node = current then
      let [value, tail] = node;
      let reversed_node: ListNode value_type = [value, reversed];
      reversed = #Cons reversed_node
      current = tail
    else
      done = true
    end;

    if done then
      break;
    end;
  end;

  reversed
end;

const list_take = (const value_type, count: I32, values: List value_type) => do
  let current = values;
  let remaining = count;
  let reversed: List value_type = #Nil;
  let done = remaining <= 0;

  loop do
    if done then
      break;
    end;
    if let #Cons node = current then
      let [value, tail] = node;
      let reversed_node: ListNode value_type = [value, reversed];
      reversed = #Cons reversed_node
      current = tail
      remaining = remaining - 1
      if remaining <= 0 then
        done = true
      end;
    else
      done = true
    end;
  end;

  list_reverse(value_type, reversed)
end;

const list_length = values => do
  let current = values;
  let length = 0;
  let done = false;

  loop do
    if let #Cons node = current then
      let [_, tail] = node;
      length = length + 1
      current = tail
    else
      done = true
    end;

    if done then
      break;
    end;
  end;

  length
end;

const sequence_methods = (
  const item_type,
  const empty,
  const uncons,
  const prepend,
) => (const target) => comptime do
  const _ = target;
  const make_empty = () => do
    let sequence: target = empty();
    sequence
  end;
  const add_first = (value: item_type, tail: target) => do
    let sequence: target = prepend(value, tail);
    sequence
  end;

  const reverse = (values: target) => do
    let current: target = values;
    let reversed: target = make_empty();
    let done = false;

    loop do
      let step = uncons current;

      if let #Some node = step then
        let [value, rest] = node;
        reversed = add_first(value, reversed)
        current = rest
      else
        done = true
      end;

      if done then
        break;
      end;
    end;

    reversed
  end;

  {
    .empty = make_empty,
    .prepend = add_first,
    .reverse,
  }
end;

const derive_sequence = (
  const item_type,
  const empty,
  const uncons,
  const prepend,
) => (const target) => #Replace (comptime do
  target :+ sequence_methods(
    item_type,
    empty,
    uncons,
    prepend,
  )(target)
end);

return {
  .list_map,
  .list_reverse,
  .list_take,
  .list_length,
  .derive_sequence,
};
