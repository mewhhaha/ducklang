module () where

const test = (const target) => if import .meta.mode == #test then
  #Export
else
  #Drop
end;

const derive = (const ...generators) => (const target) => #Replace (comptime do
  let derived = target;

  for generator in generators do
    derived = @type .extend(derived, generator derived)
  end

  derived
end);

return { .test, .derive };
