module () where

const { .text_append, .text_get, .text_length, .text_repeat, .text_slice } =
  import "duck:prelude/runtime" ();
const {} = import "duck:prelude/json/values" ();

type JsonEncodeArray = JsonArray
type JsonEncodeObject = JsonObject

let encode_json_string: Text -> Text = text => do
  let encoded: Text = "\"";
  let index = 0;
  let segment_start = 0;

  loop do
    if index >= text_length text then
      break;
    end;
    let byte = text_get (text, index);

    if byte == 34 || byte == 92 || byte < 32 then
      encoded = text_append (encoded, text_slice (text, segment_start, index))

      if byte == 34 then
        encoded = text_append (encoded, "\\\"")
      else byte == 92 then
        encoded = text_append (encoded, "\\\\")
      else byte == 8 then
        encoded = text_append (encoded, "\\b")
      else byte == 9 then
        encoded = text_append (encoded, "\\t")
      else byte == 10 then
        encoded = text_append (encoded, "\\n")
      else byte == 12 then
        encoded = text_append (encoded, "\\f")
      else byte == 13 then
        encoded = text_append (encoded, "\\r")
      else
        let high = byte / 16;
        let low = byte % 16;
        encoded = text_append (encoded, "\\u00")
        encoded = text_append (encoded, text_slice ("0123456789abcdef", high, high + 1))
        encoded = text_append (encoded, text_slice ("0123456789abcdef", low, low + 1))
      end;

      index = index + 1
      segment_start = index
    else
      index = index + 1
    end;
  end;

  encoded = text_append (encoded, text_slice (text, segment_start, index))
  text_append (encoded, "\"")
end;

const encode_json_string_ascii: Text -> Text = text => do
  let encoded: Text = "\"";
  let index = 0;
  let segment_start = 0;

  loop do
    if index >= text_length text then
      break;
    end;

    let byte = text_get (text, index);

    if byte == 34 || byte == 92 || byte < 32 || byte >= 128 then
      encoded = text_append (encoded, text_slice (text, segment_start, index))
      let width = 1;

      if byte == 34 then
        encoded = text_append (encoded, "\\\"")
      else byte == 92 then
        encoded = text_append (encoded, "\\\\")
      else byte == 8 then
        encoded = text_append (encoded, "\\b")
      else byte == 9 then
        encoded = text_append (encoded, "\\t")
      else byte == 10 then
        encoded = text_append (encoded, "\\n")
      else byte == 12 then
        encoded = text_append (encoded, "\\f")
      else byte == 13 then
        encoded = text_append (encoded, "\\r")
      else byte < 32 then
        let high = byte / 16;
        let low = byte % 16;
        encoded = text_append (encoded, "\\u00")
        encoded = text_append (encoded, text_slice ("0123456789abcdef", high, high + 1))
        encoded = text_append (encoded, text_slice ("0123456789abcdef", low, low + 1))
      else
        let code_point = 65533;

        if byte >= 194 && byte <= 223 && index + 1 < text_length text then
          let second = text_get (text, index + 1);
          if second >= 128 && second <= 191 then
            code_point = (byte - 192) * 64 + second - 128
            width = 2
          end;
        else byte >= 224 && byte <= 239 && index + 2 < text_length text then
          let second = text_get (text, index + 1);
          let third = text_get (text, index + 2);
          if second >= 128 && second <= 191 && third >= 128 && third <= 191 then
            code_point = (byte - 224) * 4096 + (second - 128) * 64 + third - 128
            width = 3
          end;
        else byte >= 240 && byte <= 244 && index + 3 < text_length text then
          let second = text_get (text, index + 1);
          let third = text_get (text, index + 2);
          let fourth = text_get (text, index + 3);
          if second >= 128 && second <= 191 && third >= 128 && third <= 191 && fourth >= 128
            && fourth <= 191 then
              code_point = (byte - 240) * 262144 + (second - 128) * 4096 + (third - 128) * 64
                + fourth - 128
              width = 4
            end;
        end;

        let first_unit = code_point;
        let second_unit = -1;
        if code_point > 65535 then
          let supplementary = code_point - 65536;
          first_unit = 55296 + supplementary / 1024
          second_unit = 56320 + supplementary % 1024
        end;

        encoded = text_append (encoded, "\\u")
        let divisor = 4096;
        for _ in 0..4 do
          let digit = first_unit / divisor % 16;
          encoded = text_append (encoded, text_slice ("0123456789abcdef", digit, digit + 1))
          divisor = divisor / 16
        end

        if second_unit >= 0 then
          encoded = text_append (encoded, "\\u")
          divisor = 4096
          for _ in 0..4 do
            let digit = second_unit / divisor % 16;
            encoded = text_append (encoded, text_slice ("0123456789abcdef", digit, digit + 1))
            divisor = divisor / 16
          end
        end;
      end;

      index = index + width
      segment_start = index
    else
      index = index + 1
    end;
  end;

  encoded = text_append (encoded, text_slice (text, segment_start, index))
  text_append (encoded, "\"")
end;

let rec encode_json: Json -> Text = value => do
  if let #Null = value then
    "null"
  else let #Bool boolean = value then
    if boolean then "true" else "false" end;
  else let #Number number = value then
    number
  else let #String text = value then
    encode_json_string text
  else let #Array values = value then
    let encoded: Text = "[";
    let current: JsonEncodeArray = values;
    let first = true;
    let done = false;

    loop do
      if let #Cons node = current then
        let [element, tail] = node;
        if first then
          first = false
        else
          encoded = text_append (encoded, ",")
        end;
        encoded = text_append (encoded, encode_json element)
        current = tail
      else
        done = true
      end;
      if done then
        break;
      end;
    end;

    text_append (encoded, "]")
  else let #Object members = value then
    let encoded: Text = "{";
    let current: JsonEncodeObject = members;
    let first = true;
    let done = false;

    loop do
      if let #Cons node = current then
        let [member, tail] = node;
        let [key, member_value] = member;
        if first then
          first = false
        else
          encoded = text_append (encoded, ",")
        end;
        encoded = text_append (encoded, encode_json_string key)
        encoded = text_append (encoded, ":")
        encoded = text_append (encoded, encode_json member_value)
        current = tail
      else
        done = true
      end;
      if done then
        break;
      end;
    end;

    text_append (encoded, "}")
  else
    "null"
  end;
end;

let rec encode_json_pretty_at: (Json, I32) -> Text = (value, depth) => do
  if let #Array values = value then
    if let #Nil = values then
      "[]"
    else
      let encoded = "[\n";
      let current: JsonEncodeArray = values;
      let first = true;
      let done = false;
      loop do
        if let #Cons node = current then
          let [element, tail] = node;
          if first then
            first = false
          else
            encoded = text_append (encoded, ",\n")
          end;
          encoded = text_append (encoded, text_repeat("  ", depth + 1))
          encoded = text_append (encoded, encode_json_pretty_at(element, depth + 1))
          current = tail
        else
          done = true
        end;
        if done then
          break;
        end;
      end;
      text_append (encoded, text_append ("\n", text_append (text_repeat("  ", depth), "]")))
    end;
  else let #Object members = value then
    if let #Nil = members then
      "{}"
    else
      let encoded = "{\n";
      let current: JsonEncodeObject = members;
      let first = true;
      let done = false;
      loop do
        if let #Cons node = current then
          let [member, tail] = node;
          let [key, member_value] = member;
          if first then
            first = false
          else
            encoded = text_append (encoded, ",\n")
          end;
          encoded = text_append (encoded, text_repeat("  ", depth + 1))
          encoded = text_append (encoded, encode_json_string key)
          encoded = text_append (encoded, ": ")
          encoded = text_append (encoded, encode_json_pretty_at(member_value, depth + 1))
          current = tail
        else
          done = true
        end;
        if done then
          break;
        end;
      end;
      text_append (encoded, text_append ("\n", text_append (text_repeat("  ", depth), "}")))
    end;
  else
    encode_json value
  end;
end;

let encode_json_pretty: Json -> Text = value => encode_json_pretty_at(value, 0);

let rec encode_json_ascii: Json -> Text = value => do
  if let #Null = value then
    "null"
  else let #Bool boolean = value then
    if boolean then "true" else "false" end;
  else let #Number number = value then
    number
  else let #String text = value then
    encode_json_string_ascii text
  else let #Array values = value then
    let encoded: Text = "[";
    let current: JsonEncodeArray = values;
    let first = true;
    let done = false;

    loop do
      if let #Cons node = current then
        let [element, tail] = node;

        if first then
          first = false
        else
          encoded = text_append (encoded, ",")
        end;

        encoded = text_append (encoded, encode_json_ascii element)
        current = tail
      else
        done = true
      end;

      if done then
        break;
      end;
    end;

    text_append (encoded, "]")
  else let #Object members = value then
    let encoded: Text = "{";
    let current: JsonEncodeObject = members;
    let first = true;
    let done = false;

    loop do
      if let #Cons node = current then
        let [member, tail] = node;
        let [key, member_value] = member;

        if first then
          first = false
        else
          encoded = text_append (encoded, ",")
        end;

        encoded = text_append (encoded, encode_json_string_ascii key)
        encoded = text_append (encoded, ":")
        encoded = text_append (encoded, encode_json_ascii member_value)
        current = tail
      else
        done = true
      end;

      if done then
        break;
      end;
    end;

    text_append (encoded, "}")
  else
    "null"
  end;
end;

return {
  .encode_json,
  .encode_json_pretty,
  .encode_json_ascii,
  .encode_json_string,
  .encode_json_string_ascii,
};
