{
  "tasks": {
    "duck": "deno run --allow-read --allow-write duck.ts",
    "compiler": "deno run --allow-read --allow-write src/backend/compile.ts",
    "compiler:test": "deno test --allow-read --allow-write src/backend/compiler.test.ts",
    "grammar:generate": "deno run --allow-read --allow-write --allow-run=tree-sitter scripts/generate-grammar.ts",
    "grammar:check": "deno run --allow-read --allow-write --allow-run=tree-sitter scripts/generate-grammar.ts --check",
    "lsp:perf": "deno run --allow-read scripts/lsp-performance.ts"
  },
  "imports": {
    "@mewhhaha/baba": "jsr:@mewhhaha/baba@6.1.0",
    "@mewhhaha/typeclasses": "jsr:@mewhhaha/typeclasses@^0.5.2"
  },
  "minimumDependencyAge": {
    "age": "P7D",
    "exclude": [
      "jsr:@mewhhaha/*"
    ]
  },
  "lint": {
    "plugins": ["./scripts/lint_rules.ts"]
  },
  "fmt": {
    "exclude": [
      "AGENTS.md",
      "CLAUDE.md",
      "tree-sitter-duck/grammar.js",
      "tree-sitter-duck/src/grammar.json",
      "tree-sitter-duck/src/node-types.json"
    ]
  }
}
