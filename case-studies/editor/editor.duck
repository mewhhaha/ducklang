module (!init: Init) where

const { .cast, .struct } = import "duck:prelude/types" ();
const { .not, .slice } = import "duck:prelude" ();
const { .max } = import "duck:prelude/functional" ();

type Status = | #Ready | #SaveFailed Text
type TerminalSize = struct { .columns = I32, .rows = I32 }
type OutputBuilder = struct { .buffer = Bytes, .length = I32 }
type RenderView = struct {
  .editor = Editor,
  .status = Status,
  .size = TerminalSize,
}
type SaveSequence =
  | #NoSaves
  | #SavedDocument SavedDocument
type SavedDocument = [PieceTable, SaveSequence]

const {
  .piece_byte_traversal,
  .materialize,
} = import "./piece_tree.duck" ();
const {
  .editor_from_bytes,
  .editor_highlight,
  .apply_keys,
  .ground_key_decoder,
} = import "./editor_core.duck" ();

const escape_character = cast (27, Char);
const control_sequence_introducer = '[';
const cursor_home_command = 'H';
const erase_display_command = 'J';
const inverse_video_parameter = '7';
const reset_style_parameter = '0';
const select_graphic_rendition_command = 'm';
const utf8_continuation_lower_bound = 0x80;
const utf8_continuation_upper_bound = 0xc0;
const minimum_document_rows = 1;
const terminal_status_row_count = 1;
const minimum_render_columns = 8;
const maximum_utf8_bytes_per_character = 4;
const terminal_line_break_byte_count = 2;
// The frame emits two 3-byte cursor/display sequences and at most four 4-byte style sequences.
const terminal_frame_control_capacity = 22;

let is_utf8_continuation = byte => do
  byte >= utf8_continuation_lower_bound && byte < utf8_continuation_upper_bound
end;

let output_builder = capacity => do
  OutputBuilder.new {
    .buffer = Bytes.generate (capacity, _ => 0),
    .length = 0,
  }
end;

let append_output_byte = (output, byte) => do
  let buffer = output.buffer;
  buffer[output.length] = byte
  OutputBuilder.new { .buffer = buffer, .length = output.length + 1 }
end;

let append_output_character = (output, character: Char) => do
  append_output_byte (output, cast (character, I32))
end;

let append_control_sequence = (output, command) => do
  let output = append_output_character (output, escape_character);
  output = append_output_character (output, control_sequence_introducer)
  append_output_character (output, command)
end;

let append_sgr = (output, parameter) => do
  let output = append_control_sequence (output, parameter);
  append_output_character (output, select_graphic_rendition_command)
end;

const display_byte = (byte: I32) => do
  let character = cast (byte, Char);
  if character == '\t' then cast (' ', I32) else byte end;
end;

let render: RenderView -> Bytes = view => do
  let editor = view.editor;
  let document = editor.document;
  let highlight = editor_highlight editor;
  let selected_start = highlight.start;
  let selected_end = highlight.end;
  let mode = editor.mode;
  let status = view.status;
  let columns = view.size.columns;
  let rows = view.size.rows;
  let document_rows = rows - terminal_status_row_count;
  let visible_rows = max (document_rows, minimum_document_rows);
  let visible_columns = max (columns, minimum_render_columns);
  let line_break_capacity = visible_rows * terminal_line_break_byte_count;
  let document_capacity =
    visible_rows * visible_columns * maximum_utf8_bytes_per_character;
  let output_capacity =
    document_capacity + line_break_capacity + visible_columns
    + terminal_frame_control_capacity;

  let output = output_builder output_capacity;
  output = append_control_sequence (output, cursor_home_command)
  output = append_control_sequence (output, erase_display_command)
  let highlighted = false;
  let row = 0;
  let column = 0;
  let position = 0;
  let bytes = piece_byte_traversal document;

  for byte in bytes do
    if row >= visible_rows then
      break;
    end;

    let byte = display_byte byte;

    if position == selected_start then
      output = append_sgr (output, inverse_video_parameter)
      highlighted = true
    end;

    if position == selected_end && highlighted then
      output = append_sgr (output, reset_style_parameter)
      highlighted = false
    end;

    if byte == cast ('\n', I32) then
      output = append_output_character (output, '\r')
      output = append_output_character (output, '\n')
      row = row + 1
      column = 0
    else column < visible_columns then
      output = append_output_byte (output, byte)

      if not (is_utf8_continuation byte) then
        column = column + 1
      end;
    end;

    position = position + 1
  end

  if highlighted then
    output = append_sgr (output, reset_style_parameter)
  end;

  for _ in row..visible_rows do
    output = append_output_character (output, '\r')
    output = append_output_character (output, '\n')
  end

  output = append_sgr (output, inverse_video_parameter)
  let label = case status of
    #SaveFailed message => " SAVE FAILED: " ++ message ++ "  w retry  q quit ",
    #Ready => do
      case mode of
        #Insert _ => " INSERT  esc normal ",
        #Extend _ => " EXTEND  h/l move  d delete  i/a insert  w save  q quit ",
        #Normal _ => " NORMAL  h/l move  v extend  d delete  i/a insert  w save  q quit ";
    end;

  for label_index in 0..label.length () do
    if label_index < visible_columns then
      output = append_output_byte (output, label[label_index])
    end;
  end

  output = append_sgr (output, reset_style_parameter)
  slice (&output.buffer, 0, output.length)
end;

let save_documents: (SaveSequence, Status) -> <Terminal> Status = (
  documents,
  initial_status,
) => do
  let latest_status = initial_status;
  let pending = documents;

  loop do
    if let #SavedDocument saved = pending then
      let contents = materialize (&saved[0]);
      save_result <- Terminal.save (&contents)
      latest_status = case save_result of
        #Ok => #Ready,
        #Err message => #SaveFailed message;
      pending = saved[1]
    else
      break;
    end;
  end;

  latest_status
end;

document <- Terminal.load ()
let editor = editor_from_bytes document;
let key_decoder = ground_key_decoder;
let editor_status = #Ready;

loop do
  columns <- Terminal.columns ()
  rows <- Terminal.rows ()
  let view = RenderView.new {
    .editor = editor,
    .status = editor_status,
    .size = TerminalSize.new { .columns = columns, .rows = rows },
  };
  let frame = render view;
  _ <- Terminal.write (&frame)
  read_result <- Terminal.read ()

  case read_result of
    #End => do
      break;
    end,
    #Keys keys => do
      let input_result = apply_keys (editor, key_decoder, keys);

      case input_result of
        #ContinueInput continued => do
          editor = continued.editor
          key_decoder = continued.decoder
          saved_status <- save_documents (continued.saves, editor_status)
          editor_status = saved_status
        end,
        #QuitInput quit => do
          editor = quit.editor
          _ <- save_documents (quit.saves, editor_status)
          break;
        end;
    end;
end;

return { .code = 0 };
