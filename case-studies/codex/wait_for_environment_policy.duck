module () where

const { .encode_json_string } = import "duck:prelude/json/string" ();
const { .text_append } = import "duck:prelude/text" ();
const {} = import "./wait_for_environment_types.duck" ();

type WaitEnvironments = WaitForEnvironments
type WaitEnvironmentHostResponse = WaitForEnvironmentHostResponse
type WaitEnvironmentPlan = WaitForEnvironmentPlan
type WaitEnvironmentResult = WaitForEnvironmentExecutionResult
const plan_wait_for_environment: (WaitEnvironments, Text) -> WaitEnvironmentPlan = (
  environments: WaitEnvironments,
  environment_id: Text,
) => do
  let current = environments;
  let ready = false;
  let starting = false;
  let done = false;

  loop do
    if let #Cons node = current then
      let [environment, tail] = node;
      if environment.environment_id == environment_id then
        if let #Ready = environment.status then
          ready = true
          done = true
        else let #Starting = environment.status then
          starting = true
          current = tail
        else
          current = tail
        end;
      else
        current = tail
      end;
    else
      done = true
    end;

    if done then
      break;
    end;
  end;

  if ready then
    #AlreadyReady environment_id
  else starting then
    #Wait environment_id
  else
    let suffix: Text = text_append(environment_id, "` is neither ready nor starting");
    #RejectRequest (text_append("environment `", suffix))
  end;
end;

const ready_environment_output: Text -> Text = environment_id => do
  let encoded_environment_id: Text = encode_json_string environment_id;
  let encoded: Text = text_append("{\"environment_id\":", encoded_environment_id);
  text_append(encoded, ",\"status\":\"ready\"}")
end;

const finish_wait_for_environment: (Text, WaitEnvironmentHostResponse) -> WaitEnvironmentResult = (
  environment_id: Text,
  response: WaitEnvironmentHostResponse,
) => do
  if response then
    #Completed (ready_environment_output environment_id)
  else
    let suffix: Text = text_append(
      environment_id,
      "` failed to start and is unavailable. Continue without it.",
    );
    #Rejected (text_append("Environment `", suffix))
  end;
end;

return {
  .finish_wait_for_environment,
  .plan_wait_for_environment,
  .ready_environment_output,
};
