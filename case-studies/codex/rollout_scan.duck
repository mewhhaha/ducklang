module () where

const { .list, .option } = import "duck:prelude/functional" ();
const rollout_types_module = import "./rollout_types.duck";

type ScanResponse = RolloutResponse
type ScanCompletedItem = RolloutCompletedItem
type ScanEvent = RolloutEvent
type ScanItem = RolloutItem
type ScanItems = RolloutItems
type ScanTextOption = RolloutTextOption

const rollout_items = comptime list ScanItem;

const compatible_turn_ids = (active: ScanTextOption, candidate: ScanTextOption) => do
  if let #Some active_id = active then
    if let #Some candidate_id = candidate then active_id == candidate_id else true end;
  else
    true
  end;
end;

const select_model_context_items = (values: ScanItems, session_meta: ScanItem) => do
  let current = values;
  let selected_newest_first: ScanItems = rollout_items.empty();
  let saw_compaction = false;
  let saw_completed_context = false;
  let must_scan_to_start = false;
  let active_turn_id: ScanTextOption = #None;
  let active_has_user = false;
  let active_has_context = false;
  let done = false;

  loop do
    if let #Cons node = current then
      let [item, tail] = node;
      selected_newest_first = rollout_items.prepend(item, selected_newest_first)

      if !(must_scan_to_start) then
        case item of
          #Compacted compaction => do
            let [has_replacement_history, has_window_number] = compaction;
            if has_replacement_history && has_window_number then
              saw_compaction = true
            else
              must_scan_to_start = true
            end;
          end,
          #Event event => do
            case event of
              #ThreadRolledBack => do
                must_scan_to_start = true
              end,
              #ItemCompleted completed => do
                let [turn_id, completed_item] = completed;
                let candidate = #Some (turn_id);
                if let #None = active_turn_id then
                  active_turn_id = candidate
                end;
                if compatible_turn_ids(active_turn_id, candidate) then
                  case completed_item of
                    #UserMessage => do
                      active_has_user = true
                    end,
                    _ => ();
                end;
              end,
              #TurnComplete turn_id => do
                if let #None = active_turn_id then
                  active_turn_id = #Some (turn_id)
                end;
              end,
              #TurnAborted turn_id => do
                if let #None = active_turn_id then
                  active_turn_id = turn_id
                end;
              end,
              #TurnStarted turn_id => do
                let candidate = #Some (turn_id);
                if compatible_turn_ids(active_turn_id, candidate) then
                  if active_has_user && active_has_context then
                    saw_completed_context = true
                  end;
                  active_turn_id = #None
                  active_has_user = false
                  active_has_context = false
                end;
              end,
              _ => ();
          end,
          #TurnContext turn_id => do
            if let #None = active_turn_id then
              active_turn_id = turn_id
            end;
            if compatible_turn_ids(active_turn_id, turn_id) then
              active_has_context = true
            end;
          end,
          #Response response => do
            case response of
              #AgentMessage => do
                active_has_user = true
              end,
              #Message message => do
                let [role, inter_agent] = message;
                if role == "assistant" && inter_agent then
                  active_has_user = true
                end;
              end,
              _ => ();
          end,
          #InterAgent => do
            active_has_user = true
          end,
          _ => ();
      end;

      current = tail
      if !(must_scan_to_start) && saw_compaction && saw_completed_context then
        done = true
      end;
    else
      done = true
    end;

    if done then
      break;
    end;
  end;

  let chronological = rollout_items.reverse selected_newest_first;
  if !(must_scan_to_start) && saw_compaction && saw_completed_context then
    rollout_items.prepend(session_meta, chronological)
  else
    chronological
  end;
end;

return {
  .select_model_context_items,
};
