module () where

const { .parse_wait_agent_args } = import "./agent_tool_wait_json.duck" ();

let decoded = parse_wait_agent_args "{\"timeout_ms\":45000}";
let score = 0;
if let #AgentWaitDecoded timeout = decoded then
  if let #Some timeout_ms = timeout then
    if timeout_ms == 45000i64 then
      score = 1
    end;
  end;
end;

return { .score = score };
