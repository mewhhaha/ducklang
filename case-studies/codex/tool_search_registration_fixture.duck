module () where

const { .text_contains } = import "duck:prelude/runtime" ();
const {} = import "./tool_search_types.duck" ();
const {
  .merge_search_sources,
  .render_search_sources,
  .tool_search_parameters,
  .tool_search_tool_definitions,
  .tool_search_tool_specs,
} = import "./tool_search_registration.duck" ();

type FixtureSource = ToolSearchSourceInfo
type FixtureSourceNode = ToolSearchSourceInfoNode
type FixtureSources = ToolSearchSourceInfos
type FixtureDefinitions = ToolDefinitions
type FixtureSpecs = ToolSpecs

let raw: FixtureSources = #Nil;
raw = #Cons ([[.name = "docs", .description = #None], raw] as FixtureSourceNode)
raw = #Cons (
  [[.name = "Google Drive", .description = #Some "Drive, Docs, Sheets, and Slides."],
    raw] as FixtureSourceNode
)
raw = #Cons ([[.name = "Google Drive", .description = #None], raw] as FixtureSourceNode)

let score = 0;
let merged: FixtureSources = merge_search_sources raw;
let merged_count = 0;
let current = merged;
let count_done = false;
loop do
  if let #Cons node = current then
    let [_, tail] = node;
    merged_count = merged_count + 1
    current = tail
  else
    count_done = true
  end;
  if count_done then
    break;
  end;
end;
if merged_count == 2 && render_search_sources raw
  == "- Google Drive: Drive, Docs, Sheets, and Slides.\n- docs" then
    score = score + 1
  end;

let definitions: FixtureDefinitions = tool_search_tool_definitions();
if let #Cons node = definitions then
  let [definition, tail] = node;
  let [name, exposure, tool_handler, payload, parallel, waits] = definition;
  let [namespace, local_name] = name;
  if namespace == "" && local_name == "tool_search" && parallel && !(waits) then
    if let #Direct = exposure then
      if let #ToolSearch = tool_handler then
        if let #ToolSearchPayload = payload then
          if let #Nil = tail then
            score = score + 10
          end;
        end;
      end;
    end;
  end;
end;

let parameters = tool_search_parameters 8;
if parameters
  == "{\"type\":\"object\",\"properties\":{\"limit\":{\"type\":\"number\",\"description\":\"Maximum number of tools to return. Defaults to 8.\"},\"query\":{\"type\":\"string\",\"description\":\"Search query for deferred tools.\"}},\"required\":[\"query\"],\"additionalProperties\":false}" then
    score = score + 100
  end;

let specs: FixtureSpecs = tool_search_tool_specs(raw, 8);
if let #Cons node = specs then
  let [spec, tail] = node;
  let [_, kind, description, actual_parameters, output, strict] = spec;
  let no_output = if let #ToolOutputSchemaMissing = output then true else false end;
  if text_contains(description, "Searches over deferred tool metadata with BM25") && text_contains(
    description,
    "- Google Drive: Drive, Docs, Sheets, and Slides.\n- docs",
  ) && actual_parameters == parameters && no_output && !(strict) then
    if let #ToolSearchSpec = kind then
      if let #Nil = tail then
        score = score + 1000
      end;
    end;
  end;
end;

return { .score = score };
