const { .decrement_thread_elicitation, .increment_thread_elicitation } =
  import "./app_server_thread_controls.duck" ();

let score = 0;
if let #Ok count = increment_thread_elicitation 0i64 then
  if count == 1i64 then
    score = score + 1
  end;
end;
if let #Err reason = increment_thread_elicitation 9223372036854775807i64 then
  if reason == "out-of-band elicitation count overflowed" then
    score = score + 10
  end;
end;
if let #Ok count = decrement_thread_elicitation 1i64 then
  if count == 0i64 then
    score = score + 100
  end;
end;
if let #Err reason = decrement_thread_elicitation 0i64 then
  if reason == "out-of-band elicitation count is already zero" then
    score = score + 1000
  end;
end;

return { .score = score };
