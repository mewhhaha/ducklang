module () where

const {} = import "./image_preparation_types.duck" ();

const ascii_lowercase = (byte: I32) => do
  if byte >= 65 && byte <= 90 then byte + 32 else byte end;
end;

const has_ascii_case_insensitive_prefix: [Text, Text] -> Bool = (text, prefix) => do
  let text_length = @len text;
  let prefix_length = @len prefix;
  if text_length < prefix_length then
    false
  else
    let matches = true;
    let index = 0;
    loop do
      if index >= prefix_length then
        break;
      end;
      if ascii_lowercase(@get(text, index)) != ascii_lowercase(@get(prefix, index)) then
        matches = false
      end;
      index = index + 1
    end;
    matches
  end;
end;

const plan_image_preparation: OutputImage -> ImagePreparationPlan = image => do
  let [image_url, detail] = image;
  let is_http = has_ascii_case_insensitive_prefix(image_url, "http:");
  let is_https = has_ascii_case_insensitive_prefix(image_url, "https:");

  if is_http || is_https then
    [.status_code = 2, .image_url = image_url, .max_dimension = 0, .max_patches = 0]
  else !(has_ascii_case_insensitive_prefix(image_url, "data:")) then
    [.status_code = 0, .image_url = image_url, .max_dimension = 0, .max_patches = 0]
  else let #Some selected = detail then
    if let #Low = selected then
      [.status_code = 3, .image_url = image_url, .max_dimension = 0, .max_patches = 0]
    else let #Original = selected then
      [.status_code = 1, .image_url = image_url, .max_dimension = 6000, .max_patches = 10000]
    else
      [.status_code = 1, .image_url = image_url, .max_dimension = 2048, .max_patches = 2500]
    end;
  else
    [.status_code = 1, .image_url = image_url, .max_dimension = 2048, .max_patches = 2500]
  end;
end;

return { .plan_image_preparation };
