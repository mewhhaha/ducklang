module () where

const { .list } = import "duck:prelude/functional" ();
const { .parse_app_server_launch } = import "./cli_app_server_runtime.duck" ();
const {} = import "./cli_types.duck" ();

type FixtureArgs = CodexCliArgs
type FixtureResult = CodexAppServerCommandResult

const args = comptime list Text;
let score = 0;

let defaults: FixtureResult = parse_app_server_launch(args.empty());
if let #Ok command = defaults then
  if let #LaunchAppServer options = command then
    if let #AppServerStdio = options.transport then
      score = score + 1
    end;
  end;
end;

let unix_input: FixtureArgs = args.prepend(
  "--listen",
  args.prepend(
    "unix:///tmp/codex.sock",
    args.prepend(
      "--strict-config",
      args.prepend("--remote-control", args.singleton("--analytics-default-enabled")),
    ),
  ),
);
let unix: FixtureResult = parse_app_server_launch unix_input;
if let #Ok command = unix then
  if let #LaunchAppServer options = command then
    if let #AppServerUnixSocket socket_path = options.transport then
      if let #Some path = socket_path then
        if path == "/tmp/codex.sock" && options.strict_config && options.remote_control
          && options.analytics_default_enabled then
            score = score + 10
          end;
      end;
    end;
  end;
end;

let disabled: FixtureResult = parse_app_server_launch(
  args.prepend("--listen", args.singleton("off"))
);
if let #Ok command = disabled then
  if let #LaunchAppServer options = command then
    if let #AppServerOff = options.transport then
      score = score + 100
    end;
  end;
end;

let invalid: FixtureResult = parse_app_server_launch(
  args.prepend("--listen", args.singleton("http://example.com"))
);
if let #Err _ = invalid then
  score = score + 1000
end;

return { .score = score };
