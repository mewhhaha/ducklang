const { .thread_goal_availability } = import "./app_server_goals.duck" ();

let score = 0;
if let #ThreadGoalsDisabled = thread_goal_availability(false, #PersistentThread, "thread-1") then
  score = score + 1 end;
if let #EphemeralThreadGoalsUnsupported thread_id = thread_goal_availability(
  true,
  #EphemeralThread,
  "thread-2",
) then
  if thread_id == "thread-2" then
    score = score + 10
  end;
end;
if let #ThreadGoalsAvailable = thread_goal_availability(true, #PersistentThread, "thread-3") then
  score = score + 100 end;

return { .score = score };
