module () where

const { .plan_code_mode_wait_lifecycle } = import "./code_mode_wait_lifecycle.duck" ();
const {} = import "./code_mode_wait_types.duck" ();

type FixtureLifecyclePlan = CodeModeWaitLifecyclePlan

let score = 0;

let yielded: FixtureLifecyclePlan = plan_code_mode_wait_lifecycle(
  #LiveCell (["cell-3", #Yielded])
);
if let #CellRemainsOpen cell_id = yielded then
  if cell_id == "cell-3" then
    score = score + 1
  end;
end;

let completed: FixtureLifecyclePlan = plan_code_mode_wait_lifecycle(
  #LiveCell (["cell-4", #Result])
);
if let #CloseCell cell_id = completed then
  if cell_id == "cell-4" then
    score = score + 10
  end;
end;

let terminated: FixtureLifecyclePlan = plan_code_mode_wait_lifecycle(
  #LiveCell (["cell-5", #Terminated])
);
if let #CloseCell cell_id = terminated then
  if cell_id == "cell-5" then
    score = score + 100
  end;
end;

let missing: FixtureLifecyclePlan = plan_code_mode_wait_lifecycle(
  #MissingCell (["cell-6", #Result])
);
if let #NoCellToClose = missing then
  score = score + 1000
end;

return { .score = score };
