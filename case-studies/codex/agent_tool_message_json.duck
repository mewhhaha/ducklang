module () where

const { .parse_json_document } = import "duck:prelude/json" ();
const {} = import "duck:prelude/json/values" ();
const { .format_i32, .text_append } = import "duck:prelude/runtime" ();
const {} = import "./agent_tool_types.duck" ();

type AgentMessageJsonTextOption = AgentTextOption

const message_decode_failure: Text -> AgentToolMessageDecodeResult = reason => do
  #AgentMessageDecodeFailed (
    text_append("failed to parse collaboration message arguments: ", reason)
  )
end;

const parse_agent_message_args: Text -> AgentToolMessageDecodeResult = document => do
  let parsed = parse_json_document document;
  if let #Err error = parsed then
    let [position, message] = error;
    return message_decode_failure(
      text_append(message, text_append(" at byte ", format_i32 position))
    );
  end;
  if let #Ok value_and_position = parsed then
    let [value, _] = value_and_position;
    if let #Object object = value then
      let target: AgentMessageJsonTextOption = #None;
      let message: AgentMessageJsonTextOption = #None;
      let seen_target = false;
      let seen_message = false;
      let failure = "";
      let current = object;
      let done = false;
      loop do
        if failure != "" then
          break;
        end;
        if let #Cons node = current then
          let [member, tail] = node;
          let [key, field] = member;
          if key == "target" then
            if seen_target then
              failure = "target must not be repeated"
            else let #String text = field then
              target = #Some text
              seen_target = true
            else
              failure = "target must be a string"
            end;
          else key == "message" then
            if seen_message then
              failure = "message must not be repeated"
            else let #String text = field then
              message = #Some text
              seen_message = true
            else
              failure = "message must be a string"
            end;
          else
            failure = text_append("unknown collaboration message field: ", key)
          end;
          current = tail
        else
          done = true
        end;
        if done then
          break;
        end;
      end;

      if failure != "" then
        return message_decode_failure failure;
      end;
      if let #None = target then
        return message_decode_failure "target is required";
      end;
      if let #None = message then
        return message_decode_failure "message is required";
      end;
      if let #Some decoded_target = target then
        if let #Some decoded_message = message then
          #AgentMessageDecoded [.target = decoded_target, .message = decoded_message]
        else
          message_decode_failure "message decoding produced no value"
        end;
      else
        message_decode_failure "target decoding produced no value"
      end;
    else
      message_decode_failure "arguments must be an object"
    end;
  else
    message_decode_failure "JSON parsing produced no result"
  end;
end;

return { .parse_agent_message_args };
