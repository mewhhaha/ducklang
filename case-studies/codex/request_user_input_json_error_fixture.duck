module () where

const { .parse_request_user_input_args } = import "./request_user_input_json.duck" ();

let score = 0;
if let #ParseFailed message = parse_request_user_input_args "[]" then
  if message
    == "failed to parse function arguments: request_user_input arguments must be an object" then
      score = score + 1
    end;
end;
if let #ParseFailed message = parse_request_user_input_args "{}" then
  if message == "failed to parse function arguments: questions is required" then
    score = score + 10 end;
end;
if let #ParseFailed message = parse_request_user_input_args "{\"questions\":true}" then
  if message == "failed to parse function arguments: questions must be an array" then
    score = score + 100 end;
end;
if let #ParseFailed message = parse_request_user_input_args "{\"questions\":[],\"autoResolutionMs\":18446744073709551616}" then
  if message
    == "failed to parse function arguments: autoResolutionMs must be an unsigned 64-bit integer" then
      score = score + 1000
    end;
end;

return { .score = score };
