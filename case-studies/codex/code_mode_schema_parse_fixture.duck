module () where

const { .json_object_get } = import "duck:prelude/json/values" ();
const { .text_contains } = import "duck:prelude/runtime" ();
const { .parse_code_mode_schema } = import "./code_mode_schema_parse.duck" ();

let score = 0;

let missing = parse_code_mode_schema("weather", "input", #CodeModeSchemaDocumentMissing);
if let #CodeModeParsedSchemaMissing = missing then
  score = score + 1
end;

let parsed = parse_code_mode_schema(
  "weather",
  "input",
  #CodeModeSchemaDocumentPresent "{\"type\":\"object\"}",
);
if let #CodeModeParsedSchemaPresent schema = parsed then
  if let #Object object = schema then
    if let #Found value = json_object_get("type", object) then
      if let #String name = value then
        if name == "object" then
          score = score + 10
        end;
      end;
    end;
  end;
end;

let invalid = parse_code_mode_schema("weather", "output", #CodeModeSchemaDocumentPresent "{");
if let #CodeModeParsedSchemaFailed message = invalid then
  if text_contains(message, "tool weather output schema at byte") then
    score = score + 100
  end;
end;

return { .score = score };
