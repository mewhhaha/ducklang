module () where

const { .format_i32, .text_append, .text_equal_ascii_case_insensitive, .text_trim_ascii_whitespace } =
  import "duck:prelude/runtime" ();
const { .parse_u32_decimal } = import "duck:prelude/numeric/parse" ();
const {} = import "./agent_tool_types.duck" ();
const { .execution_capacity, .spawn_depth_allowed } = import "./agent_capacity.duck" ();
const { .validate_collab_input } = import "./agent_input_policy.duck" ();
const { .resolve_agent_path } = import "./agent_path.duck" ();

type AgentSpawnCallForkTurnsResult =
  | #ForkTurnsParsed AgentToolForkTurns
  | #ForkTurnsRejected Text

const parse_fork_turns: AgentTextOption -> AgentSpawnCallForkTurnsResult = requested => do
  if let #None = requested then
    return #ForkTurnsParsed (#ForkAllTurns);
  end;
  if let #Some raw_value = requested then
    let value = text_trim_ascii_whitespace raw_value;
    if value == "" || text_equal_ascii_case_insensitive [value, "all"] then
      #ForkTurnsParsed (#ForkAllTurns)
    else text_equal_ascii_case_insensitive [value, "none"] then
      #ForkTurnsParsed (#ForkNoTurns)
    else
      let parsed = parse_u32_decimal value;
      if let #Ok turns = parsed then
        if turns > 0i64 then
          #ForkTurnsParsed (#ForkRecentTurns turns)
        else
          #ForkTurnsRejected "fork_turns must be `none`, `all`, or a positive integer string"
        end;
      else
        #ForkTurnsRejected "fork_turns must be `none`, `all`, or a positive integer string"
      end;
    end;
  else
    #ForkTurnsRejected "fork_turns parsing produced no result"
  end;
end;

const plan_spawn_agent_call: [AgentToolContext, AgentToolSpawnArguments] -> AgentToolPlan = (
  context,
  arguments,
) => do
  if !(context.v2_enabled) then
    return #AgentToolRejected "collaboration tools require multi-agent V2";
  end;

  if !(spawn_depth_allowed(context.current_depth, context.maximum_depth)) then
    let attempted_depth = context.current_depth + 1;
    return #AgentToolRejected (
      text_append(
        "agent spawn depth ",
        text_append(
          format_i32 attempted_depth,
          text_append(" exceeds maximum depth ", format_i32 context.maximum_depth),
        ),
      )
    );
  end;

  let capacity = execution_capacity(
    #V2,
    context.source,
    context.active_turn,
    context.active_agents,
    context.maximum_threads,
  );
  if let #AgentLimitReached maximum_threads = capacity then
    return #AgentToolRejected (
      text_append("agent thread limit reached: maximum ", format_i32 maximum_threads)
    );
  end;

  let validated = validate_collab_input(#Some arguments.message, -1);
  if let #InputRejected message = validated then
    return #AgentToolRejected message;
  end;

  let parsed_fork_turns = parse_fork_turns arguments.fork_turns;
  if let #ForkTurnsRejected message = parsed_fork_turns then
    #AgentToolRejected message
  else let #ForkTurnsParsed fork_turns = parsed_fork_turns then
    let target = resolve_agent_path(context.current_path, arguments.task_name);
    if let #InvalidPath message = target then
      #AgentToolRejected message
    else let #Path path = target then
      #SpawnAgentPlanned [
        .path = path,
        .message = arguments.message,
        .fork_turns = fork_turns,
        .model = arguments.model,
        .reasoning_effort = arguments.reasoning_effort,
      ]
    else
      #AgentToolRejected "agent spawn target resolution produced no path"
    end;
  else
    #AgentToolRejected "fork_turns parsing produced no value"
  end;
end;

return { .plan_spawn_agent_call };
