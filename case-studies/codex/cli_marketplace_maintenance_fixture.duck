module () where

const { .list } = import "duck:prelude/functional" ();
const { .parse_marketplace_list, .parse_marketplace_remove, .parse_marketplace_upgrade } =
  import "./cli_plugin.duck" ();
const {} = import "./cli_types.duck" ();

type FixtureArgs = CodexCliArgs
type FixtureResult = CodexPluginCommandResult

const args = comptime list Text;
let score = 0;

let listed: FixtureResult = parse_marketplace_list(args.singleton("--json"));
if let #Ok command = listed then
  if let #MarketplaceList json = command then
    if json then
      score = score + 1
    end;
  end;
end;

let upgraded: FixtureResult = parse_marketplace_upgrade(
  args.prepend("debug", args.singleton("--json"))
);
if let #Ok command = upgraded then
  if let #MarketplaceUpgrade options = command then
    if let #Some marketplace_name = options.marketplace_name then
      if marketplace_name == "debug" && options.json then
        score = score + 10
      end;
    end;
  end;
end;

let removed: FixtureResult = parse_marketplace_remove(
  args.prepend("debug", args.singleton("--json"))
);
if let #Ok command = removed then
  if let #MarketplaceRemove options = command then
    if options.marketplace_name == "debug" && options.json then
      score = score + 100
    end;
  end;
end;

return { .score = score };
