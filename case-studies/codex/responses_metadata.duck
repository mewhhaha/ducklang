module () where

const { .list, .text_less_than } = import "duck:prelude/functional" ();
const { .format_i64 } = import "duck:prelude/numeric" ();
const { .encode_json_ascii } = import "duck:prelude/json/encode" ();
const {
  .json_bool,
  .json_number,
  .json_object,
  .json_object_empty,
  .json_object_prepend,
  .json_object_reverse,
  .json_string,
} = import "duck:prelude/json/values" ();
const {} = import "./responses_metadata_types.duck" ();
const {
  .compaction_implementation_tag,
  .compaction_phase_tag,
  .compaction_reason_tag,
  .compaction_trigger_tag,
} = import "./compaction_tags.duck" ();

type MetadataTextOption = ResponsesMetadataTextOption
type MetadataPair = ResponsesMetadataPair
type MetadataPairs = ResponsesMetadataPairs
type MetadataCompaction = ResponsesCompactionMetadata
type MetadataRequestKind = ResponsesRequestKind
type MetadataThreadSource = ResponsesThreadSource
type MetadataSessionSource = ResponsesSessionSource
type MetadataWorkspace = ResponsesWorkspace
type MetadataWorkspaces = ResponsesWorkspaces
type Metadata = ResponsesMetadata

const metadata_pairs = comptime list MetadataPair;
const metadata_workspaces = comptime list MetadataWorkspace;

const new_responses_metadata: (Text, Text, Text, Text) -> Metadata = (
  installation_id,
  session_id,
  thread_id,
  window_id,
) => do
  [
    .installation_id = installation_id,
    .session_id = session_id,
    .thread_id = thread_id,
    .turn_id = #None,
    .window_id = window_id,
    .request_kind = #None,
    .forked_from_thread_id = #None,
    .parent_thread_id = #None,
    .subagent_header = #None,
    .subagent_kind = #None,
    .thread_source = #None,
    .sandbox = #None,
    .workspaces = #Nil,
    .turn_started_at_unix_ms = #None,
    .extra = #Nil,
  ]
end;

const metadata_key_is_reserved: Text -> Bool = key => do
  if key == "installation_id" then
    true
  else key == "x-codex-installation-id" then
    true
  else key == "session_id" then
    true
  else key == "thread_id" then
    true
  else key == "turn_id" then
    true
  else key == "window_id" then
    true
  else key == "x-codex-window-id" then
    true
  else key == "x-codex-turn-metadata" then
    true
  else key == "x-codex-parent-thread-id" then
    true
  else key == "x-openai-subagent" then
    true
  else key == "request_kind" then
    true
  else key == "compaction" then
    true
  else key == "turn_started_at_unix_ms" then
    true
  else key == "forked_from_thread_id" then
    true
  else key == "parent_thread_id" then
    true
  else key == "subagent_kind" then
    true
  else key == "thread_source" then
    true
  else key == "sandbox" then
    true
  else
    key == "workspaces"
  end;
end;

const sort_metadata_pairs: MetadataPairs -> MetadataPairs = values => do
  metadata_pairs.sort_by(values, (left: MetadataPair, right: MetadataPair) => do
    let [left_key, _] = left;
    let [right_key, _] = right;
    text_less_than (left_key, right_key)
  end)
end;

const filter_extra_metadata: MetadataPairs -> MetadataPairs = values => do
  let current = values;
  let filtered = metadata_pairs.empty();

  loop do
    if let #Cons node = current then
      let typed_node: ListNode MetadataPair = node;
      let [pair, tail] = typed_node;
      let [key, _] = pair;
      if !(metadata_key_is_reserved key) then
        filtered = metadata_pairs.prepend(pair, filtered)
      end;
      current = tail
    else
      break;
    end;
  end;

  sort_metadata_pairs filtered
end;

const compaction_metadata_json: MetadataCompaction -> Json = metadata => do
  let fields = json_object_empty();
  fields = json_object_prepend("strategy", json_string "memento", fields)
  fields = json_object_prepend(
    "phase",
    json_string(compaction_phase_tag metadata.phase),
    fields,
  )
  fields = json_object_prepend(
    "implementation",
    json_string(compaction_implementation_tag metadata.implementation),
    fields,
  )
  fields = json_object_prepend(
    "reason",
    json_string(compaction_reason_tag metadata.reason),
    fields,
  )
  fields = json_object_prepend(
    "trigger",
    json_string(compaction_trigger_tag metadata.trigger),
    fields,
  )
  json_object fields
end;

const request_kind_text: MetadataRequestKind -> Text = request_kind => do
  if let #Turn = request_kind then
    "turn"
  else let #Prewarm = request_kind then
    "prewarm"
  else let #Compaction _ = request_kind then
    "compaction"
  else
    "memory"
  end;
end;

const request_kind_has_turn_identity: MetadataRequestKind -> Bool = request_kind => do
  if let #Memory = request_kind then false else true end;
end;

const thread_source_text: MetadataThreadSource -> Text = source => do
  if let #User = source then
    "user"
  else let #Subagent = source then
    "subagent"
  else let #Feature feature = source then
    feature
  else
    "memory_consolidation"
  end;
end;

const subagent_header_value: MetadataSessionSource -> MetadataTextOption = source => do
  let result: MetadataTextOption = #None;

  if let #SubAgent subagent = source then
    if let #Review = subagent then
      result = #Some "review"
    else let #Compact = subagent then
      result = #Some "compact"
    else let #ThreadSpawn = subagent then
      result = #Some "collab_spawn"
    else let #MemoryConsolidation = subagent then
      result = #Some "memory_consolidation"
    else let #Other label = subagent then
      result = #Some label
    end;
  else let #InternalMemoryConsolidation = source then
    result = #Some "memory_consolidation"
  end;

  result
end;

const subagent_metadata_kind: MetadataSessionSource -> MetadataTextOption = source => do
  let result: MetadataTextOption = #None;

  if let #SubAgent subagent = source then
    if let #Review = subagent then
      result = #Some "review"
    else let #Compact = subagent then
      result = #Some "compact"
    else let #ThreadSpawn = subagent then
      result = #Some "thread_spawn"
    else let #MemoryConsolidation = subagent then
      result = #Some "memory_consolidation"
    else let #Other label = subagent then
      result = #Some label
    end;
  end;

  result
end;

const metadata_pairs_json_object: MetadataPairs -> JsonObject = values => do
  let current = sort_metadata_pairs values;
  let reversed = json_object_empty();

  loop do
    if let #Cons node = current then
      let typed_node: ListNode MetadataPair = node;
      let [pair, tail] = typed_node;
      let [key, value] = pair;
      reversed = json_object_prepend(key, json_string value, reversed)
      current = tail
    else
      break;
    end;
  end;

  json_object_reverse reversed
end;

const workspace_json: MetadataWorkspace -> Json = workspace => do
  let fields = json_object_empty();

  if let #Some has_changes = workspace.has_changes then
    fields = json_object_prepend("has_changes", json_bool has_changes, fields)
  end;
  if let #Some latest_git_commit_hash = workspace.latest_git_commit_hash then
    fields = json_object_prepend(
      "latest_git_commit_hash",
      json_string latest_git_commit_hash,
      fields,
    )
  end;
  if let #Some associated_remote_urls = workspace.associated_remote_urls then
    fields = json_object_prepend(
      "associated_remote_urls",
      json_object(metadata_pairs_json_object associated_remote_urls),
      fields,
    )
  end;

  json_object fields
end;

const workspaces_json_object: MetadataWorkspaces -> JsonObject = values => do
  let current = metadata_workspaces.sort_by(
    values,
    (left: MetadataWorkspace, right: MetadataWorkspace) => text_less_than (left.path, right.path),
  );
  let reversed = json_object_empty();

  loop do
    if let #Cons node = current then
      let typed_node: ListNode MetadataWorkspace = node;
      let [workspace, tail] = typed_node;
      reversed = json_object_prepend(workspace.path, workspace_json workspace, reversed)
      current = tail
    else
      break;
    end;
  end;

  json_object_reverse reversed
end;

const responses_metadata_payload: Metadata -> Json = metadata => do
  let fields = metadata_pairs_json_object(filter_extra_metadata metadata.extra);
  let has_turn_identity = true;
  let has_request_identity = false;

  if let #Some request_kind = metadata.request_kind then
    has_turn_identity = request_kind_has_turn_identity request_kind
    has_request_identity = has_turn_identity

    if let #Compaction compaction = request_kind then
      fields = json_object_prepend("compaction", compaction_metadata_json compaction, fields)
    end;
  end;

  if let #Some started_at = metadata.turn_started_at_unix_ms then
    fields = json_object_prepend(
      "turn_started_at_unix_ms",
      json_number(format_i64 started_at),
      fields,
    )
  end;
  if let #Cons _ = metadata.workspaces then
    fields = json_object_prepend(
      "workspaces",
      json_object(workspaces_json_object metadata.workspaces),
      fields,
    )
  end;
  if let #Some sandbox = metadata.sandbox then
    fields = json_object_prepend("sandbox", json_string sandbox, fields)
  end;
  if let #Some thread_source = metadata.thread_source then
    fields = json_object_prepend(
      "thread_source",
      json_string(thread_source_text thread_source),
      fields,
    )
  end;
  if let #Some subagent_kind = metadata.subagent_kind then
    fields = json_object_prepend("subagent_kind", json_string subagent_kind, fields)
  end;
  if let #Some parent_thread_id = metadata.parent_thread_id then
    fields = json_object_prepend("parent_thread_id", json_string parent_thread_id, fields)
  end;
  if let #Some forked_from_thread_id = metadata.forked_from_thread_id then
    fields = json_object_prepend(
      "forked_from_thread_id",
      json_string forked_from_thread_id,
      fields,
    )
  end;
  if let #Some request_kind = metadata.request_kind then
    fields = json_object_prepend(
      "request_kind",
      json_string(request_kind_text request_kind),
      fields,
    )
  end;
  if has_request_identity then
    fields = json_object_prepend("window_id", json_string metadata.window_id, fields)
  end;
  if has_turn_identity then
    if let #Some turn_id = metadata.turn_id then
      fields = json_object_prepend("turn_id", json_string turn_id, fields)
    end;
    fields = json_object_prepend("thread_id", json_string metadata.thread_id, fields)
    fields = json_object_prepend("session_id", json_string metadata.session_id, fields)
  end;
  if has_request_identity then
    fields = json_object_prepend(
      "installation_id",
      json_string metadata.installation_id,
      fields,
    )
  end;

  json_object fields
end;

const responses_metadata_json: Metadata -> Text = metadata => do
  encode_json_ascii(responses_metadata_payload metadata)
end;

const has_turn_metadata: Metadata -> Bool = metadata => do
  if let #Some _ = metadata.request_kind then true else false end;
end;

const responses_client_metadata: Metadata -> MetadataPairs = metadata => do
  let values = metadata_pairs.empty();
  values = metadata_pairs.prepend(["x-codex-installation-id", metadata.installation_id], values)
  values = metadata_pairs.prepend(["session_id", metadata.session_id], values)
  values = metadata_pairs.prepend(["thread_id", metadata.thread_id], values)
  values = metadata_pairs.prepend(["x-codex-window-id", metadata.window_id], values)

  if let #Some turn_id = metadata.turn_id then
    values = metadata_pairs.prepend(["turn_id", turn_id], values)
  end;
  if let #Some subagent_header = metadata.subagent_header then
    values = metadata_pairs.prepend(["x-openai-subagent", subagent_header], values)
  end;
  if let #Some parent_thread_id = metadata.parent_thread_id then
    values = metadata_pairs.prepend(["x-codex-parent-thread-id", parent_thread_id], values)
  end;
  if has_turn_metadata metadata then
    values = metadata_pairs.prepend(
      ["x-codex-turn-metadata", responses_metadata_json metadata],
      values,
    )
  end;

  sort_metadata_pairs values
end;

const responses_compatibility_headers: Metadata -> MetadataPairs = metadata => do
  let values = metadata_pairs.singleton(["x-codex-window-id", metadata.window_id]);

  if has_turn_metadata metadata then
    values = metadata_pairs.prepend(
      ["x-codex-turn-metadata", responses_metadata_json metadata],
      values,
    )
  end;
  if let #Some parent_thread_id = metadata.parent_thread_id then
    values = metadata_pairs.prepend(["x-codex-parent-thread-id", parent_thread_id], values)
  end;
  if let #Some subagent_header = metadata.subagent_header then
    values = metadata_pairs.prepend(["x-openai-subagent", subagent_header], values)
  end;

  sort_metadata_pairs values
end;

return {
  .new_responses_metadata,
  .metadata_key_is_reserved,
  .filter_extra_metadata,
  .request_kind_text,
  .request_kind_has_turn_identity,
  .thread_source_text,
  .subagent_header_value,
  .subagent_metadata_kind,
  .responses_metadata_payload,
  .responses_metadata_json,
  .has_turn_metadata,
  .responses_client_metadata,
  .responses_compatibility_headers,
};
