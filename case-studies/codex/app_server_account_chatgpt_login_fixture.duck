const { .json_bool, .json_object_empty, .json_object_prepend, .json_string } =
  import "duck:prelude/json/values" ();
const { .decode_account_chatgpt_login } = import "./app_server_account_methods.duck" ();
const {} = import "./app_server_types.duck" ();
const {} = import "./app_server_account_types.duck" ();

type FixtureResult = AppServerAccountLoginDecodeResult

let fields = json_object_empty();
fields = json_object_prepend("appBrand", json_string "chatgpt", fields)
fields = json_object_prepend("useHostedLoginSuccessPage", json_bool true, fields)
fields = json_object_prepend("codexStreamlinedLogin", json_bool true, fields)
let decoded: FixtureResult = decode_account_chatgpt_login fields;
let score = 0;
if let #AccountLoginOk login = decoded then
  if let #AccountChatgptLogin state = login then
    let [streamlined, hosted_page, brand] = state;
    if streamlined && hosted_page then
      if let #Some value = brand then
        if let #ChatgptBrand = value then
          score = 1
        end;
      end;
    end;
  end;
end;

return { .score = score };
