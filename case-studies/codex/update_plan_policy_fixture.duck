module () where

const {} = import "./update_plan_types.duck" ();
const { .plan_parsed_update_plan, .plan_update_plan_payload, .update_plan_completion } =
  import "./update_plan_policy.duck" ();

type FixtureArgs = UpdatePlanArgs
type FixtureStep = UpdatePlanStep
type FixtureStepNode = UpdatePlanStepNode
type FixtureSteps = UpdatePlanSteps

let score = 0;

if let #RejectPayload message = plan_update_plan_payload(#Unsupported, #Plan) then
  if message == "update_plan handler received unsupported payload" then
    score = score + 1
  end;
end;

if let #RejectPayload message = plan_update_plan_payload(#Function "not json", #Plan) then
  if message == "update_plan is a TODO/checklist tool and is not allowed in Plan mode" then
    score = score + 10 end;
end;

if let #ParseArguments arguments = plan_update_plan_payload(#Function "{}", #Default) then
  if arguments == "{}" then
    score = score + 100
  end;
end;

let steps: FixtureSteps = #Cons (
  [
    [.step = "compile", .status = #InProgress] as FixtureStep,
    #Cons ([[.step = "test", .status = #InProgress] as FixtureStep, #Nil] as FixtureStepNode),
  ] as FixtureStepNode
);
let args: FixtureArgs = [.explanation = #Some "Keep both active", .plan = steps];
if let #Publish published = plan_parsed_update_plan args then
  if let #Some explanation = published.explanation then
    if explanation == "Keep both active" then
      if let #Cons first_node = published.plan then
        let [first, tail] = first_node;
        if first.step == "compile" then
          if let #InProgress = first.status then
            if let #Cons second_node = tail then
              let [second, finish] = second_node;
              if second.step == "test" then
                if let #InProgress = second.status then
                  if let #Nil = finish then
                    score = score + 1000
                  end;
                end;
              end;
            end;
          end;
        end;
      end;
    end;
  end;
end;

let completion = update_plan_completion();
if completion.text == "Plan updated" && completion.success && completion.code_mode == "{}" then
  score = score + 10000
end;

return { .score = score };
