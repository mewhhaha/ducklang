module () where

const {} = import "./mcp_resource_types.duck" ();
const { .validate_list_mcp_resource_args, .validate_read_mcp_resource_args } =
  import "./mcp_resource_policy.duck" ();

type FixtureListArgs = McpResourceListArgs
type FixtureReadArgs = McpResourceReadArgs

let score = 0;
let cursor_without_server: FixtureListArgs = [.server = #None, .cursor = #Some "next"];
if let #ListValidationFailed message = validate_list_mcp_resource_args(cursor_without_server,
  false) then
    if message == "cursor can only be used when a server is specified" then
      score = score + 1 end;
  end;

let disabled_list: FixtureListArgs = [.server = #Some "codex_apps", .cursor = #None];
if let #ListValidationFailed message = validate_list_mcp_resource_args(disabled_list, false) then
  if message == "MCP server 'codex_apps' is disabled by `orchestrator.mcp.enabled`" then
    score = score + 10 end;
end;

let enabled_list: FixtureListArgs = [.server = #Some "codex_apps", .cursor = #None];
if let #ListValid args = validate_list_mcp_resource_args(enabled_list, true) then
  if let #Some server = args.server then
    if server == "codex_apps" then
      score = score + 100
    end;
  end;
end;

let valid_read: FixtureReadArgs = [.server = "docs", .uri = "skill://alpha"];
if let #ReadValid args = validate_read_mcp_resource_args(valid_read, false) then
  if args.server == "docs" && args.uri == "skill://alpha" then
    score = score + 1000
  end;
end;

let disabled_read: FixtureReadArgs = [.server = "codex_apps", .uri = "resource://alpha"];
if let #ReadValidationFailed message = validate_read_mcp_resource_args(disabled_read, false) then
  if message == "MCP server 'codex_apps' is disabled by `orchestrator.mcp.enabled`" then
    score = score + 10000 end;
end;

return { .score = score };
