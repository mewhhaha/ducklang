module () where

const {} = import "./sandbox_tags_types.duck" ();

type TagNetworkPolicy = SandboxTagNetworkPolicy
type TagFileSystemKind = SandboxTagFileSystemKind
type TagFileSystem = SandboxTagFileSystem
type TagPermissionProfile = SandboxTagPermissionProfile
type TagWindowsLevel = SandboxTagWindowsLevel
type TagPlatform = SandboxTagPlatform

let rec network_policy_is_enabled: &TagNetworkPolicy -> Bool = (policy: &TagNetworkPolicy) => do
  if let #Enabled = policy then true else false end;
end;

let rec file_system_is_external: &TagFileSystemKind -> Bool = (kind: &TagFileSystemKind) => do
  if let #ExternalFileSystem = kind then true else false end;
end;

let rec should_require_platform_sandbox: [&TagFileSystem, &TagNetworkPolicy, Bool] -> Bool = (
  file_system: &TagFileSystem,
  network: &TagNetworkPolicy,
  enforce_managed_network: Bool,
) => do
  if enforce_managed_network then
    true
  else !(network_policy_is_enabled network) then
    !(file_system_is_external(&file_system.kind))
  else let #RestrictedFileSystem = file_system.kind then
    !(file_system.has_full_disk_write_access)
  else
    false
  end;
end;

let rec permission_profile_sandbox_tag: [
  &TagPermissionProfile,
  &TagWindowsLevel,
  Bool,
  &TagPlatform,
] -> Text = (
  profile: &TagPermissionProfile,
  windows_level: &TagWindowsLevel,
  enforce_managed_network: Bool,
  platform: &TagPlatform,
) => do
  if let #DisabledProfile = profile then
    @append("none", "")
  else let #ExternalProfile _ = profile then
    @append("external", "")
  else let #ManagedProfile managed = profile then
    if !(
      should_require_platform_sandbox(
        &managed.file_system,
        &managed.network,
        enforce_managed_network,
      )
    ) then
      @append("none", "")
    else platform.is_windows then
      if let #WindowsElevated = windows_level then
        @append("windows_elevated", "")
      else let #Some tag = platform.platform_sandbox_tag then
        @append(tag, "")
      else
        @append("none", "")
      end;
    else let #Some tag = platform.platform_sandbox_tag then
      @append(tag, "")
    else
      @append("none", "")
    end;
  else
    @append("none", "")
  end;
end;

let rec permission_profile_policy_tag: &TagPermissionProfile -> Text = (
  profile: &TagPermissionProfile) => do
    if let #DisabledProfile = profile then
      @append("danger-full-access", "")
    else let #ExternalProfile _ = profile then
      @append("external-sandbox", "")
    else let #ManagedProfile managed = profile then
      if managed.file_system.has_full_disk_write_access then
        @append("danger-full-access", "")
      else managed.file_system.has_writable_roots then
        @append("workspace-write", "")
      else
        @append("read-only", "")
      end;
    else
      @append("danger-full-access", "")
    end;
  end;

return {
  .should_require_platform_sandbox,
  .permission_profile_sandbox_tag,
  .permission_profile_policy_tag,
};
