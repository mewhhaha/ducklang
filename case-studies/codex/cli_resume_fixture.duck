module () where

const { .parse_resume_options } = import "./cli_sessions.duck" ();
const {} = import "./cli_types.duck" ();

type FixtureArgs = CodexCliArgs
type FixtureResult = CodexResumeOptionsResult
type FixtureTexts = CodexCliTexts
type FixtureTextNode = ListNode Text
type FixtureTextOption = CodexCliTextOption
type FixtureSandboxOption = CodexCliSandboxModeOption
type FixtureApprovalOption = CodexCliApprovalModeOption

const empty_args = () => do
  let values: FixtureArgs = #Nil;
  values
end;
const prepend_arg = (value: Text, values: FixtureArgs) => do
  let node: FixtureTextNode = [value, values];
  let result: FixtureArgs = #Cons node;
  result
end;
let input: FixtureArgs = prepend_arg("sid",
  prepend_arg("--oss",
    prepend_arg("--search",
      prepend_arg("--sandbox",
        prepend_arg("workspace-write",
          prepend_arg("--ask-for-approval",
            prepend_arg("on-request",
              prepend_arg("-m",
                prepend_arg("gpt-5.1-test",
                  prepend_arg("-p",
                    prepend_arg("my-config",
                      prepend_arg("-C",
                        prepend_arg("/tmp",
                          prepend_arg("--strict-config",
                            prepend_arg("-i",
                              prepend_arg("/tmp/a.png,/tmp/b.png",
                                prepend_arg("continue here", empty_args())))))))))))))))));

const text_option_equals: (FixtureTextOption, Text) -> Bool = (
  value: FixtureTextOption,
  expected: Text,
) => do
  if let #Some present = value then present == expected else false end;
end;

const sandbox_is_workspace_write: FixtureSandboxOption -> Bool = (value: FixtureSandboxOption) => do
  if let #Some sandbox = value then
    if let #SandboxWorkspaceWrite = sandbox then true else false end;
  else
    false
  end;
end;

const approval_is_on_request: FixtureApprovalOption -> Bool = (value: FixtureApprovalOption) => do
  if let #Some approval = value then
    if let #ApprovalOnRequest = approval then true else false end;
  else
    false
  end;
end;

const images_match: FixtureTexts -> Bool = (images: FixtureTexts) => do
  if let #Cons first_node = images then
    let typed_first: FixtureTextNode = first_node;
    let [first, tail] = typed_first;
    if let #Cons second_node = tail then
      let typed_second: FixtureTextNode = second_node;
      let [second, done] = typed_second;
      if let #Nil = done then first == "/tmp/a.png" && second == "/tmp/b.png" else false end;
    else
      false
    end;
  else
    false
  end;
end;

let parsed: FixtureResult = parse_resume_options input;
let score = if let #Ok options = parsed then
  let controls = options.shared.oss && options.shared.search && options.shared.strict_config;
  if options.picker then
    controls = false
  end;
  if options.last then
    controls = false
  end;
  if options.all then
    controls = false
  end;
  let controls_score = if controls then 1 else 0 end;
  let session_score = if text_option_equals(options.session_id, "sid") then 2 else 0 end;
  let prompt_score = if text_option_equals(options.prompt, "continue here") then 4 else 0 end;
  let model_score = if text_option_equals(options.shared.model, "gpt-5.1-test") then 8 else 0 end;
  let profile_score = if text_option_equals(options.shared.profile, "my-config") then 16 else 0 end;
  let cwd_score = if text_option_equals(options.shared.cwd, "/tmp") then 32 else 0 end;
  let sandbox_score = if sandbox_is_workspace_write options.shared.sandbox then 64 else 0 end;
  let approval_score = if approval_is_on_request options.shared.approval then 128 else 0 end;
  let images_score = if images_match options.shared.images then 256 else 0 end;
  controls_score + session_score + prompt_score + model_score + profile_score + cwd_score
    + sandbox_score + approval_score + images_score
else
  0
end;

return { .score = score };
