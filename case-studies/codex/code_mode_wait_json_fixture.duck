module () where

const { .parse_code_mode_wait_args } = import "./code_mode_wait_json.duck" ();
const {} = import "./code_mode_wait_types.duck" ();

type FixtureParseResult = CodeModeWaitParseResult

let score = 0;

let defaults: FixtureParseResult =
  parse_code_mode_wait_args "{\"cell_id\":\"cell-1\",\"ignored\":true,\"ignored\":false}";
if let #Parsed args = defaults then
  if let #U64Decimal yield_time_ms = args.yield_time_ms then
    if args.cell_id == "cell-1" && yield_time_ms == "10000" && !(args.terminate) then
      if let #WaitLimitMissing = args.max_tokens then
        score = score + 1
      end;
    end;
  end;
end;

let explicit: FixtureParseResult =
  parse_code_mode_wait_args "{\"cell_id\":\"cell-2\",\"yield_time_ms\":18446744073709551615,\"max_tokens\":42,\"terminate\":true}";
if let #Parsed args = explicit then
  if let #U64Decimal yield_time_ms = args.yield_time_ms then
    if args.cell_id == "cell-2" && yield_time_ms == "18446744073709551615" && args.terminate then
      if let #WaitLimitPresent max_tokens = args.max_tokens then
        if let #U64Decimal max_tokens_text = max_tokens then
          if max_tokens_text == "42" then
            score = score + 10
          end;
        end;
      end;
    end;
  end;
end;

let nullable: FixtureParseResult =
  parse_code_mode_wait_args "{\"cell_id\":\"cell-3\",\"max_tokens\":null}";
if let #Parsed args = nullable then
  if let #WaitLimitMissing = args.max_tokens then
    score = score + 100
  end;
end;

return { .score = score };
