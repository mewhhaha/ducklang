module () where

const {
  .json_array,
  .json_array_empty,
  .json_object,
  .json_object_empty,
  .json_object_prepend,
  .json_string,
} = import "duck:prelude/json" ();
const { .decode_thread_resume } = import "./app_server_thread_methods.duck" ();
const {} = import "./app_server_types.duck" ();

type FixtureResult = AppServerMethodDecodeResult

let fields = json_object_empty();
fields = json_object_prepend("path", json_string "", fields)
fields = json_object_prepend("history", json_array(json_array_empty()), fields)
fields = json_object_prepend("threadId", json_string "thread-1", fields)
let decoded: FixtureResult = decode_thread_resume(json_object fields);
let score = if let #MethodOk method = decoded then
  if let #ThreadResume params = method then
    let history_valid =
      if let #Some value = params.history then
        if let #Array _ = value then true else false end;
      else false end;
    let path_absent = if let #None = params.path then true else false end;
    if params.thread_id == "thread-1" && history_valid && path_absent then 1 else 0 end;
  else 0 end;
else 0 end;

return { .score = score };
