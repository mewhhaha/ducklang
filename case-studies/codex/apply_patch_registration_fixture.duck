module () where

const {} = import "./tool_types.duck" ();
const { .apply_patch_grammar, .apply_patch_tool_definitions, .apply_patch_tool_specs } =
  import "./apply_patch_registration.duck" ();

type FixtureDefinitions = ToolDefinitions
type FixtureSpecs = ToolSpecs

let score: I32 = 0;
let definitions: FixtureDefinitions = apply_patch_tool_definitions true;
if let #Cons node = definitions then
  let [definition, tail] = node;
  let [name, exposure, dispatch, payload, parallel, waits] = definition;
  let [namespace, local_name] = name;
  if namespace == "" && local_name == "apply_patch" && !(parallel) && !(waits) then
    if let #Direct = exposure then
      if let #ApplyPatch = dispatch then
        if let #CustomPayload = payload then
          if let #Nil = tail then
            score = score + 1
          end;
        end;
      end;
    end;
  end;
end;

let grammar = apply_patch_grammar();
if grammar
  == "Patch := Begin [ EnvironmentId ] { FileOp } End\nBegin := \"*** Begin Patch\" NEWLINE\nEnvironmentId := \"*** Environment ID: \" environmentId NEWLINE\nEnd := \"*** End Patch\" NEWLINE\nFileOp := AddFile | DeleteFile | UpdateFile\nAddFile := \"*** Add File: \" path NEWLINE { \"+\" line NEWLINE }\nDeleteFile := \"*** Delete File: \" path NEWLINE\nUpdateFile := \"*** Update File: \" path NEWLINE [ MoveTo ] { Hunk }\nMoveTo := \"*** Move to: \" newPath NEWLINE\nHunk := \"@@\" [ header ] NEWLINE { HunkLine } [ \"*** End of File\" NEWLINE ]\nHunkLine := (\" \" | \"-\" | \"+\") text NEWLINE" then
    score = score + 10
  end;

let specs: FixtureSpecs = apply_patch_tool_specs true;
if let #Cons node = specs then
  let [spec, tail] = node;
  let [_, kind, description, parameters, output, strict] = spec;
  if description
    == "Use apply_patch to edit files with a source-oriented patch containing one or more add, delete, or update operations." && parameters == grammar && !(
      strict
    ) then
      if let #FreeformSpec = kind then
        if let #ToolOutputSchemaMissing = output then
          if let #Nil = tail then
            score = score + 100
          end;
        end;
      end;
    end;
end;

let disabled_definitions: FixtureDefinitions = apply_patch_tool_definitions false;
let disabled_specs: FixtureSpecs = apply_patch_tool_specs false;
if let #Nil = disabled_definitions then
  if let #Nil = disabled_specs then
    score = score + 1000
  end;
end;

return { .score = score };
