module () where

const { .encode_json_string } = import "duck:prelude/json/encode" ();
const { .text_append, .text_split, .text_trim_whitespace } = import "duck:prelude/runtime" ();
const { .normalize_code_mode_identifier } = import "./code_mode_identifier.duck" ();
const { .plan_schema_input } = import "./code_mode_schema_decode.duck" ();

let rec render_schema_input: CodeModeSchemaInput -> Text = input => do
  let plan = plan_schema_input input;
  if let #CodeModePlanRendered rendered = plan then
    rendered
  else let #CodeModePlanArray element = plan then
    text_append [text_append ["Array<", render_schema_input element], ">"]
  else let #CodeModePlanTuple elements = plan then
    let current = elements;
    let rendered = "";
    let first = true;
    let done = false;
    loop do
      if let #CodeModeInputsCons node = current then
        let [element, tail] = node;
        if first then
          first = false
        else
          rendered = text_append [rendered, ", "]
        end;
        rendered = text_append [rendered, render_schema_input element]
        current = tail
      else
        done = true
      end;
      if done then
        break;
      end;
    end;
    text_append [text_append ["[", rendered], "]"]
  else let #CodeModePlanUnion variants = plan then
    let current = variants;
    let rendered = "";
    let first = true;
    let done = false;
    loop do
      if let #CodeModeInputsCons node = current then
        let [variant, tail] = node;
        if first then
          first = false
        else
          rendered = text_append [rendered, " | "]
        end;
        rendered = text_append [rendered, render_schema_input variant]
        current = tail
      else
        done = true
      end;
      if done then
        break;
      end;
    end;
    rendered
  else let #CodeModePlanIntersection variants = plan then
    let current = variants;
    let rendered = "";
    let first = true;
    let done = false;
    loop do
      if let #CodeModeInputsCons node = current then
        let [variant, tail] = node;
        if first then
          first = false
        else
          rendered = text_append [rendered, " & "]
        end;
        rendered = text_append [rendered, render_schema_input variant]
        current = tail
      else
        done = true
      end;
      if done then
        break;
      end;
    end;
    rendered
  else let #CodeModePlanObject object = plan then
    let [properties, additional] = object;
    let multiline = false;
    let description_current = properties;
    let descriptions_done = false;
    loop do
      if let #CodeModePropertiesCons node = description_current then
        let [[_, description, _, _], tail] = node;
        if description != "" then
          multiline = true
          descriptions_done = true
        else
          description_current = tail
        end;
      else
        descriptions_done = true
      end;
      if descriptions_done then
        break;
      end;
    end;

    let rendered = "";
    if multiline then
      rendered = "{"
    end;
    let current = properties;
    let first = true;
    let done = false;
    loop do
      if let #CodeModePropertiesCons node = current then
        let [[name, description, required, property_input], tail] = node;
        if multiline then
          let lines = text_split [description, "\n"];
          let line_current = lines;
          let lines_done = false;
          loop do
            if let #Cons line_node = line_current then
              let [line, line_tail] = line_node;
              let trimmed = text_trim_whitespace line;
              if trimmed != "" then
                rendered = text_append [
                  rendered,
                  text_append ["\n  // ", trimmed],
                ]
              end;
              line_current = line_tail
            else
              lines_done = true
            end;
            if lines_done then
              break;
            end;
          end;
          rendered = text_append [rendered, "\n  "]
        else !(first) then
          rendered = text_append [rendered, " "]
        end;

        let property_name = name;
        if normalize_code_mode_identifier name != name then
          property_name = encode_json_string name
        end;
        rendered = text_append [rendered, property_name]
        if !(required) then
          rendered = text_append [rendered, "?"]
        end;
        rendered = text_append [
          rendered,
          text_append [": ", render_schema_input property_input],
        ]
        rendered = text_append [rendered, ";"]
        first = false
        current = tail
      else
        done = true
      end;
      if done then
        break;
      end;
    end;

    if let #CodeModeAdditionalPresent additional_input = additional then
      if multiline then
        rendered = text_append [rendered, "\n  "]
      else rendered != "" then
        rendered = text_append [rendered, " "]
      end;
      rendered = text_append [
        rendered,
        text_append ["[key: string]: ", text_append [render_schema_input additional_input, ";"]],
      ]
    end;

    if multiline then
      text_append [rendered, "\n}"]
    else rendered == "" then
      "{}"
    else
      text_append [text_append ["{ ", rendered], " }"]
    end;
  else
    "unknown"
  end;
end;

let render_json_schema_to_typescript: Json -> Text = schema => do
  render_schema_input(#CodeModeInputSchema schema)
end;

return { .normalize_code_mode_identifier, .render_schema_input, .render_json_schema_to_typescript };
