module () where

const { .normalize_code_mode_identifier } = import "./code_mode_identifier.duck" ();

let score = 0;
if normalize_code_mode_identifier "hidden-dynamic-tool" == "hidden_dynamic_tool" then
  score = score + 1
end;
if normalize_code_mode_identifier "9lives" == "_lives" then
  score = score + 10
end;
if normalize_code_mode_identifier "éx" == "_x" then
  score = score + 100
end;
if normalize_code_mode_identifier "" == "_" then
  score = score + 1000
end;

return { .score = score };
