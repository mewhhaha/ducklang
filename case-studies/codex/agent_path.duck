module () where

const {
  .text_append,
  .text_byte_is_ascii_digit,
  .text_byte_is_ascii_lower,
  .text_find_from,
  .text_get,
  .text_length,
  .text_slice,
  .text_starts_with,
} = import "duck:prelude/runtime" ();
const {} = import "./agent_types.duck" ();

const append_agent_path_text = (left: Text, right: Text) => text_append [left, right];

const valid_agent_name = (name: Text) => do
  if name == "" || name == "root" || name == "." || name == ".." then
    false
  else
    let valid = true;
    for byte in name do
      if text_byte_is_ascii_lower byte || text_byte_is_ascii_digit byte || byte == 95 then () else
        valid = false end;
    end
    valid
  end;
end;

const validate_relative_agent_path = (reference: Text) => do
  if reference == "" then
    #InvalidPath "agent path must not be empty"
  else text_get [reference, text_length reference - 1] == 47 then
    #InvalidPath "relative agent path must not end with `/`"
  else
    let start = 0;
    let valid = true;
    let invalid_segment: Text = "";
    loop do
      let separator = text_find_from [reference, "/", start];
      let segment_end = if separator < 0 then text_length reference else separator end;
      let segment = text_slice [reference, start, segment_end];
      if valid_agent_name segment then
        if separator < 0 then
          break;
        else
          start = separator + 1
        end;
      else
        valid = false
        invalid_segment = segment
        break;
      end;
    end;

    if valid then
      #Path reference
    else invalid_segment == "root" || invalid_segment == "." || invalid_segment == ".." then
      #InvalidPath (
        append_agent_path_text(
          "agent_name `",
          append_agent_path_text(invalid_segment, "` is reserved"),
        )
      )
    else invalid_segment == "" then
      #InvalidPath "agent_name must not be empty"
    else
      #InvalidPath "agent_name must use only lowercase letters, digits, and underscores"
    end;
  end;
end;

const validate_absolute_agent_path = (path: Text) => do
  if path == "/morpheus" || path == "/root" then
    #Path path
  else text_starts_with [path, "/root/"] then
    let relative = text_slice [path, 6, text_length path];
    let validated = validate_relative_agent_path relative;
    if let #Path _ = validated then #Path path else let #InvalidPath message = validated then
      #InvalidPath message else #InvalidPath "invalid absolute agent path" end;
  else
    #InvalidPath "absolute agent paths must start with `/root` or be `/morpheus`"
  end;
end;

const resolve_agent_path = (current_path: Text, reference: Text) => do
  if reference == "" then
    #InvalidPath "agent path must not be empty"
  else reference == "/root" then
    #Path "/root"
  else text_get [reference, 0] == 47 then
    validate_absolute_agent_path reference
  else
    let validated = validate_relative_agent_path reference;
    if let #Path relative = validated then
      #Path (append_agent_path_text(current_path, append_agent_path_text("/", relative)))
    else let #InvalidPath message = validated then
      #InvalidPath message
    else
      #InvalidPath "invalid relative agent path"
    end;
  end;
end;

return {
  .resolve_agent_path,
  .valid_agent_name,
  .validate_absolute_agent_path,
  .validate_relative_agent_path,
};
