module () where

const {} = import "./agent_spawn_override_types.duck" ();
const { .select_spawn_overrides } = import "./agent_spawn_override.duck" ();
const { .fixture_override_input } = import "./agent_spawn_override_fixture_values.duck" ();

let score = 0;
let result = select_spawn_overrides(
  fixture_override_input(#None, #None, #Some "alpha", #None)
);
if let #SpawnOverrideSelected selection = result then
  if selection.model == "alpha" then
    if let #Some effort = selection.reasoning_effort then
      if effort == "high" then
        score = 1
      end;
    end;
  end;
end;

return { .score = score };
