module () where

const { .json_object, .json_object_empty, .merge_json } = import "duck:prelude/json" ();
const { .list, .path_parent, .text_append, .text_starts_with } =
  import "duck:prelude/functional" ();
const config_types_module = import "./config_types.duck";

type LayerTextOption = ConfigTextOption
type LayerJsonOption = ConfigJsonOption
type LayerSource = ConfigLayerSource
type Layer = ConfigLayer
type Layers = ConfigLayers
type LayerValidation = ConfigValidation
type LayerJson = Json

const layers = comptime list Layer;

const layer_precedence = (source: LayerSource) => if let #Mdm _ = source then
  0
else let #System _ = source then
  10
else let #EnterpriseManaged _ = source then
  15
else let #User user = source then
  let [_, profile] = user;

  if let #Some _ = profile then 21 else 20 end;
else let #Project _ = source then
  25
else let #SessionFlags = source then
  30
else let #LegacyFile _ = source then
  40
else
  50
end;

const layer_is_disabled = (layer: Layer) => do
  let [_, _, reason] = layer;

  if let #Some _ = reason then true else false end;
end;

const project_folder: LayerSource -> LayerTextOption =
  (source) => if let #Project folder = source then
    #Some folder
  else
    #None
  end;

const path_is_strict_descendant = (path: Text, ancestor: Text) => do
  if path == ancestor then
    false
  else ancestor == "/" then
    text_starts_with (path, "/")
  else
    text_starts_with (path, text_append (ancestor, "/"))
  end;
end;

const validate_layer_order: Layers -> LayerValidation = (values) => do
  let current = values;
  let previous_precedence = -1;
  let previous_project: LayerTextOption = #None;
  let validation: LayerValidation = #Valid;
  let done = false;

  loop do
    if let #Cons node = current then
      let [layer, tail] = node;
      let [source, _, _] = layer;
      let precedence = layer_precedence source;

      if precedence < previous_precedence then
        validation = #Invalid ("Config layers are not in precedence order")
        done = true
      else
        let folder = project_folder source;

        if let #Some current_folder = folder then
          if let #Some previous_folder = previous_project then
            let previous_root = path_parent previous_folder;

            if path_is_strict_descendant(current_folder, previous_root) then
              previous_project = #Some current_folder
            else
              validation = #Invalid ("Project config layers are not ordered from root to cwd")
              done = true
            end;
          else
            previous_project = #Some current_folder
          end;
        end;

        previous_precedence = precedence
        current = tail
      end;
    else
      done = true
    end;

    if done then
      break;
    end;
  end;

  validation
end;

const effective_config = (values: Layers) => do
  let current = values;
  let effective: LayerJson = json_object(json_object_empty());
  let done = false;

  loop do
    if let #Cons node = current then
      let [layer, tail] = node;
      let [_, config, _] = layer;

      if layer_is_disabled layer then
        ()
      else
        effective = merge_json(effective, config)
      end;

      current = tail
    else
      done = true
    end;

    if done then
      break;
    end;
  end;

  effective
end;

const effective_user_config: Layers -> LayerJsonOption = (values) => do
  let current = values;
  let effective: LayerJson = json_object(json_object_empty());
  let found = false;
  let done = false;

  loop do
    if let #Cons node = current then
      let [layer, tail] = node;
      let [source, config, _] = layer;

      if layer_is_disabled layer then
        ()
      else let #User _ = source then
        effective = merge_json(effective, config)
        found = true
      end;

      current = tail
    else
      done = true
    end;

    if done then
      break;
    end;
  end;

  if found then
    #Some effective
  else
    #None
  end;
end;

const active_user_file: Layers -> LayerTextOption = (values) => do
  let current = values;
  let file: LayerTextOption = #None;
  let done = false;

  loop do
    if let #Cons node = current then
      let [layer, tail] = node;
      let [source, _, _] = layer;

      if layer_is_disabled layer then
        ()
      else let #User user = source then
        let [path, _] = user;
        file = #Some path
      end;

      current = tail
    else
      done = true
    end;

    if done then
      break;
    end;
  end;

  file
end;

return {
  .layer_precedence,
  .layer_is_disabled,
  .validate_layer_order,
  .effective_config,
  .effective_user_config,
  .active_user_file,
};
