module () where

const {} = import "./mcp_resource_types.duck" ();
const { .plan_list_mcp_resource_call, .plan_read_mcp_resource_call } =
  import "./mcp_resource_call.duck" ();

let score = 0;

let list_all = plan_list_mcp_resource_call("call-1", #Function "{}", false, false);
if let #RunMcpResource prepared = list_all then
  if let #ListResources args = prepared.operation then
    if let #None = args.server then
      score = score + 1
    end;
  end;
end;

let cursor_without_server = plan_list_mcp_resource_call(
  "call-2",
  #Function "{\"cursor\":\"next\"}",
  true,
  false,
);
if let #RejectRequest message = cursor_without_server then
  if message == "cursor can only be used when a server is specified" then
    score = score + 10 end;
end;

let disabled_apps = plan_list_mcp_resource_call(
  "call-3",
  #Function "{\"server\":\" codex_apps \"}",
  false,
  false,
);
if let #RejectRequest message = disabled_apps then
  if message == "MCP server 'codex_apps' is disabled by `orchestrator.mcp.enabled`" then
    score = score + 100 end;
end;

let read = plan_read_mcp_resource_call(
  "call-4",
  #Function "{\"server\":\"docs\",\"uri\":\"skill://alpha\"}",
  false,
);
if let #RunMcpResource prepared = read then
  if let #ReadResource args = prepared.operation then
    if args.server == "docs" && args.uri == "skill://alpha" then
      score = score + 1000
    end;
  end;
end;

let missing_uri = plan_read_mcp_resource_call(
  "call-5",
  #Function "{\"server\":\"docs\",\"uri\":\"  \"}",
  false,
);
if let #RejectRequest message = missing_uri then
  if message == "failed to parse function arguments: uri must be provided" then
    score = score + 10000 end;
end;

return { .score = score };
