module () where

const { .parse_request_user_input_args } = import "./request_user_input_json.duck" ();

let parsed =
  parse_request_user_input_args "{\"questions\":[{\"id\":\"pick_one\",\"header\":\"Pick\",\"question\":\"Choose.\",\"isSecret\":true,\"options\":[{\"label\":\"A\",\"description\":\"First.\"},{\"label\":\"B\",\"description\":\"Second.\"}]}],\"autoResolutionMs\":18446744073709551615}";
let score = 0;

if let #Parsed args = parsed then
  if let #AutoResolutionAboveMaximum = args.auto_resolution then
    if let #Cons question_node = args.questions then
      let [question, question_tail] = question_node;
      if question.id == "pick_one" && question.header == "Pick" && question.question == "Choose."
        && !(
          question.is_other
        ) && question.is_secret then
          if let #Present options = question.options then
            if let #Cons option_node = options then
              let [first, option_tail] = option_node;
              if first.label == "A" && first.description == "First." then
                if let #Cons second_node = option_tail then
                  let [second, options_end] = second_node;
                  if second.label == "B" && second.description == "Second." then
                    if let #Nil = options_end then
                      if let #Nil = question_tail then
                        score = 1
                      end;
                    end;
                  end;
                end;
              end;
            end;
          end;
        end;
    end;
  end;
end;

return { .score = score };
