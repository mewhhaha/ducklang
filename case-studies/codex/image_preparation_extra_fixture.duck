module () where

const {} = import "./image_preparation_types.duck" ();
const { .apply_image_processing_results } = import "./image_preparation.duck" ();
const { .single_image_processing_fixture_result } =
  import "./image_preparation_failure_fixture_common.duck" ();

type ExtraFixtureResponses = HistoryItems

const verify_image_preparation_extra_fixture: () -> I32 = () => do
  let responses: ExtraFixtureResponses = #Nil;
  let results = single_image_processing_fixture_result(0, "data:image/png;base64,AA==");
  let rewrite = apply_image_processing_results(responses, results);
  if let #RejectedImageRewrite failure = rewrite then
    if let #ExtraImageProcessingResults count = failure then
      if count == 1 then 1 else 0 end;
    else
      0
    end;
  else
    0
  end;
end;

return { .verify_image_preparation_extra_fixture };
