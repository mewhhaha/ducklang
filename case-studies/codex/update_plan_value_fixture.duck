module () where

const {
  .json_array,
  .json_array_empty,
  .json_array_prepend,
  .json_null,
  .json_object,
  .json_object_empty,
  .json_object_prepend,
  .json_string,
} = import "duck:prelude/json/values" ();
const {} = import "./update_plan_types.duck" ();
const { .decode_update_plan_value } = import "./update_plan_value.duck" ();

type FixtureStepNode = UpdatePlanStepNode

let completed_fields = json_object_prepend(
  "step",
  json_string "test",
  json_object_prepend("status", json_string "completed", json_object_empty()),
);
let pending_fields = json_object_prepend(
  "status",
  json_string "pending",
  json_object_prepend("step", json_string "compile", json_object_empty()),
);
let valid_steps = json_array_prepend(
  json_object pending_fields,
  json_array_prepend(json_object completed_fields, json_array_empty()),
);
let valid_fields = json_object_prepend(
  "plan",
  json_array valid_steps,
  json_object_prepend("explanation", json_string "Keep this ordered", json_object_empty()),
);
let score = 0;

if let #Parsed args = decode_update_plan_value(json_object valid_fields) then
  if let #Some explanation = args.explanation then
    if explanation == "Keep this ordered" then
      if let #Cons first_node = args.plan then
        let typed_first_node: FixtureStepNode = first_node;
        let [first, tail] = typed_first_node;
        if first.step == "compile" then
          if let #Pending = first.status then
            if let #Cons second_node = tail then
              let typed_second_node: FixtureStepNode = second_node;
              let [second, finish] = typed_second_node;
              if second.step == "test" then
                if let #Completed = second.status then
                  if let #Nil = finish then
                    score = score + 1
                  end;
                end;
              end;
            end;
          end;
        end;
      end;
    end;
  end;
end;

let unknown_fields = json_object_prepend(
  "plan",
  json_array(json_array_empty()),
  json_object_prepend("extra", json_null(), json_object_empty()),
);
if let #ParseFailed message = decode_update_plan_value(json_object unknown_fields) then
  if message
    == "failed to parse function arguments: update_plan arguments contain an unknown field" then
      score = score + 10
    end;
end;

let duplicate_fields = json_object_prepend(
  "plan",
  json_array(json_array_empty()),
  json_object_prepend("plan", json_array(json_array_empty()), json_object_empty()),
);
if let #ParseFailed message = decode_update_plan_value(json_object duplicate_fields) then
  if message
    == "failed to parse function arguments: update_plan arguments contain a duplicate field" then
      score = score + 100
    end;
end;

let missing_fields = json_object_prepend("explanation", json_null(), json_object_empty());
if let #ParseFailed message = decode_update_plan_value(json_object missing_fields) then
  if message == "failed to parse function arguments: plan is required" then
    score = score + 1000 end;
end;

let invalid_status_fields = json_object_prepend(
  "step",
  json_string "compile",
  json_object_prepend("status", json_string "active", json_object_empty()),
);
let invalid_status_steps =
  json_array_prepend(json_object invalid_status_fields, json_array_empty());
let invalid_status_root = json_object_prepend(
  "plan",
  json_array invalid_status_steps,
  json_object_empty(),
);
if let #ParseFailed message = decode_update_plan_value(json_object invalid_status_root) then
  if message
    == "failed to parse function arguments: plan[0].status must be pending, in_progress, or completed" then
      score = score + 10000
    end;
end;

return { .score = score };
