module () where

const {} = import "./current_time_types.duck" ();
const { .plan_sleep_request } = import "./sleep_tool_policy.duck" ();

let score = 0;
if let #ValidSleep duration_ms = plan_sleep_request 43200000i64 then
  if duration_ms == 43200000i64 then
    score = score + 1
  end;
end;
if let #InvalidSleep message = plan_sleep_request 0i64 then
  if message == "duration_ms must be between 1 and 43200000" then
    score = score + 10
  end;
end;
if let #InvalidSleep message = plan_sleep_request - 1i64 then
  if message == "duration_ms must be between 1 and 43200000" then
    score = score + 100
  end;
end;
if let #InvalidSleep message = plan_sleep_request 43200001i64 then
  if message == "duration_ms must be between 1 and 43200000" then
    score = score + 1000
  end;
end;

return { .score = score };
