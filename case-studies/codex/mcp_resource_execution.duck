module (!init: Init) where

const {} = import "./mcp_resource_types.duck" ();
const { .bound_resource_output, .list_payload_json, .read_payload_json } =
  import "./mcp_resource_output.duck" ();

type ResourceExecutionEvent = McpResourceEvent
type ResourceExecutionHostRequest = McpResourceHostRequest
type ResourceExecutionHostResponse = McpResourceHostResponse
type ResourceExecutionPrepared = McpResourcePreparedCall
type ResourceExecutionResult = McpResourceExecutionResult
type ResourceExecutionTextResult = McpResourceTextResult

let run_mcp_resource = (
  prepared: ResourceExecutionPrepared,
  orchestrator_mcp_enabled: Bool,
  maximum_bytes: I32,
) => do
  let server = if let #ListResources args = prepared.operation then
    if let #Some name = args.server then name else "codex" end;
  else let #ListResourceTemplates args = prepared.operation then
    if let #Some name = args.server then name else "codex" end;
  else let #ReadResource args = prepared.operation then
    args.server
  else
    "codex"
  end;
  let tool = if let #ListResources _ = prepared.operation then
    "list_mcp_resources"
  else let #ListResourceTemplates _ = prepared.operation then
    "list_mcp_resource_templates"
  else let #ReadResource _ = prepared.operation then
    "read_mcp_resource"
  else
    "mcp_resource"
  end;
  let started: ResourceExecutionEvent = [
    .call_id = prepared.call_id,
    .server = server,
    .tool = tool,
    .completed = false,
    .success = true,
    .message = #None,
  ];
  _ <- McpResourceHost.event(&started)
  let request: ResourceExecutionHostRequest = [.operation = prepared.operation];
  response <- McpResourceHost.invoke(&request)
  let host_response: ResourceExecutionHostResponse = response;

  let output: ResourceExecutionTextResult = if let #Listed pages = host_response then
    list_payload_json(prepared.operation, pages, orchestrator_mcp_enabled)
  else let #Read document = host_response then
    read_payload_json(prepared.operation, document)
  else let #Failed reason = host_response then
    #ResourceFailed reason
  else
    #ResourceFailed "MCP resource host returned no result"
  end;

  if let #ResourceText text = output then
    let completed: ResourceExecutionEvent = [
      .call_id = prepared.call_id,
      .server = server,
      .tool = tool,
      .completed = true,
      .success = true,
      .message = #Some text,
    ];
    _ <- McpResourceHost.event(&completed)
    let result: ResourceExecutionResult = #Completed (bound_resource_output(text, maximum_bytes));
    result
  else let #ResourceFailed reason = output then
    let completed: ResourceExecutionEvent = [
      .call_id = prepared.call_id,
      .server = server,
      .tool = tool,
      .completed = true,
      .success = false,
      .message = #Some reason,
    ];
    _ <- McpResourceHost.event(&completed)
    let result: ResourceExecutionResult = #Rejected reason;
    result
  else
    let result: ResourceExecutionResult = #Rejected "MCP resource output produced no result";
    result
  end;
end;

return { .run_mcp_resource };
