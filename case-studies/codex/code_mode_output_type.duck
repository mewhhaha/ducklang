module () where

const { .json_object_get } = import "duck:prelude/json/values" ();
const { .text_append } = import "duck:prelude/runtime" ();
const { .render_json_schema_to_typescript } = import "./code_mode_schema_renderer.duck" ();

const object_has_type: [JsonObject, Text] -> Bool = (object, expected) => do
  if let #Found value = json_object_get("type", object) then
    if let #String actual = value then actual == expected else false end;
  else
    false
  end;
end;

const materialize_code_mode_output_type: Json -> Text = schema => do
  let fallback = render_json_schema_to_typescript schema;
  let #Object output_object = schema else do
    return fallback;
  end;
  let #Found properties_value =
    json_object_get("properties", output_object) else do
      return fallback;
    end;
  let #Object properties = properties_value else do
    return fallback;
  end;

  let #Found content_value = json_object_get("content", properties) else do
    return fallback;
  end;
  let #Object content = content_value else do
    return fallback;
  end;
  if !(object_has_type(content, "array")) then
    return fallback;
  end;
  let #Found content_items_value = json_object_get("items", content) else do
    return fallback;
  end;
  let #Object content_items = content_items_value else do
    return fallback;
  end;
  if !(object_has_type(content_items, "object")) then
    return fallback;
  end;

  let #Found error_value = json_object_get("isError", properties) else do
    return fallback;
  end;
  let #Object error_schema = error_value else do
    return fallback;
  end;
  if !(object_has_type(error_schema, "boolean")) then
    return fallback;
  end;

  let #Found meta_value = json_object_get("_meta", properties) else do
    return fallback;
  end;
  let #Object meta_schema = meta_value else do
    return fallback;
  end;
  if !(object_has_type(meta_schema, "object")) then
    return fallback;
  end;

  if let #Found structured = json_object_get("structuredContent", properties) then
    let structured_type = render_json_schema_to_typescript structured;
    if structured_type == "unknown" then
      "CallToolResult"
    else
      text_append [text_append ["CallToolResult<", structured_type], ">"]
    end;
  else
    "CallToolResult"
  end;
end;

return { .materialize_code_mode_output_type };
