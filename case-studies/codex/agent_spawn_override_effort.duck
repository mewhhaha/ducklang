module () where

const { .text_append } = import "duck:prelude/runtime" ();
const {} = import "./agent_spawn_override_types.duck" ();

type SpawnOverrideEffortCatalog = AgentSpawnOverrideEfforts
type SpawnOverrideEffortStageSelection = AgentSpawnOverrideSelection
type SpawnOverrideEffortTextOption = AgentTextOption

const select_spawn_override_effort: AgentSpawnOverrideEffortInput -> AgentSpawnOverrideResult =
  input => do
    let selected_effort: SpawnOverrideEffortTextOption = input.default_reasoning_effort;
    if let #Some requested = input.requested_reasoning_effort then
      selected_effort = #Some requested
    end;
    if let #None = selected_effort then
      selected_effort = input.model.default_reasoning_effort
    end;

    if let #Some requested_effort = selected_effort then
      let supported = false;
      let efforts: SpawnOverrideEffortCatalog = input.model.supported_reasoning_efforts;
      let available = "";
      let done = false;
      loop do
        if let #Cons node = efforts then
          let [effort, tail] = node;
          if effort == requested_effort then
            supported = true
          end;
          if available == "" then
            available = effort
          else
            available = text_append(
              available,
              text_append(", ", effort),
            ) end;
          efforts = tail
        else
          done = true
        end;
        if supported || done then
          break;
        end;
      end;

      if !(supported) then
        return #SpawnOverrideRejected (
          text_append(
            "Reasoning effort `",
            text_append(
              requested_effort,
              text_append(
                "` is not supported for model `",
                text_append(
                  input.model.model,
                  text_append("`. Supported reasoning efforts: ", available),
                ),
              ),
            ),
          )
        );
      end;
    end;

    let selection: SpawnOverrideEffortStageSelection = [
      .model = input.model.model,
      .reasoning_effort = selected_effort,
    ];
    #SpawnOverrideSelected selection
  end;

return { .select_spawn_override_effort };
