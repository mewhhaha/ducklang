module () where

const { .encode_json_string } = import "duck:prelude/json/encode" ();
const { .text_append } = import "duck:prelude/runtime" ();
const {} = import "./view_image_types.duck" ();

type ImageOutputDetail = ViewImageDetail
type ImageOutputValue = ViewImageOutput

const view_image_detail_text: ImageOutputDetail -> Text = detail => do
  if let #Original = detail then "original" else "high" end;
end;

let view_image_output_json: ImageOutputValue -> Text = output => do
  text_append [
    "{\"image_url\":",
    text_append [
      encode_json_string output.image_url,
      text_append [
        ",\"detail\":",
        text_append [encode_json_string(view_image_detail_text output.detail), "}"],
      ],
    ],
  ]
end;

return {
  .view_image_detail_text,
  .view_image_output_json,
};
