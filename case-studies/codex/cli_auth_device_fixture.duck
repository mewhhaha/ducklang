module () where

const { .parse_login_options } = import "./cli_auth.duck" ();
const {} = import "./cli_types.duck" ();

type FixtureArgs = CodexCliArgs
type FixtureNode = ListNode Text
type FixtureLoginResult = CodexLoginActionResult

const prepend = (value: Text, values: FixtureArgs) => do
  let node: FixtureNode = [value, values];
  let result: FixtureArgs = #Cons node;
  result
end;

let empty: FixtureArgs = #Nil;
let args = prepend(
  "--device-auth",
  prepend(
    "--experimental_issuer",
    prepend(
      "https://issuer.example",
      prepend("--experimental-client-id", prepend("client-1", empty)),
    ),
  ),
);
let parsed: FixtureLoginResult = parse_login_options args;
let score = 0;

if let #Ok action = parsed then
  if let #DeviceLogin options = action then
    if let #Some issuer = options.issuer_base_url then
      if let #Some client_id = options.client_id then
        if issuer == "https://issuer.example" && client_id == "client-1" then
          score = 1
        end;
      end;
    end;
  end;
end;

return { .score = score };
