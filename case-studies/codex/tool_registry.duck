module () where

const { .text_append } = import "duck:prelude/functional" ();
const tool_types_module = import "./tool_types.duck";

type RegistryName = ToolName
type RegistryExposure = ToolExposure
type RegistryPayloadKind = ToolPayloadKind
type RegistryHandler = ToolHandler
type RegistryDefinition = ToolDefinition
type RegistryDefinitions = ToolDefinitions
type RegistryRegistrationResult = ToolRegistrationResult
type RegistryLookup = ToolLookup
type RegistryDispatch = ToolDispatch
type RegistryDispatchPlan = ToolDispatchPlan

const empty_registry: () -> RegistryDefinitions = () => #Nil;

const prepend_definition: [RegistryDefinition, RegistryDefinitions] -> RegistryDefinitions = (
  definition: RegistryDefinition,
  registry: RegistryDefinitions,
) => do
  #Cons ([definition, registry])
end;

const reverse_definitions: RegistryDefinitions -> RegistryDefinitions = (
  registry: RegistryDefinitions) => do
    let current = registry;
    let reversed: RegistryDefinitions = empty_registry();
    let done = false;

    loop do
      if let #Cons node = current then
        let [definition, tail] = node;
        reversed = prepend_definition(definition, reversed)
        current = tail
      else
        done = true
      end;

      if done then
        break;
      end;
    end;

    reversed
  end;

const registry_count = (registry: RegistryDefinitions) => do
  let current = registry;
  let count = 0;
  let done = false;

  loop do
    if let #Cons node = current then
      let [_, tail] = node;
      count = count + 1
      current = tail
    else
      done = true
    end;

    if done then
      break;
    end;
  end;

  count
end;

const tool_name_equal = (left: RegistryName, right: RegistryName) => do
  let [left_namespace, left_name] = left;
  let [right_namespace, right_name] = right;
  left_namespace == right_namespace && left_name == right_name
end;

const tool_name_text = (name: RegistryName) => do
  let [namespace, local_name] = name;

  if namespace != "" then
    text_append [namespace, local_name]
  else
    local_name
  end;
end;

const definition_name = (definition: RegistryDefinition) => do
  let [name, _, _, _, _, _] = definition;
  name
end;

let rec find_tool: [RegistryDefinitions, RegistryName] -> RegistryLookup = (
  registry: RegistryDefinitions,
  name: RegistryName,
) => do
  if let #Cons node = registry then
    let [definition, tail] = node;

    if tool_name_equal(definition_name definition, name) then
      #Found definition
    else
      find_tool(tail, name)
    end;
  else
    #Missing name
  end;
end;

const contains_tool = (registry: RegistryDefinitions, name: RegistryName) => do
  let current = registry;
  let found = false;
  let done = false;

  loop do
    if let #Cons node = current then
      let [definition, tail] = node;

      if tool_name_equal(definition_name definition, name) then
        found = true
        done = true
      else
        current = tail
      end;
    else
      done = true
    end;

    if done then
      break;
    end;
  end;

  found
end;

const register_tool: [RegistryDefinitions, RegistryDefinition] -> RegistryRegistrationResult = (
  registry: RegistryDefinitions,
  definition: RegistryDefinition,
) => do
  let name = definition_name definition;

  if contains_tool(registry, name) then
    #Duplicate name
  else
    #Registered (prepend_definition(definition, registry))
  end;
end;

const exposure_is_direct = (exposure: RegistryExposure) => do
  if let #Direct = exposure then
    true
  else let #DirectModelOnly = exposure then
    true
  else
    false
  end;
end;

const exposure_is_deferred = (exposure: RegistryExposure) => do
  if let #Deferred = exposure then true else false end;
end;

const model_visible_tools: RegistryDefinitions -> RegistryDefinitions = (
  registry: RegistryDefinitions) => do
    let current = registry;
    let visible: RegistryDefinitions = empty_registry();
    let done = false;

    loop do
      if let #Cons node = current then
        let [definition, tail] = node;
        let [_, exposure, _, _, _, _] = definition;

        if exposure_is_direct exposure then
          visible = prepend_definition(definition, visible)
        end;

        current = tail
      else
        done = true
      end;

      if done then
        break;
      end;
    end;

    reverse_definitions visible
  end;

const deferred_tools: RegistryDefinitions -> RegistryDefinitions =
  (registry: RegistryDefinitions) => do
    let current = registry;
    let deferred: RegistryDefinitions = empty_registry();
    let done = false;

    loop do
      if let #Cons node = current then
        let [definition, tail] = node;
        let [_, exposure, _, _, _, _] = definition;

        if exposure_is_deferred exposure then
          deferred = prepend_definition(definition, deferred)
        end;

        current = tail
      else
        done = true
      end;

      if done then
        break;
      end;
    end;

    reverse_definitions deferred
  end;

const payload_kinds_match = (expected: RegistryPayloadKind, received: RegistryPayloadKind) => do
  if let #FunctionPayload = expected then
    if let #FunctionPayload = received then true else false end;
  else let #ToolSearchPayload = expected then
    if let #ToolSearchPayload = received then true else false end;
  else let #CustomPayload = received then
    true
  else
    false
  end;
end;

const plan_tool_dispatch: [RegistryDefinitions, RegistryName, RegistryPayloadKind, Text] -> RegistryDispatchPlan =
  (
    registry: RegistryDefinitions,
    name: RegistryName,
    payload: RegistryPayloadKind,
    input: Text,
  ) => do
    let found: RegistryLookup = find_tool(registry, name);

    if let #Found definition = found then
      let [_, _, runtime, expected_payload, _, _] = definition;

      if payload_kinds_match(expected_payload, payload) then
        let dispatch: RegistryDispatch = [runtime, payload, input];
        #Execute dispatch;
      else
        #Incompatible ("Tool " <> tool_name_text name <> " received an incompatible payload")
      end;
    else
      #Unsupported ("Unsupported tool " <> tool_name_text name)
    end;
  end;

const tool_supports_parallel = (registry: RegistryDefinitions, name: RegistryName) => do
  let found: RegistryLookup = find_tool(registry, name);

  if let #Found definition = found then
    let [_, exposure, _, _, supports_parallel, _] = definition;

    if let #Hidden = exposure then
      false
    else
      supports_parallel
    end;
  else
    false
  end;
end;

const tool_waits_for_cancellation = (registry: RegistryDefinitions, name: RegistryName) => do
  let found: RegistryLookup = find_tool(registry, name);

  if let #Found definition = found then
    let [_, _, _, _, _, waits] = definition;
    waits
  else
    false
  end;
end;

return {
  .empty_registry,
  .registry_count,
  .tool_name_equal,
  .tool_name_text,
  .find_tool,
  .register_tool,
  .model_visible_tools,
  .deferred_tools,
  .plan_tool_dispatch,
  .tool_supports_parallel,
  .tool_waits_for_cancellation,
};
