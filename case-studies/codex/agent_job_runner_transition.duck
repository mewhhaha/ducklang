module () where

const { .text_append } = import "duck:prelude/runtime" ();
const {} = import "./agent_job_runner_types.duck" ();

type AgentJobTransitionActive = AgentJobActiveWorkers
type AgentJobTransitionActiveNode = AgentJobActiveWorkerNode
type AgentJobTransitionActiveWorker = AgentJobActiveWorker
type AgentJobTransitionCompletion = AgentJobWorkerCompletion
type AgentJobTransitionOutcome = AgentJobSpawnOutcome
type AgentJobTransitionState = AgentJobRunnerState
type AgentJobTransitionValue = AgentJobRunnerTransition

const apply_agent_job_spawn: [AgentJobTransitionState, AgentJobTransitionOutcome] ->
  AgentJobTransitionValue = (
    state: AgentJobTransitionState,
    outcome: AgentJobTransitionOutcome,
  ) => do
    if let #Cons pending_node = state.pending then
      let [item, remaining] = pending_node;
      if let #WorkerSpawned thread_id = outcome then
        let worker: AgentJobTransitionActiveWorker = [
          .item_id = item.item_id,
          .thread_id = thread_id,
        ];
        let active_node: AgentJobTransitionActiveNode = [worker, state.active];
        let next: AgentJobTransitionState = [
          .pending = remaining,
          .active = #Cons active_node,
          .total_items = state.total_items,
          .completed_items = state.completed_items,
          .failed_items = state.failed_items,
          .spawn_blocked = false,
          .cancelled = state.cancelled,
        ];
        #RunnerAdvanced next
      else let #WorkerSpawnDeferred = outcome then
        let next: AgentJobTransitionState = [
          .pending = state.pending,
          .active = state.active,
          .total_items = state.total_items,
          .completed_items = state.completed_items,
          .failed_items = state.failed_items,
          .spawn_blocked = true,
          .cancelled = state.cancelled,
        ];
        #RunnerAdvanced next
      else let #WorkerSpawnFailed _ = outcome then
        let next: AgentJobTransitionState = [
          .pending = remaining,
          .active = state.active,
          .total_items = state.total_items,
          .completed_items = state.completed_items,
          .failed_items = state.failed_items + 1,
          .spawn_blocked = false,
          .cancelled = state.cancelled,
        ];
        #RunnerAdvanced next
      else
        #RunnerInvariantFailed "agent job spawn returned no outcome"
      end;
    else
      #RunnerInvariantFailed "agent job spawn completed without a pending item"
    end;
  end;

const apply_agent_job_completion: [AgentJobTransitionState, AgentJobTransitionCompletion] ->
  AgentJobTransitionValue = (
    state: AgentJobTransitionState,
    completion: AgentJobTransitionCompletion,
  ) => do
    let current = state.active;
    let remaining_reversed: AgentJobTransitionActive = #Nil;
    let found = false;
    let done = false;
    loop do
      if let #Cons node = current then
        let [worker, tail] = node;
        if worker.thread_id == completion.thread_id then
          found = true
        else
          let kept_node: AgentJobTransitionActiveNode = [worker, remaining_reversed];
          remaining_reversed = #Cons kept_node
        end;
        current = tail
      else
        done = true
      end;
      if done then
        break;
      end;
    end;
    if !(found) then
      #RunnerInvariantFailed (
        text_append ["agent job completion referenced inactive worker ", completion.thread_id]
      )
    else
      let remaining: AgentJobTransitionActive = #Nil;
      done = false
      loop do
        if let #Cons node = remaining_reversed then
          let [worker, tail] = node;
          let kept_node: AgentJobTransitionActiveNode = [worker, remaining];
          remaining = #Cons kept_node
          remaining_reversed = tail
        else
          done = true
        end;
        if done then
          break;
        end;
      end;
      if completion.reported then
        let next: AgentJobTransitionState = [
          .pending = state.pending,
          .active = remaining,
          .total_items = state.total_items,
          .completed_items = state.completed_items + 1,
          .failed_items = state.failed_items,
          .spawn_blocked = false,
          .cancelled = state.cancelled || completion.cancel_requested,
        ];
        #RunnerAdvanced next
      else
        let next: AgentJobTransitionState = [
          .pending = state.pending,
          .active = remaining,
          .total_items = state.total_items,
          .completed_items = state.completed_items,
          .failed_items = state.failed_items + 1,
          .spawn_blocked = false,
          .cancelled = state.cancelled || completion.cancel_requested,
        ];
        #RunnerAdvanced next
      end;
    end;
  end;

return {
  .apply_agent_job_completion,
  .apply_agent_job_spawn,
};
