module () where

const {} = import "./tool_types.duck" ();
const { .request_plugin_install_definitions } =
  import "./request_plugin_install_registration.duck" ();

type FixtureDefinitions = ToolDefinitions

let score = 0;
let disabled: FixtureDefinitions = request_plugin_install_definitions(false, true);
let empty: FixtureDefinitions = request_plugin_install_definitions(true, false);
if let #Nil = disabled then
  if let #Nil = empty then
    score = score + 1
  end;
end;

let definitions: FixtureDefinitions = request_plugin_install_definitions(true, true);
if let #Cons node = definitions then
  let [definition, tail] = node;
  let [name, exposure, tool_handler, payload, parallel, waits] = definition;
  let [namespace, local_name] = name;
  if namespace == "" && local_name == "request_plugin_install" && !(parallel) && !(waits) then
    if let #Direct = exposure then
      if let #RequestPluginInstall = tool_handler then
        if let #FunctionPayload = payload then
          if let #Nil = tail then
            score = score + 10
          end;
        end;
      end;
    end;
  end;
end;

return { .score = score };
