module () where

const { .encode_json_string } = import "duck:prelude/json/encode" ();
const { .text_truncate_middle_tokens } = import "duck:prelude/functional" ();
const agent_types_module = import "./agent_types.duck";

type SessionPrefixStatus = AgentStatus
type SessionPrefixTextOption = AgentTextOption

const error_next_action =
  "This agent's turn failed. If you still need this agent, use the available collaboration tools to give it another task.";

let agent_status_json: SessionPrefixStatus -> Text = status => do
  if let #PendingInit = status then
    "\"pending_init\""
  else let #Running = status then
    "\"running\""
  else let #Interrupted = status then
    "\"interrupted\""
  else let #Completed message = status then
    let value = if let #Some text = message then encode_json_string text else "null" end;
    "{\"completed\":" <> value <> "}"
  else let #Errored error = status then
    "{\"errored\":" <> encode_json_string error <> "}"
  else let #Shutdown = status then
    "\"shutdown\""
  else
    "\"not_found\""
  end;
end;

let format_subagent_notification_message =
  (agent_reference: Text, status: SessionPrefixStatus) => do
    "<subagent_notification>\n{\"agent_path\":" <> encode_json_string agent_reference
      <> ",\"status\":" <> agent_status_json status <> "}\n</subagent_notification>"
  end;

let format_inter_agent_completion_message: [Text, Text, SessionPrefixStatus] ->
  SessionPrefixTextOption = (
    task_name: Text,
    sender: Text,
    status: SessionPrefixStatus,
  ) => do
    let payload: SessionPrefixTextOption = if let #Completed message = status then
      if let #Some text = message then #Some text else #Some "" end;
    else let #Errored error = status then
      let truncated = text_truncate_middle_tokens(error, 900);
      #Some ("Agent errored: " <> truncated <> "\n\n" <> error_next_action)
    else let #Shutdown = status then
      #Some "Agent shut down."
    else let #NotFound = status then
      #Some "Agent was not found."
    else
      #None
    end;

    let completion: SessionPrefixTextOption = if let #Some message = payload then
      #Some (
        "Message Type: FINAL_ANSWER\nTask name: " <> task_name <> "\nSender: " <> sender
        <> "\nPayload:\n" <> message
      )
    else
      #None
    end;

    completion
  end;

let format_subagent_context_line = (agent_reference: Text, nickname: SessionPrefixTextOption) => do
  if let #Some value = nickname then
    if value == "" then "- " <> agent_reference else "- " <> agent_reference <> ": " <> value end;
  else
    "- " <> agent_reference
  end;
end;

return {
  .agent_status_json,
  .format_subagent_notification_message,
  .format_inter_agent_completion_message,
  .format_subagent_context_line,
};
