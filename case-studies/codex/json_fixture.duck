const { .parse_json } = import "duck:prelude/json" ();
const { .text_length } = import "duck:prelude/runtime" ();

let document =
  "{\"type\":\"function_call\",\"arguments\":\"{\\\"path\\\":\\\"README.md\\\"}\",\"flags\":[true,false,null],\"number\":-12.5e+2}";
let parsed = parse_json(document, 0);

if let #Ok value_and_index = parsed then
  let [value, index] = value_and_index;
  let score = if index == text_length document then 10000 else 0 end;

  if let #Object members = value then
    let current = members;
    let done = false;

    loop do
      if let #Cons node = current then
        let [member, tail] = node;
        let [key, member_value] = member;

        if key == "type" then
          if let #String text = member_value then
            if text == "function_call" then
              score = score + 1
            end;
          end;
        else key == "arguments" then
          if let #String text = member_value then
            if text == "{\"path\":\"README.md\"}" then
              score = score + 10
            end;
          end;
        else key == "flags" then
          if let #Array values = member_value then
            let flags = values;
            let flag_score = 0;
            let flag_index = 0;
            let flags_done = false;

            loop do
              if let #Cons flag_node = flags then
                let [flag, tail_flags] = flag_node;

                if flag_index == 0 then
                  if let #Bool true = flag then
                    flag_score = flag_score + 1
                  end;
                else flag_index == 1 then
                  if let #Bool false = flag then
                    flag_score = flag_score + 2
                  end;
                else flag_index == 2 then
                  if let #Null = flag then
                    flag_score = flag_score + 3
                  end;
                end;

                flags = tail_flags
                flag_index = flag_index + 1
              else
                flags_done = true
              end;

              if flags_done then
                break;
              end;
            end;

            if flag_score == 6 && flag_index == 3 then
              score = score + 100
            end;
          end;
        else key == "number" then
          if let #Number number = member_value then
            if number == "-12.5e+2" then
              score = score + 1000
            end;
          end;
        end;

        current = tail
      else
        done = true
      end;

      if done then
        break;
      end;
    end;

    score
  else -1
  end;
else -2
end;
