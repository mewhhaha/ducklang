module () where

const {
  .list,
  .text_append,
  .text_collapse_ascii_whitespace,
  .text_contains_ascii_case_insensitive,
  .text_find_from,
  .text_get,
  .text_length,
  .text_slice,
  .text_starts_with,
  .text_trim_ascii_whitespace,
} = import "duck:prelude/functional" ();
const skill_types_module = import "./skill_types.duck";

type MetadataTextOption = SkillTextOption
type MetadataBoolOption = SkillBoolOption
type MetadataTexts = SkillTexts
type MetadataProduct = SkillProduct
type MetadataProductOption = SkillProductOption
type MetadataPolicy = SkillPolicy

const texts = comptime list Text;

const append_text = (left: Text, right: Text) => text_append (left, right);

const unquote_yaml_scalar = (value: Text) => do
  let trimmed = text_trim_ascii_whitespace value;

  if text_length trimmed >= 2 then
    let first = text_get (trimmed, 0);
    let last = text_get (trimmed, text_length trimmed - 1);

    if first == last && (first == 34 || first == 39) then
      trimmed = text_slice (trimmed, 1, text_length trimmed - 1)
    end;
  end;

  text_collapse_ascii_whitespace trimmed
end;

let rec yaml_scalar_from: (Text, Text, I32) -> MetadataTextOption = (
  yaml: Text,
  key: Text,
  start: I32,
) => do
  if start >= text_length yaml then
    #None
  else
    let newline = text_find_from (yaml, "\n", start);
    let line_end = if newline < 0 then text_length yaml else newline end;
    let line = text_trim_ascii_whitespace(text_slice (yaml, start, line_end));
    let prefix = append_text(key, ":");

    if text_starts_with (line, prefix) then
      let value = unquote_yaml_scalar(text_slice (line, text_length prefix, text_length line));
      if value == "" then #None else #Some value end;
    else newline < 0 then
      #None
    else
      yaml_scalar_from(yaml, key, newline + 1)
    end;
  end;
end;

const yaml_scalar = (yaml: Text, key: Text) => yaml_scalar_from(yaml, key, 0);

const frontmatter = (contents: Text) => do
  if text_starts_with (contents, "---\n") then
    let closing = text_find_from (contents, "\n---", 4);
    if closing >= 0 then #Some (text_slice (contents, 4, closing)) else #None end;
  else
    #None
  end;
end;

const product_name = (product: MetadataProduct) => do
  if let #Chatgpt = product then
    "chatgpt"
  else let #Codex = product then
    "codex"
  else
    "atlas"
  end;
end;

let rec yaml_inline_list_contains_from: (Text, Text, I32) -> Bool = (
  value: Text,
  expected: Text,
  start: I32,
) => do
  let comma = text_find_from (value, ",", start);
  let entry_end = if comma < 0 then text_length value else comma end;
  let candidate = unquote_yaml_scalar(text_slice (value, start, entry_end));

  if text_contains_ascii_case_insensitive(candidate,
    expected) && text_length candidate == text_length expected then
      true
    else comma < 0 then
      false
    else
      yaml_inline_list_contains_from(value, expected, comma + 1)
    end;
end;

const yaml_inline_list_contains = (value: Text, expected: Text) => do
  let trimmed = text_trim_ascii_whitespace value;
  let normalized = if text_length trimmed >= 2 && text_get (trimmed, 0) == 91 && text_get (
    trimmed,
    text_length trimmed - 1,
  ) == 93 then
    text_slice (trimmed, 1, text_length trimmed - 1)
  else
    trimmed
  end;

  yaml_inline_list_contains_from(normalized, expected, 0)
end;

const parse_skill_policy = (metadata_yaml: MetadataTextOption) => do
  let implicit: MetadataBoolOption = if let #Some yaml = metadata_yaml then
    if let #Some value = yaml_scalar(yaml, "allow_implicit_invocation") then
      if value == "true" then
        #Some true
      else value == "false" then
        #Some false
      else
        #None
      end;
    else
      #None
    end;
  else
    #None
  end;

  let products: MetadataTexts = if let #Some yaml = metadata_yaml then
    if let #Some value = yaml_scalar(yaml, "products") then
      let found: MetadataTexts = texts.empty();

      if yaml_inline_list_contains(value, "chatgpt") then
        found = texts.prepend("chatgpt", found)
      end;

      if yaml_inline_list_contains(value, "codex") then
        found = texts.prepend("codex", found)
      end;

      if yaml_inline_list_contains(value, "atlas") then
        found = texts.prepend("atlas", found)
      end;

      texts.reverse found
    else
      texts.empty()
    end;
  else
    texts.empty()
  end;

  [implicit, products] as MetadataPolicy
end;

const policy_allows_product = (policy: MetadataPolicy, product: MetadataProductOption) => do
  let [_, restricted_products] = policy;

  if texts.length(restricted_products) == 0 then
    true
  else let #Some requested = product then
    let current = restricted_products;
    let expected = product_name requested;
    let allowed = false;
    let done = false;

    loop do
      if let #Cons node = current then
        let [candidate, tail] = node;

        if candidate == expected then
          allowed = true
          done = true
        else
          current = tail
        end;
      else
        done = true
      end;

      if done then
        break;
      end;
    end;

    allowed
  else
    false
  end;
end;

const policy_allows_implicit_invocation = (policy: MetadataPolicy) => do
  let [allowed, _] = policy;
  if let #Some value = allowed then value else true end;
end;

return {
  .frontmatter,
  .yaml_scalar,
  .parse_skill_policy,
  .policy_allows_product,
  .policy_allows_implicit_invocation,
};
