module () where

const { .parse_interrupt_agent_args } = import "./agent_tool_target_json.duck" ();

let decoded = parse_interrupt_agent_args "{\"target\":\"reviewer\"}";
let score = 0;
if let #AgentTargetDecoded target = decoded then
  if target == "reviewer" then
    score = 1
  end;
end;

return { .score = score };
