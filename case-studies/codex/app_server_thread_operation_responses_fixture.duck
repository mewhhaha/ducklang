module () where

const { .json_object, .json_object_empty, .json_object_get, .json_object_prepend, .json_string } =
  import "duck:prelude/json" ();
const {
  .materialize_empty_thread_response,
  .materialize_thread_id_notification,
  .materialize_thread_unarchive_response,
} = import "./app_server_thread_responses.duck" ();

let empty_score = if let #Object _ = materialize_empty_thread_response() then 1 else 0 end;
let thread = json_object(json_object_prepend("id", json_string "thread-1", json_object_empty()));
let unarchive_score = if let #Object fields = materialize_thread_unarchive_response thread then
  if let #Found _ = json_object_get("thread", fields) then 10 else 0 end;
else 0 end;
let notification_score = if let #Object fields = materialize_thread_id_notification "thread-1" then
  if let #Found value = json_object_get("threadId", fields) then
    if let #String id = value then
      if id == "thread-1" then 100 else 0 end;
    else 0 end;
  else 0 end;
else 0 end;

return { .score = empty_score + unarchive_score + notification_score };
