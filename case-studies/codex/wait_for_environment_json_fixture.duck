module () where

const { .parse_wait_for_environment_args } = import "./wait_for_environment_json.duck" ();

let score = 0;
if let #Parsed args = parse_wait_for_environment_args "{\"environment_id\":\"gpu\"}" then
  if args.environment_id == "gpu" then
    score = score + 1
  end;
end;
if let #ParseFailed message = parse_wait_for_environment_args "{}" then
  if message == "failed to parse function arguments: environment_id is required" then
    score = score + 10 end;
end;
if let #ParseFailed message = parse_wait_for_environment_args "[]" then
  if message
    == "failed to parse function arguments: wait_for_environment arguments must be an object" then
      score = score + 100
    end;
end;

return { .score = score };
