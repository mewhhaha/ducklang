module () where

const { .json_object_get } = import "duck:prelude/json" ();
const { .text_trim_ascii_whitespace } = import "duck:prelude/functional" ();
const { .unsafe_i32_wrap_i64 } = import "duck:prelude/numeric" ();
const { .parse_u32_decimal } = import "duck:prelude/numeric/parse" ();
const {} = import "./app_server_types.duck" ();

type ThreadMethodJson = AppServerJson
type ThreadMethodJsonObject = JsonObject
type ThreadMethodJsonLookup = JsonLookupResult
type ThreadMethodTextOption = AppServerTextOption
type ThreadMethodBoolOption = AppServerBoolOption
type ThreadMethodJsonOption = AppServerJsonOption
type ThreadMethodHistoryMode = AppServerThreadHistoryMode
type ThreadMethodHistoryModeOption = AppServerThreadHistoryModeOption
type ThreadMethodStartSource = AppServerThreadStartSource
type ThreadMethodStartSourceOption = AppServerThreadStartSourceOption
type ThreadMethodAllowFallback = AppServerAllowProviderFallback
type ThreadMethodRawEvents = AppServerExperimentalRawEvents
type ThreadMethodExcludeTurns = AppServerExcludeTurns
type ThreadMethodThreadPersistence = AppServerThreadPersistence
type ThreadMethodGoalContinuation = AppServerGoalContinuation
type ThreadMethodStartParams = AppServerThreadStartParams
type ThreadMethodResumeParams = AppServerThreadResumeParams
type ThreadMethodForkParams = AppServerThreadForkParams
type ThreadMethodMetadataGitInfoPatch = AppServerThreadMetadataGitInfoPatch
type ThreadMethodMetadataUpdateParams = AppServerThreadMetadataUpdateParams
type ThreadMethodSettingsUpdateParams = AppServerThreadSettingsUpdateParams
type ThreadMethodTurnsListParams = AppServerThreadTurnsListParams
type ThreadMethodItemsListParams = AppServerThreadItemsListParams
type ThreadMethodSortDirection = AppServerSortDirection
type ThreadMethodItemsView = AppServerTurnItemsView
type ThreadMethodDecodeResult = AppServerMethodDecodeResult
type ThreadMethodTextResult = Result Text Text
type ThreadMethodTextOptionResult = Result Text ThreadMethodTextOption
type ThreadMethodBoolOptionResult = Result Text ThreadMethodBoolOption
type ThreadMethodJsonOptionResult = Result Text ThreadMethodJsonOption
type ThreadMethodHistoryModeResult = Result Text ThreadMethodHistoryModeOption
type ThreadMethodStartSourceResult = Result Text ThreadMethodStartSourceOption
type ThreadMethodAllowFallbackResult = Result Text ThreadMethodAllowFallback
type ThreadMethodRawEventsResult = Result Text ThreadMethodRawEvents
type ThreadMethodExcludeTurnsResult = Result Text ThreadMethodExcludeTurns
type ThreadMethodThreadPersistenceResult = Result Text ThreadMethodThreadPersistence
type ThreadMethodGoalContinuationResult = Result Text ThreadMethodGoalContinuation
type ThreadMethodTextPatch = FieldPatch Text
type ThreadMethodTextPatchResult = Result Text ThreadMethodTextPatch
type ThreadMethodPageSizeResult = Result Text I32
type ThreadMethodSortDirectionResult = Result Text ThreadMethodSortDirection
type ThreadMethodItemsViewResult = Result Text ThreadMethodItemsView

const optional_text: (ThreadMethodJsonObject, Text, Text) -> ThreadMethodTextOptionResult = (
  object: ThreadMethodJsonObject,
  key: Text,
  context: Text,
) => do
  let lookup: ThreadMethodJsonLookup = json_object_get(key, object);

  if let #Found value = lookup then
    if let #Null = value then
      #Ok (#None)
    else let #String text = value then
      #Ok (#Some text)
    else
      #Err (context <> "." <> key <> " must be a string or null")
    end;
  else
    #Ok (#None)
  end;
end;

const required_text: (ThreadMethodJsonObject, Text, Text) -> ThreadMethodTextResult = (
  object: ThreadMethodJsonObject,
  key: Text,
  context: Text,
) => do
  let decoded = optional_text(object, key, context);

  if let #Err reason = decoded then
    #Err reason
  else let #Ok value = decoded then
    if let #Some text = value then
      #Ok text
    else
      #Err (context <> "." <> key <> " is required")
    end;
  else
    #Err (context <> "." <> key <> " could not be decoded")
  end;
end;

const optional_path: (ThreadMethodJsonObject, Text) -> ThreadMethodTextOptionResult = (
  object: ThreadMethodJsonObject,
  context: Text,
) => do
  let decoded = optional_text(object, "path", context);

  if let #Ok value = decoded then
    if let #Some path = value then
      if path == "" then #Ok (#None) else #Ok value end;
    else
      #Ok value
    end;
  else let #Err reason = decoded then
    #Err reason
  else
    #Err (context <> ".path could not be decoded")
  end;
end;

const optional_bool: (ThreadMethodJsonObject, Text, Text) -> ThreadMethodBoolOptionResult = (
  object: ThreadMethodJsonObject,
  key: Text,
  context: Text,
) => do
  let lookup: ThreadMethodJsonLookup = json_object_get(key, object);

  if let #Found value = lookup then
    if let #Null = value then
      #Ok (#None)
    else let #Bool boolean = value then
      #Ok (#Some boolean)
    else
      #Err (context <> "." <> key <> " must be a boolean or null")
    end;
  else
    #Ok (#None)
  end;
end;

const optional_json_kind: (ThreadMethodJsonObject, Text, Text, Text) -> ThreadMethodJsonOptionResult =
  (
    object: ThreadMethodJsonObject,
    key: Text,
    context: Text,
    kind: Text,
  ) => do
    let lookup: ThreadMethodJsonLookup = json_object_get(key, object);

    if let #Found value = lookup then
      if let #Null = value then
        #Ok (#None)
      else kind == "array" then
        if let #Array _ = value then #Ok (#Some value) else #Err (
          context <> "." <> key <> " must be an array or null"
        ) end;
      else
        if let #Object _ = value then #Ok (#Some value) else #Err (
          context <> "." <> key <> " must be an object or null"
        ) end;
      end;
    else
      #Ok (#None)
    end;
  end;

const optional_json: (ThreadMethodJsonObject, Text) -> ThreadMethodJsonOption = (
  object: ThreadMethodJsonObject,
  key: Text,
) => do
  let lookup: ThreadMethodJsonLookup = json_object_get(key, object);

  if let #Found value = lookup then
    if let #Null = value then #None else #Some value end;
  else
    #None
  end;
end;

const json_field_is_present: (ThreadMethodJsonObject, Text) -> Bool = (
  object: ThreadMethodJsonObject,
  key: Text,
) => do
  let lookup: ThreadMethodJsonLookup = json_object_get(key, object);
  if let #Found _ = lookup then true else false end;
end;

const json_field_is_non_null: (ThreadMethodJsonObject, Text) -> Bool = (
  object: ThreadMethodJsonObject,
  key: Text,
) => do
  let lookup: ThreadMethodJsonLookup = json_object_get(key, object);
  if let #Found value = lookup then
    if let #Null = value then false else true end;
  else
    false
  end;
end;

const sandbox_permissions_valid: ThreadMethodJson -> Bool = value => do
  let sandbox_present = false;
  let permissions_present = false;

  if let #Object object = value then
    let sandbox_lookup = json_object_get("sandbox", object);
    let permissions_lookup = json_object_get("permissions", object);
    if let #Found sandbox = sandbox_lookup then
      if let #Null = sandbox then
        sandbox_present = false
      else
        sandbox_present = true
      end;
    end;
    if let #Found permissions = permissions_lookup then
      if let #Null = permissions then
        permissions_present = false
      else
        permissions_present = true
      end;
    end;
  end;

  !(sandbox_present && permissions_present)
end;

const decode_history_mode: (ThreadMethodJsonObject, Text) -> ThreadMethodHistoryModeResult = (
  object: ThreadMethodJsonObject,
  context: Text,
) => do
  let decoded = optional_text(object, "historyMode", context);

  if let #Err reason = decoded then
    #Err reason
  else let #Ok value = decoded then
    if let #Some mode = value then
      if mode == "legacy" then
        #Ok (#Some (#LegacyHistory))
      else mode == "paginated" then
        #Ok (#Some (#PaginatedHistory))
      else
        #Err (context <> ".historyMode has unknown value " <> mode)
      end;
    else
      #Ok (#None)
    end;
  else
    #Err (context <> ".historyMode could not be decoded")
  end;
end;

const decode_start_source: (ThreadMethodJsonObject, Text) -> ThreadMethodStartSourceResult = (
  object: ThreadMethodJsonObject,
  context: Text,
) => do
  let decoded = optional_text(object, "sessionStartSource", context);

  if let #Err reason = decoded then
    #Err reason
  else let #Ok value = decoded then
    if let #Some source = value then
      if source == "startup" then
        #Ok (#Some (#StartupSource))
      else source == "clear" then
        #Ok (#Some (#ClearSource))
      else
        #Err (context <> ".sessionStartSource has unknown value " <> source)
      end;
    else
      #Ok (#None)
    end;
  else
    #Err (context <> ".sessionStartSource could not be decoded")
  end;
end;

let decode_thread_start: ThreadMethodJson -> ThreadMethodDecodeResult =
  (params: ThreadMethodJson) => do
    if let #Object object = params then
      let model = optional_text(object, "model", "thread/start.params");
      let provider = optional_text(object, "modelProvider", "thread/start.params");
      let allow_fallback_lookup: ThreadMethodJsonLookup = json_object_get(
        "allowProviderModelFallback",
        object,
      );
      let allow_fallback: ThreadMethodAllowFallbackResult =
        if let #Found fallback_json = allow_fallback_lookup then
          if let #Bool fallback_boolean = fallback_json then
            if fallback_boolean then #Ok (#ProviderFallbackAllowed) else #Ok (
              #ProviderFallbackDisallowed
            ) end;
          else #Err "thread/start.params.allowProviderModelFallback must be a boolean" end;
        else #Ok (#ProviderFallbackDisallowed) end;
      let cwd = optional_text(object, "cwd", "thread/start.params");
      let ephemeral = optional_bool(object, "ephemeral", "thread/start.params");
      let history_mode = decode_history_mode(object, "thread/start.params");
      let start_source = decode_start_source(object, "thread/start.params");
      let raw_events_lookup: ThreadMethodJsonLookup = json_object_get(
        "experimentalRawEvents",
        object,
      );
      let raw_events: ThreadMethodRawEventsResult =
        if let #Found raw_events_json = raw_events_lookup then
          if let #Bool raw_events_boolean = raw_events_json then
            if raw_events_boolean then #Ok (#RawEventsEnabled) else #Ok (#RawEventsDisabled)
            end;
          else #Err "thread/start.params.experimentalRawEvents must be a boolean" end;
        else #Ok (#RawEventsDisabled) end;

      if !sandbox_permissions_valid params then
        #MethodError "`permissions` cannot be combined with `sandbox`"
      else let #Err reason = model then
        #MethodError reason
      else let #Err reason = provider then
        #MethodError reason
      else let #Err reason = allow_fallback then
        #MethodError reason
      else let #Err reason = cwd then
        #MethodError reason
      else let #Err reason = ephemeral then
        #MethodError reason
      else let #Err reason = history_mode then
        #MethodError reason
      else let #Err reason = start_source then
        #MethodError reason
      else let #Err reason = raw_events then
        #MethodError reason
      else let #Ok model_value = model then
        if let #Ok provider_value = provider then
          if let #Ok allow_fallback_value = allow_fallback then
            if let #Ok cwd_value = cwd then
              if let #Ok ephemeral_value = ephemeral then
                if let #Ok history_mode_value = history_mode then
                  if let #Ok start_source_value = start_source then
                    if let #Ok raw_events_value = raw_events then
                      let decoded: ThreadMethodStartParams = [
                        model_value,
                        provider_value,
                        allow_fallback_value,
                        cwd_value,
                        ephemeral_value,
                        history_mode_value,
                        start_source_value,
                        raw_events_value,
                        params,
                      ];
                      #MethodOk (#ThreadStart decoded);
                    else #MethodError "thread/start.params.experimentalRawEvents could not be decoded"
                    end;
                  else #MethodError "thread/start.params.sessionStartSource could not be decoded" end;
                else #MethodError "thread/start.params.historyMode could not be decoded" end;
              else #MethodError "thread/start.params.ephemeral could not be decoded" end;
            else #MethodError "thread/start.params.cwd could not be decoded" end;
          else #MethodError "thread/start.params.allowProviderModelFallback could not be decoded" end;
        else #MethodError "thread/start.params.modelProvider could not be decoded" end;
      else
        #MethodError "thread/start.params.model could not be decoded"
      end;
    else
      #MethodError "thread/start.params must be an object"
    end;
  end;

let decode_thread_resume: ThreadMethodJson -> ThreadMethodDecodeResult =
  (params: ThreadMethodJson) => do
    if let #Object object = params then
      let thread_id = required_text(object, "threadId", "thread/resume.params");
      let history = optional_json_kind(object, "history", "thread/resume.params", "array");
      let path = optional_path(object, "thread/resume.params");
      let model = optional_text(object, "model", "thread/resume.params");
      let provider = optional_text(object, "modelProvider", "thread/resume.params");
      let cwd = optional_text(object, "cwd", "thread/resume.params");
      let exclude_turns_lookup: ThreadMethodJsonLookup = json_object_get("excludeTurns", object);
      let exclude_turns: ThreadMethodExcludeTurnsResult =
        if let #Found exclude_json = exclude_turns_lookup then
          if let #Bool exclude_boolean = exclude_json then
            if exclude_boolean then #Ok (#TurnsExcluded) else #Ok (#TurnsIncluded) end;
          else #Err "thread/resume.params.excludeTurns must be a boolean" end;
        else #Ok (#TurnsIncluded) end;
      let initial_page = optional_json_kind(
        object,
        "initialTurnsPage",
        "thread/resume.params",
        "object",
      );

      if !sandbox_permissions_valid params then
        #MethodError "`permissions` cannot be combined with `sandbox`"
      else let #Err reason = thread_id then
        #MethodError reason
      else let #Err reason = history then
        #MethodError reason
      else let #Err reason = path then
        #MethodError reason
      else let #Err reason = model then
        #MethodError reason
      else let #Err reason = provider then
        #MethodError reason
      else let #Err reason = cwd then
        #MethodError reason
      else let #Err reason = exclude_turns then
        #MethodError reason
      else let #Err reason = initial_page then
        #MethodError reason
      else let #Ok thread_id_value = thread_id then
        if let #Ok history_value = history then
          if let #Ok path_value = path then
            if let #Ok model_value = model then
              if let #Ok provider_value = provider then
                if let #Ok cwd_value = cwd then
                  if let #Ok exclude_turns_value = exclude_turns then
                    if let #Ok initial_page_value = initial_page then
                      let decoded: ThreadMethodResumeParams = [
                        thread_id_value,
                        history_value,
                        path_value,
                        model_value,
                        provider_value,
                        cwd_value,
                        exclude_turns_value,
                        initial_page_value,
                        params,
                      ];
                      #MethodOk (#ThreadResume decoded);
                    else #MethodError "thread/resume.params.initialTurnsPage could not be decoded" end;
                  else #MethodError "thread/resume.params.excludeTurns could not be decoded" end;
                else #MethodError "thread/resume.params.cwd could not be decoded" end;
              else #MethodError "thread/resume.params.modelProvider could not be decoded" end;
            else #MethodError "thread/resume.params.model could not be decoded" end;
          else #MethodError "thread/resume.params.path could not be decoded" end;
        else #MethodError "thread/resume.params.history could not be decoded" end;
      else
        #MethodError "thread/resume.params.threadId could not be decoded"
      end;
    else
      #MethodError "thread/resume.params must be an object"
    end;
  end;

let decode_thread_fork: ThreadMethodJson -> ThreadMethodDecodeResult =
  (params: ThreadMethodJson) => do
    if let #Object object = params then
      let thread_id = required_text(object, "threadId", "thread/fork.params");
      let last_turn_id = optional_text(object, "lastTurnId", "thread/fork.params");
      let before_turn_id = optional_text(object, "beforeTurnId", "thread/fork.params");
      let path = optional_path(object, "thread/fork.params");
      let model = optional_text(object, "model", "thread/fork.params");
      let provider = optional_text(object, "modelProvider", "thread/fork.params");
      let cwd = optional_text(object, "cwd", "thread/fork.params");
      let ephemeral_lookup: ThreadMethodJsonLookup = json_object_get("ephemeral", object);
      let ephemeral: ThreadMethodThreadPersistenceResult =
        if let #Found ephemeral_json = ephemeral_lookup then
          if let #Bool ephemeral_boolean = ephemeral_json then
            if ephemeral_boolean then #Ok (#EphemeralThread) else #Ok (#PersistentThread) end;
          else #Err "thread/fork.params.ephemeral must be a boolean" end;
        else #Ok (#PersistentThread) end;
      let exclude_turns_lookup: ThreadMethodJsonLookup = json_object_get("excludeTurns", object);
      let exclude_turns: ThreadMethodExcludeTurnsResult =
        if let #Found fork_exclude_json = exclude_turns_lookup then
          if let #Bool fork_exclude_boolean = fork_exclude_json then
            if fork_exclude_boolean then #Ok (#TurnsExcluded) else #Ok (#TurnsIncluded) end;
          else #Err "thread/fork.params.excludeTurns must be a boolean" end;
        else #Ok (#TurnsIncluded) end;
      let defer_goal_lookup: ThreadMethodJsonLookup = json_object_get(
        "deferGoalContinuation",
        object,
      );
      let defer_goal: ThreadMethodGoalContinuationResult =
        if let #Found defer_goal_json = defer_goal_lookup then
          if let #Bool defer_goal_boolean = defer_goal_json then
            if defer_goal_boolean then #Ok (#GoalContinuationDeferred) else #Ok (
              #GoalContinuationImmediate
            ) end;
          else #Err "thread/fork.params.deferGoalContinuation must be a boolean" end;
        else #Ok (#GoalContinuationImmediate) end;

      if !sandbox_permissions_valid params then
        #MethodError "`permissions` cannot be combined with `sandbox`"
      else let #Err reason = thread_id then
        #MethodError reason
      else let #Err reason = last_turn_id then
        #MethodError reason
      else let #Err reason = before_turn_id then
        #MethodError reason
      else let #Err reason = path then
        #MethodError reason
      else let #Err reason = model then
        #MethodError reason
      else let #Err reason = provider then
        #MethodError reason
      else let #Err reason = cwd then
        #MethodError reason
      else let #Err reason = ephemeral then
        #MethodError reason
      else let #Err reason = exclude_turns then
        #MethodError reason
      else let #Err reason = defer_goal then
        #MethodError reason
      else let #Ok last_value = last_turn_id then
        if let #Ok before_value = before_turn_id then
          let both_boundaries = false;
          if let #Some _ = last_value then
            if let #Some _ = before_value then
              both_boundaries = true
            end;
          end;

          if both_boundaries then
            #MethodError "`beforeTurnId` cannot be combined with `lastTurnId`"
          else let #Ok ephemeral_value = ephemeral then
            if let #Ok defer_goal_value = defer_goal then
              let ephemeral_enabled = if let #EphemeralThread = ephemeral_value then true else
                false end;
              let defer_goal_enabled =
                if let #GoalContinuationDeferred = defer_goal_value then true
                else false end;
              if ephemeral_enabled && defer_goal_enabled then
                #MethodError "`deferGoalContinuation` cannot be combined with `ephemeral`"
              else let #Ok thread_id_value = thread_id then
                if let #Ok path_value = path then
                  if let #Ok model_value = model then
                    if let #Ok provider_value = provider then
                      if let #Ok cwd_value = cwd then
                        if let #Ok exclude_turns_value = exclude_turns then
                          let decoded: ThreadMethodForkParams = [
                            thread_id_value,
                            last_value,
                            before_value,
                            path_value,
                            model_value,
                            provider_value,
                            cwd_value,
                            ephemeral_value,
                            exclude_turns_value,
                            defer_goal_value,
                            params,
                          ];
                          #MethodOk (#ThreadFork decoded);
                        else #MethodError "thread/fork.params.excludeTurns could not be decoded" end;
                      else #MethodError "thread/fork.params.cwd could not be decoded" end;
                    else #MethodError "thread/fork.params.modelProvider could not be decoded" end;
                  else #MethodError "thread/fork.params.model could not be decoded" end;
                else #MethodError "thread/fork.params.path could not be decoded" end;
              else #MethodError "thread/fork.params.threadId could not be decoded" end;
            else #MethodError "thread/fork.params.deferGoalContinuation could not be decoded" end;
          else #MethodError "thread/fork.params.ephemeral could not be decoded" end;
        else #MethodError "thread/fork.params.beforeTurnId could not be decoded" end;
      else
        #MethodError "thread/fork.params.lastTurnId could not be decoded"
      end;
    else
      #MethodError "thread/fork.params must be an object"
    end;
  end;

const decode_thread_archive: ThreadMethodJson -> ThreadMethodDecodeResult = (
  params: ThreadMethodJson) => do
    if let #Object object = params then
      let thread_id = required_text(object, "threadId", "thread/archive.params");
      if let #Ok value = thread_id then #MethodOk (#ThreadArchive value) else let #Err reason = thread_id then #MethodError reason else #MethodError "thread/archive.params.threadId could not be decoded" end;
    else
      #MethodError "thread/archive.params must be an object"
    end;
  end;

