const decode_thread_compact_start: ThreadMethodJson -> ThreadMethodDecodeResult = (
  params: ThreadMethodJson) => do
    if let #Object object = params then
      let thread_id = required_text(object, "threadId", "thread/compact/start.params");
      if let #Ok value = thread_id then #MethodOk (#ThreadCompactStart value) else let #Err reason = thread_id then #MethodError reason else #MethodError "thread/compact/start.params.threadId could not be decoded" end;
    else
      #MethodError "thread/compact/start.params must be an object"
    end;
  end;

const decode_metadata_git_field: (ThreadMethodJsonObject, Text) -> ThreadMethodTextPatchResult = (
  object: ThreadMethodJsonObject,
  key: Text,
) => do
  let lookup: ThreadMethodJsonLookup = json_object_get(key, object);

  if let #Found value = lookup then
    if let #Null = value then
      #Ok (#Clear)
    else let #String text = value then
      let trimmed = text_trim_ascii_whitespace text;
      if trimmed == "" then
        #Err ("gitInfo." <> key <> " must not be empty")
      else
        #Ok (#Set trimmed)
      end;
    else
      #Err ("thread/metadata/update.params.gitInfo." <> key <> " must be a string or null")
    end;
  else
    #Ok (#Keep)
  end;
end;

const decode_thread_metadata_update: ThreadMethodJson -> ThreadMethodDecodeResult = (
  params: ThreadMethodJson) => do
    if let #Object object = params then
      let thread_id = required_text(object, "threadId", "thread/metadata/update.params");
      let git_info_lookup: ThreadMethodJsonLookup = json_object_get("gitInfo", object);

      if let #Err reason = thread_id then
        #MethodError reason
      else let #Found git_info_json = git_info_lookup then
        if let #Object git_info = git_info_json then
          let sha = decode_metadata_git_field(git_info, "sha");
          let branch = decode_metadata_git_field(git_info, "branch");
          let origin_url = decode_metadata_git_field(git_info, "originUrl");

          if let #Err reason = sha then
            #MethodError reason
          else let #Err reason = branch then
            #MethodError reason
          else let #Err reason = origin_url then
            #MethodError reason
          else let #Ok sha_patch = sha then
            if let #Ok branch_patch = branch then
              if let #Ok origin_url_patch = origin_url then
                let has_patch = false;
                if let #Set _ = sha_patch then
                  has_patch = true
                end;
                if let #Clear = sha_patch then
                  has_patch = true
                end;
                if let #Set _ = branch_patch then
                  has_patch = true
                end;
                if let #Clear = branch_patch then
                  has_patch = true
                end;
                if let #Set _ = origin_url_patch then
                  has_patch = true
                end;
                if let #Clear = origin_url_patch then
                  has_patch = true
                end;

                if has_patch then
                  if let #Ok id = thread_id then
                    let patch: ThreadMethodMetadataGitInfoPatch = [
                      sha_patch,
                      branch_patch,
                      origin_url_patch,
                    ];
                    let decoded: ThreadMethodMetadataUpdateParams = [id, patch];
                    #MethodOk (#ThreadMetadataUpdate decoded);
                  else
                    #MethodError "thread/metadata/update.params.threadId could not be decoded"
                  end;
                else
                  #MethodError "gitInfo must include at least one field"
                end;
              else #MethodError "thread/metadata/update.params.gitInfo.originUrl could not be decoded" end;
            else #MethodError "thread/metadata/update.params.gitInfo.branch could not be decoded" end;
          else
            #MethodError "thread/metadata/update.params.gitInfo.sha could not be decoded"
          end;
        else let #Null = git_info_json then
          #MethodError "gitInfo must include at least one field"
        else
          #MethodError "thread/metadata/update.params.gitInfo must be an object or null"
        end;
      else
        #MethodError "gitInfo must include at least one field"
      end;
    else
      #MethodError "thread/metadata/update.params must be an object"
    end;
  end;

const decode_thread_settings_update: ThreadMethodJson -> ThreadMethodDecodeResult = (
  params: ThreadMethodJson) => do
    if let #Object object = params then
      let thread_id = required_text(object, "threadId", "thread/settings/update.params");
      let cwd = optional_text(object, "cwd", "thread/settings/update.params");
      let permissions = optional_text(object, "permissions", "thread/settings/update.params");
      let model = optional_text(object, "model", "thread/settings/update.params");
      let effort = optional_text(object, "effort", "thread/settings/update.params");
      let summary = optional_text(object, "summary", "thread/settings/update.params");
      let personality = optional_text(object, "personality", "thread/settings/update.params");
      let approval_policy: ThreadMethodJsonOption = optional_json(object, "approvalPolicy");
      let approvals_reviewer: ThreadMethodJsonOption = optional_json(object, "approvalsReviewer");
      let sandbox_policy: ThreadMethodJsonOption = optional_json(object, "sandboxPolicy");
      let collaboration_mode: ThreadMethodJsonOption = optional_json(object, "collaborationMode");
      let service_tier_lookup: ThreadMethodJsonLookup = json_object_get("serviceTier", object);
      let service_tier: ThreadMethodTextPatchResult =
        if let #Found tier_json = service_tier_lookup then
          if let #Null = tier_json then
            #Ok (#Clear)
          else let #String tier = tier_json then
            #Ok (#Set tier)
          else
            #Err "thread/settings/update.params.serviceTier must be a string or null"
          end;
        else
          #Ok (#Keep)
        end;

      if let #Err reason = thread_id then
        #MethodError reason
      else let #Err reason = cwd then
        #MethodError reason
      else let #Err reason = permissions then
        #MethodError reason
      else let #Err reason = model then
        #MethodError reason
      else let #Err reason = service_tier then
        #MethodError reason
      else let #Err reason = effort then
        #MethodError reason
      else let #Err reason = summary then
        #MethodError reason
      else let #Err reason = personality then
        #MethodError reason
      else
        let conflicting_permissions = false;
        if let #Some _ = sandbox_policy then
          if let #Ok permission_value = permissions then
            if let #Some _ = permission_value then
              conflicting_permissions = true
            end;
          end;
        end;

        if conflicting_permissions then
          #MethodError "`permissions` cannot be combined with `sandboxPolicy`"
        else let #Ok id = thread_id then
          if let #Ok cwd_value = cwd then
            if let #Ok permission_value = permissions then
              if let #Ok model_value = model then
                if let #Ok tier_patch = service_tier then
                  if let #Ok effort_value = effort then
                    if let #Ok summary_value = summary then
                      if let #Ok personality_value = personality then
                        let has_update = json_field_is_non_null(object,
                          "cwd") || json_field_is_non_null(
                            object,
                            "approvalPolicy"
                          ) || json_field_is_non_null(object, "approvalsReviewer")
                          || json_field_is_non_null(
                            object,
                            "sandboxPolicy",
                          ) || json_field_is_non_null(object, "permissions")
                          || json_field_is_non_null(
                            object,
                            "model",
                          ) || json_field_is_present(object, "serviceTier")
                          || json_field_is_non_null(
                            object,
                            "effort",
                          ) || json_field_is_non_null(object, "summary") || json_field_is_non_null(
                            object,
                            "collaborationMode",
                          ) || json_field_is_non_null(object, "personality");
                        let decoded: ThreadMethodSettingsUpdateParams = [
                          id,
                          cwd_value,
                          approval_policy,
                          approvals_reviewer,
                          sandbox_policy,
                          permission_value,
                          model_value,
                          tier_patch,
                          effort_value,
                          summary_value,
                          collaboration_mode,
                          personality_value,
                          has_update,
                          params,
                        ];
                        #MethodOk (#ThreadSettingsUpdate decoded);
                      else #MethodError "thread/settings/update.params.personality could not be decoded"
                      end;
                    else #MethodError "thread/settings/update.params.summary could not be decoded" end;
                  else #MethodError "thread/settings/update.params.effort could not be decoded" end;
                else #MethodError "thread/settings/update.params.serviceTier could not be decoded" end;
              else #MethodError "thread/settings/update.params.model could not be decoded" end;
            else #MethodError "thread/settings/update.params.permissions could not be decoded" end;
          else #MethodError "thread/settings/update.params.cwd could not be decoded" end;
        else
          #MethodError "thread/settings/update.params.threadId could not be decoded"
        end;
      end;
    else
      #MethodError "thread/settings/update.params must be an object"
    end;
  end;

const decode_page_size: (ThreadMethodJsonObject, Text) -> ThreadMethodPageSizeResult = (
  object: ThreadMethodJsonObject,
  context: Text,
) => do
  let lookup: ThreadMethodJsonLookup = json_object_get("limit", object);

  if let #Found value = lookup then
    if let #Null = value then
      #Ok 25
    else let #Number number = value then
      let parsed = parse_u32_decimal number;
      if let #Ok page_size = parsed then
        if page_size < 1i64 then
          #Ok 1
        else page_size > 100i64 then
          #Ok 100
        else
          #Ok (unsafe_i32_wrap_i64 page_size)
        end;
      else let #Err reason = parsed then
        #Err (context <> ".limit " <> reason)
      else
        #Err (context <> ".limit could not be decoded")
      end;
    else
      #Err (context <> ".limit must be a non-negative integer or null")
    end;
  else
    #Ok 25
  end;
end;

const decode_page_sort_direction: (ThreadMethodJsonObject, Text, ThreadMethodSortDirection) -> ThreadMethodSortDirectionResult =
  (
    object: ThreadMethodJsonObject,
    context: Text,
    fallback: ThreadMethodSortDirection,
  ) => do
    let decoded = optional_text(object, "sortDirection", context);

    if let #Err reason = decoded then
      #Err reason
    else let #Ok value = decoded then
      if let #Some direction = value then
        if direction == "asc" then
          #Ok (#Ascending)
        else direction == "desc" then
          #Ok (#Descending)
        else
          #Err (context <> ".sortDirection has unknown value " <> direction)
        end;
      else
        #Ok fallback
      end;
    else
      #Err (context <> ".sortDirection could not be decoded")
    end;
  end;

const decode_turn_items_view: ThreadMethodJsonObject -> ThreadMethodItemsViewResult = (
  object: ThreadMethodJsonObject) => do
    let decoded = optional_text(object, "itemsView", "thread/turns/list.params");

    if let #Err reason = decoded then
      #Err reason
    else let #Ok value = decoded then
      if let #Some view = value then
        if view == "notLoaded" then
          #Ok (#NotLoaded)
        else view == "summary" then
          #Ok (#Summary)
        else view == "full" then
          #Ok (#Full)
        else
          #Err ("thread/turns/list.params.itemsView has unknown value " <> view)
        end;
      else
        #Ok (#Summary)
      end;
    else
      #Err "thread/turns/list.params.itemsView could not be decoded"
    end;
  end;

const decode_thread_turns_list: ThreadMethodJson -> ThreadMethodDecodeResult = (
  params: ThreadMethodJson) => do
    if let #Object object = params then
      let thread_id = required_text(object, "threadId", "thread/turns/list.params");
      let cursor = optional_text(object, "cursor", "thread/turns/list.params");
      let page_size = decode_page_size(object, "thread/turns/list.params");
      let fallback: ThreadMethodSortDirection = #Descending;
      let direction = decode_page_sort_direction(object, "thread/turns/list.params", fallback);
      let items_view = decode_turn_items_view object;

      if let #Err reason = thread_id then
        #MethodError reason
      else let #Err reason = cursor then
        #MethodError reason
      else let #Err reason = page_size then
        #MethodError reason
      else let #Err reason = direction then
        #MethodError reason
      else let #Err reason = items_view then
        #MethodError reason
      else let #Ok id = thread_id then
        if let #Ok cursor_value = cursor then
          if let #Ok page_size_value = page_size then
            if let #Ok direction_value = direction then
              if let #Ok items_view_value = items_view then
                let decoded: ThreadMethodTurnsListParams = [
                  id,
                  cursor_value,
                  page_size_value,
                  direction_value,
                  items_view_value,
                ];
                #MethodOk (#ThreadTurnsList decoded);
              else #MethodError "thread/turns/list.params.itemsView could not be decoded" end;
            else #MethodError "thread/turns/list.params.sortDirection could not be decoded" end;
          else #MethodError "thread/turns/list.params.limit could not be decoded" end;
        else #MethodError "thread/turns/list.params.cursor could not be decoded" end;
      else
        #MethodError "thread/turns/list.params.threadId could not be decoded"
      end;
    else
      #MethodError "thread/turns/list.params must be an object"
    end;
  end;

const decode_thread_items_list: ThreadMethodJson -> ThreadMethodDecodeResult = (
  params: ThreadMethodJson) => do
    if let #Object object = params then
      let thread_id = required_text(object, "threadId", "thread/items/list.params");
      let turn_id = optional_text(object, "turnId", "thread/items/list.params");
      let cursor = optional_text(object, "cursor", "thread/items/list.params");
      let page_size = decode_page_size(object, "thread/items/list.params");
      let fallback: ThreadMethodSortDirection = #Ascending;
      let direction = decode_page_sort_direction(object, "thread/items/list.params", fallback);

      if let #Err reason = thread_id then
        #MethodError reason
      else let #Err reason = turn_id then
        #MethodError reason
      else let #Err reason = cursor then
        #MethodError reason
      else let #Err reason = page_size then
        #MethodError reason
      else let #Err reason = direction then
        #MethodError reason
      else let #Ok id = thread_id then
        if let #Ok turn_id_value = turn_id then
          if let #Ok cursor_value = cursor then
            if let #Ok page_size_value = page_size then
              if let #Ok direction_value = direction then
                let decoded: ThreadMethodItemsListParams = [
                  id,
                  turn_id_value,
                  cursor_value,
                  page_size_value,
                  direction_value,
                ];
                #MethodOk (#ThreadItemsList decoded);
              else #MethodError "thread/items/list.params.sortDirection could not be decoded" end;
            else #MethodError "thread/items/list.params.limit could not be decoded" end;
          else #MethodError "thread/items/list.params.cursor could not be decoded" end;
        else #MethodError "thread/items/list.params.turnId could not be decoded" end;
      else
        #MethodError "thread/items/list.params.threadId could not be decoded"
      end;
    else
      #MethodError "thread/items/list.params must be an object"
    end;
  end;

return {
  .decode_thread_start,
  .decode_thread_resume,
  .decode_thread_fork,
  .decode_thread_archive,
  .decode_thread_unarchive,
  .decode_thread_delete,
  .decode_thread_unsubscribe,
  .decode_thread_compact_start,
  .decode_thread_metadata_update,
  .decode_thread_settings_update,
  .decode_thread_turns_list,
  .decode_thread_items_list,
};
