module () where

const { .format_i32, .list, .text_append, .text_trim_ascii_whitespace } =
  import "duck:prelude/functional" ();
const hook_types_module = import "./hook_types.duck";

type PolicyI32Option = HookI32Option
type PolicyTextOption = HookTextOption
type PolicyTexts = HookTexts
type PolicyEvent = HookEvent
type PolicyScope = HookScope
type PolicySource = HookSource
type PolicyMatcher = HookMatcher
type PolicyHandlerConfig = HookHandlerConfig
type PolicyConfiguredHandler = HookConfiguredHandler
type PolicyStateOption = HookStateOption
type PolicyTrustStatus = HookTrustStatus
type PolicyPermissionDecisions = HookPermissionDecisions
type PolicyPermissionDecisionOption = HookPermissionDecisionOption
type PolicyLegacyResults = HookLegacyResults
type PolicyLegacyOutcome = HookLegacyOutcome

const texts = comptime list Text;
const append_text = (left: Text, right: Text) => text_append (left, right);

const hook_event_key_label = (event: PolicyEvent) => do
  if let #PreToolUse = event then
    "pre_tool_use"
  else let #PermissionRequest = event then
    "permission_request"
  else let #PostToolUse = event then
    "post_tool_use"
  else let #PreCompact = event then
    "pre_compact"
  else let #PostCompact = event then
    "post_compact"
  else let #SessionStart = event then
    "session_start"
  else let #SessionEnd = event then
    "session_end"
  else let #UserPromptSubmit = event then
    "user_prompt_submit"
  else let #SubagentStart = event then
    "subagent_start"
  else let #SubagentStop = event then
    "subagent_stop"
  else
    "stop"
  end;
end;

const hook_key = (key_source: Text, event: PolicyEvent, group_index: I32, handler_index: I32) => do
  append_text(
    key_source,
    append_text(
      ":",
      append_text(
        hook_event_key_label event,
        append_text(
          ":",
          append_text(format_i32 group_index, append_text(":", format_i32 handler_index)),
        ),
      ),
    ),
  )
end;

const hook_scope = (event: PolicyEvent) => do
  if let #SessionStart = event then
    #Thread
  else let #SessionEnd = event then
    #Thread
  else let #SubagentStart = event then
    #Thread
  else
    #Turn
  end;
end;

const event_uses_matcher = (event: PolicyEvent) => do
  if let #UserPromptSubmit = event then
    false
  else let #Stop = event then
    false
  else
    true
  end;
end;

const normalize_timeout = (event: PolicyEvent, configured: PolicyI32Option) => do
  if let #SessionEnd = event then
    let timeout = if let #Some seconds = configured then seconds else 1 end;

    if timeout < 1 then
      1
    else timeout > 3 then
      3
    else
      timeout
    end;
  else
    let timeout = if let #Some seconds = configured then seconds else 600 end;
    if timeout < 1 then 1 else timeout end;
  end;
end;

const normalize_hook_handler = (
  event: PolicyEvent,
  matcher: PolicyMatcher,
  config: PolicyHandlerConfig,
  source_path: Text,
  source: PolicySource,
  display_order: I32,
) => do
  if let #Prompt = config then
    #Skipped (
      append_text(
        "skipping prompt hook in ",
        append_text(source_path, ": prompt hooks are not supported yet"),
      )
    )
  else let #Agent = config then
    #Skipped (
      append_text(
        "skipping agent hook in ",
        append_text(source_path, ": agent hooks are not supported yet"),
      )
    )
  else let #Command command_config = config then
    let [command, timeout, asynchronous, status_message] = command_config;

    if text_trim_ascii_whitespace command == "" then
      #Skipped (append_text("skipping empty hook command in ", source_path))
    else asynchronous then
      if let #SessionEnd = event then
        let configured: PolicyConfiguredHandler = [
          event,
          matcher,
          command,
          normalize_timeout(event, timeout),
          status_message,
          source_path,
          source,
          display_order,
        ];
        #Configured (
          [
            configured,
            texts.singleton(
              append_text("running async SessionEnd hook synchronously in ", source_path)
            ),
          ]
        )
      else
        #Skipped (
          append_text(
            "skipping async hook in ",
            append_text(source_path, ": async hooks are not supported yet"),
          )
        )
      end;
    else
      let warnings: PolicyTexts = texts.empty();
      let normalized_timeout = normalize_timeout(event, timeout);

      if let #SessionEnd = event then
        if let #Some configured_timeout = timeout then
          if configured_timeout > 3 then
            warnings = texts.singleton(
              append_text("clamping SessionEnd hook timeout to 3s in ", source_path)
            )
          end;
        end;
      end;

      let configured: PolicyConfiguredHandler = [
        event,
        matcher,
        command,
        normalized_timeout,
        status_message,
        source_path,
        source,
        display_order,
      ];
      #Configured ([configured, warnings])
    end;
  else
    #Skipped "invalid hook handler configuration"
  end;
end;

const hook_enabled = (managed: Bool, state: PolicyStateOption) => do
  if managed then
    true
  else let #PresentHookState configured_state = state then
    let [enabled, _] = configured_state;
    if let #Disabled = enabled then false else true end;
  else
    true
  end;
end;

const hook_trust_status = (managed: Bool, current_hash: Text, state: PolicyStateOption) => do
  if managed then
    #Managed
  else let #PresentHookState configured_state = state then
    let [_, trusted_hash] = configured_state;

    if let #TrustedHash hash = trusted_hash then
      if hash == current_hash then #Trusted else #Modified end;
    else
      #Untrusted
    end;
  else
    #Untrusted
  end;
end;

const hook_may_run = (
  managed: Bool,
  bypass_trust: Bool,
  current_hash: Text,
  state: PolicyStateOption,
) => do
  if hook_enabled(managed, state) then
    if bypass_trust then
      true
    else
      let status: PolicyTrustStatus = hook_trust_status(managed, current_hash, state);

      if let #Managed = status then
        true
      else let #Trusted = status then
        true
      else
        false
      end;
    end;
  else
    false
  end;
end;

const resolve_permission_decisions: PolicyPermissionDecisions -> PolicyPermissionDecisionOption =
  decisions => do
    let current = decisions;
    let resolved: PolicyPermissionDecisionOption = #None;
    let saw_allow = false;

    loop do
      if let #Cons node = current then
        let [decision, tail] = node;

        if let #Deny message = decision then
          resolved = #Some (#Deny message)
          break;
        else
          saw_allow = true
          current = tail
        end;
      else
        break;
      end;
    end;

    if let #Some value = resolved then
      #Some value
    else saw_allow then
      #Some (#Allow)
    else
      #None
    end;
  end;

const fold_legacy_hook_results: PolicyLegacyResults -> PolicyLegacyOutcome = results => do
  let current = results;
  let continued = true;
  let messages: Text = "";
  let message_count = 0;

  loop do
    if let #Cons node = current then
      let [result, tail] = node;
      let message: PolicyTextOption = #None;

      if let #FailedAbort failure = result then
        message = #Some failure
        continued = false
      else let #FailedContinue failure = result then
        message = #Some failure
      end;

      if let #Some value = message then
        if message_count > 0 then
          messages = append_text(messages, "\n\n")
        end;

        messages = append_text(messages, value)
        message_count = message_count + 1
      end;

      if continued then
        current = tail
      else
        break;
      end;
    else
      break;
    end;
  end;

  [continued, messages, message_count]
end;

return {
  .hook_event_key_label,
  .hook_key,
  .hook_scope,
  .event_uses_matcher,
  .normalize_timeout,
  .normalize_hook_handler,
  .hook_enabled,
  .hook_trust_status,
  .hook_may_run,
  .resolve_permission_decisions,
  .fold_legacy_hook_results,
};
