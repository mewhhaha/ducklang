module () where

const agent_types_module = import "./agent_types.duck";
const agents_module = import "./agents.duck";
const { .normalize_wait_timeout, .validate_collab_input } = agents_module();

type FixtureI64Option = AgentI64Option

let score: I32 = 0;

if let #InputRejected _ = validate_collab_input(#Some "message", 1) then
  score = score + 1
end;

if let #InputAccepted value = validate_collab_input(#Some " work ", -1) then
  if value == " work " then
    score = score + 10
  end;
end;

let short_timeout: FixtureI64Option = #Some 1i64;

if let #Timeout timeout = normalize_wait_timeout short_timeout then
  if timeout == 10000i64 then
    score = score + 100
  end;
end;

let invalid_timeout: FixtureI64Option = #Some (0i64 - 1i64);

if let #InvalidTimeout _ = normalize_wait_timeout invalid_timeout then
  score = score + 1000
end;

return { .score = score };
