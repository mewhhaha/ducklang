module () where

const { .list, .text_append, .text_approx_token_count, .text_starts_with, .text_truncate_middle_tokens
} = import "duck:prelude/functional" ();
const history_types_module = import "./history_types.duck";

type CompactionContent = HistoryContent
type CompactionContents = List CompactionContent
type CompactionItem = HistoryItem
type CompactionItems = List CompactionItem
type CompactionMessage = HistoryMessage
type CompactionTextOption = Option Text

const compaction_contents = comptime list CompactionContent;
const compaction_items = comptime list CompactionItem;
const compaction_texts = comptime list Text;

const summary_prefix: Text =
  "Another language model started to solve this problem and produced a summary of its thinking process. You also have access to the state of the tools that were used by that language model. Use this to build on the work that has already been done and avoid duplicating work. Here is the summary produced by the other language model, use the information in this summary to assist with your own analysis:";

const compaction_content_text: (CompactionContent) -> CompactionTextOption =
  content => if let #InputText text = content then
    #Some text
  else let #OutputText text = content then
    #Some text
  else
    #None
  end;

const content_items_to_text: (CompactionContents) -> CompactionTextOption = values => do
  let current = values;
  let text: Text = "";
  let has_text = false;
  let done = false;

  loop do
    if let #Cons node = current then
      let [content, tail] = node;
      let content_text = compaction_content_text content;

      if let #Some part = content_text then
        if part == "" then
          ()
        else has_text then
          text = text_append [text, text_append ["\n", part]]
        else
          text = part
          has_text = true
        end;
      end;

      current = tail
    else
      done = true
    end;

    if done then
      break;
    end;
  end;

  if has_text then
    #Some text
  else
    #None
  end;
end;

const is_summary_message = (message: Text) => do
  text_starts_with [message, text_append [summary_prefix, "\n"]]
end;

const user_message_text: (CompactionItem) -> CompactionTextOption =
  item => if let #Message message = item then
    let [role, contextual, contents] = message;

    if role == "user" then
      if contextual then
        #None
      else
        let text = content_items_to_text contents;

        if let #Some message_text = text then
          if is_summary_message message_text then
            #None
          else
            #Some message_text
          end;
        else
          #None
        end;
      end;
    else
      #None
    end;
  else
    #None
  end;

const collect_user_messages = (values: CompactionItems) => do
  let current = values;
  let messages_reversed = compaction_texts.empty();
  let done = false;

  loop do
    if let #Cons node = current then
      let [item, tail] = node;
      let message = user_message_text item;

      if let #Some text = message then
        messages_reversed = compaction_texts.prepend(text, messages_reversed)
      end;

      current = tail
    else
      done = true
    end;

    if done then
      break;
    end;
  end;

  compaction_texts.reverse messages_reversed
end;

const select_recent_user_messages = (values: List Text, maximum_tokens: I32) => do
  let current = compaction_texts.reverse values;
  let selected: List Text = compaction_texts.empty();
  let remaining = maximum_tokens;
  let done = remaining <= 0;

  loop do
    if done then
      break;
    end;

    if let #Cons node = current then
      let [message, tail] = node;
      let tokens = text_approx_token_count message;

      if tokens <= remaining then
        selected = compaction_texts.prepend(message, selected)
        remaining = remaining - tokens
        current = tail

        if remaining == 0 then
          done = true
        end;
      else
        selected = compaction_texts.prepend(
          text_truncate_middle_tokens(message, remaining),
          selected,
        )
        done = true
      end;
    else
      done = true
    end;
  end;

  selected
end;

const user_message_item = (text: Text) => do
  let contents = compaction_contents.singleton(#InputText text);
  let message: CompactionMessage = ["user", false, contents];
  #Message message
end;

const build_compacted_history = (
  initial_context: CompactionItems,
  user_messages: List Text,
  summary_text: Text,
  maximum_tokens: I32,
) => do
  let selected = select_recent_user_messages(user_messages, maximum_tokens);
  let history_reversed = compaction_items.reverse initial_context;
  let current = selected;
  let done = false;

  loop do
    if let #Cons node = current then
      let [message, tail] = node;
      history_reversed = compaction_items.prepend(user_message_item message, history_reversed)
      current = tail
    else
      done = true
    end;

    if done then
      break;
    end;
  end;

  let summary = summary_text;

  if summary == "" then
    summary = "(no summary available)"
  end;

  history_reversed = compaction_items.prepend(user_message_item summary, history_reversed)
  compaction_items.reverse history_reversed
end;

const compact_history =
  (values: CompactionItems, summary_text: Text, maximum_user_tokens: I32) => do
    let user_messages = collect_user_messages values;
    build_compacted_history(
      compaction_items.empty(),
      user_messages,
      summary_text,
      maximum_user_tokens,
    )
  end;

return {
  .summary_prefix,
  .content_items_to_text,
  .collect_user_messages,
  .build_compacted_history,
  .compact_history,
  .is_summary_message,
};
