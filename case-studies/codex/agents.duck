module () where

const {} = import "./agent_types.duck" ();
const { .execution_capacity, .next_spawn_depth, .spawn_depth_allowed } =
  import "./agent_capacity.duck" ();
const { .normalize_wait_timeout, .validate_collab_input } = import "./agent_input_policy.duck" ();
const {
  .resolve_agent_path,
  .valid_agent_name,
  .validate_absolute_agent_path,
  .validate_relative_agent_path,
} = import "./agent_path.duck" ();

type AgentsStatus = AgentStatus
type AgentsEvent = AgentEvent

const agent_status_is_final = (status: AgentsStatus) => do
  if let #PendingInit = status then
    false
  else let #Running = status then
    false
  else let #Interrupted = status then
    false
  else
    true
  end;
end;

const agent_status_from_event = (event: AgentsEvent) => do
  if let #TurnStarted = event then
    #StatusChanged (#Running)
  else let #TurnComplete message = event then
    #StatusChanged (#Completed message)
  else let #TurnInterrupted = event then
    #StatusChanged (#Interrupted)
  else let #TurnBudgetLimited = event then
    #StatusChanged (#Interrupted)
  else let #TurnAborted reason = event then
    #StatusChanged (#Errored reason)
  else let #AgentError message = event then
    #StatusChanged (#Errored message)
  else let #ShutdownComplete = event then
    #StatusChanged (#Shutdown)
  else
    #StatusUnchanged
  end;
end;

const collab_tool_call_failed = (status: AgentsStatus, has_receiver: Bool) => do
  if let #Errored _ = status then
    true
  else let #NotFound = status then
    true
  else has_receiver then
    false
  else
    true
  end;
end;

return {
  .agent_status_is_final,
  .agent_status_from_event,
  .collab_tool_call_failed,
  .next_spawn_depth,
  .spawn_depth_allowed,
  .execution_capacity,
  .validate_collab_input,
  .normalize_wait_timeout,
  .valid_agent_name,
  .validate_relative_agent_path,
  .validate_absolute_agent_path,
  .resolve_agent_path,
};
