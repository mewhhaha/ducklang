module () where

const {
  .encode_json,
  .json_array,
  .json_array_empty,
  .json_array_prepend,
  .json_object,
  .json_object_empty,
  .json_object_prepend,
  .json_string,
  .parse_json_document,
} = import "duck:prelude/json" ();
const { .text_append } = import "duck:prelude/runtime" ();

type ProtocolJson = Json
type ModelToolCall = [Text, Text, Text]

type ModelEvent =
  | #Message Text
  | #ToolCall ModelToolCall
  | #Completed
  | #Error Text
  | #Ignored

type ModelEventResult =
  | #Ok ModelEvent
  | #Err Text

const decode_message_content: ProtocolJson -> Text = (content: ProtocolJson) => do
  let text: Text = "";

  if let #Array values = content then
    let current = values;
    let done = false;

    loop do
      if let #Cons node = current then
        let [value, tail] = node;

        if let #Object fields = value then
          let field_current = fields;
          let content_type: Text = "";
          let content_text: Text = "";
          let fields_done = false;

          loop do
            if let #Cons field_node = field_current then
              let [member, field_tail] = field_node;
              let [key, field_value] = member;

              if key == "type" then
                if let #String value_text = field_value then
                  content_type = value_text
                end;
              else key == "text" then
                if let #String value_text = field_value then
                  content_text = value_text
                end;
              end;

              field_current = field_tail
            else
              fields_done = true
            end;

            if fields_done then
              break;
            end;
          end;

          if content_type == "output_text" then
            text = text_append (text, content_text)
          end;
        end;

        current = tail
      else
        done = true
      end;

      if done then
        break;
      end;
    end;
  end;

  text
end;

const decode_output_item: ProtocolJson -> ModelEventResult = (item: ProtocolJson) => do
  let item_type: Text = "";
  let call_id: Text = "";
  let name: Text = "";
  let arguments: Text = "";
  let message: Text = "";

  if let #Object fields = item then
    let current = fields;
    let done = false;

    loop do
      if let #Cons node = current then
        let [member, tail] = node;
        let [key, value] = member;

        if key == "type" then
          if let #String text = value then
            item_type = text
          end;
        else key == "call_id" then
          if let #String text = value then
            call_id = text
          end;
        else key == "name" then
          if let #String text = value then
            name = text
          end;
        else key == "arguments" then
          if let #String text = value then
            arguments = text
          end;
        else key == "content" then
          message = decode_message_content value
        end;

        current = tail
      else
        done = true
      end;

      if done then
        break;
      end;
    end;
  end;

  if item_type == "function_call" then
    if call_id == "" || name == "" || arguments == "" then
      #Err ("Function call is missing call_id, name, or arguments")
    else
      let tool_call: ModelToolCall = [call_id, name, arguments];
      #Ok (#ToolCall tool_call)
    end;
  else item_type == "message" then
    #Ok (#Message message)
  else
    #Ok (#Ignored)
  end;
end;

const decode_model_event: Text -> ModelEventResult = (document: Text) => do
  let parsed = parse_json_document document;

  if let #Err error = parsed then
    let [_, message] = error;
    #Err (message)
  else let #Ok value_and_index = parsed then
    let [value, _] = value_and_index;
    let event_type: Text = "";
    let delta: Text = "";
    let error_message: Text = "";
    let item = value;

    if let #Object fields = value then
      let current = fields;
      let done = false;

      loop do
        if let #Cons node = current then
          let [member, tail] = node;
          let [key, field_value] = member;

          if key == "type" then
            if let #String text = field_value then
              event_type = text
            end;
          else key == "delta" then
            if let #String text = field_value then
              delta = text
            end;
          else key == "message" then
            if let #String text = field_value then
              error_message = text
            end;
          else key == "item" then
            item = field_value
          else key == "error" then
            if let #Object error_fields = field_value then
              let error_current = error_fields;
              let error_done = false;

              loop do
                if let #Cons error_node = error_current then
                  let [error_member, error_tail] = error_node;
                  let [error_key, error_value] = error_member;

                  if error_key == "message" then
                    if let #String text = error_value then
                      error_message = text
                    end;
                  end;

                  error_current = error_tail
                else
                  error_done = true
                end;

                if error_done then
                  break;
                end;
              end;
            end;
          end;

          current = tail
        else
          done = true
        end;

        if done then
          break;
        end;
      end;

      if event_type == "response.output_text.delta" then
        #Ok (#Message delta)
      else event_type == "response.output_item.done" then
        decode_output_item item
      else event_type == "response.completed" then
        #Ok (#Completed)
      else event_type == "error" || event_type == "response.failed" then
        if error_message == "" then
          #Err ("Model response failed without a message")
        else
          #Ok (#Error error_message)
        end;
      else
        #Ok (#Ignored)
      end;
    else
      #Err ("Model event must be a JSON object")
    end;
  else
    #Err ("Invalid JSON parse result")
  end;
end;

const encode_user_message: Text -> Text = (prompt: Text) => do
  let content_fields = json_object_empty();
  content_fields = json_object_prepend("text", json_string prompt, content_fields)
  content_fields = json_object_prepend("type", json_string "input_text", content_fields)
  let content = json_array_prepend(json_object content_fields, json_array_empty());
  let fields = json_object_empty();
  fields = json_object_prepend("content", json_array content, fields)
  fields = json_object_prepend("role", json_string "user", fields)
  fields = json_object_prepend("type", json_string "message", fields)
  encode_json(json_object fields)
end;

const encode_tool_result: (Text, Text) -> Text = (call_id: Text, output: Text) => do
  let fields = json_object_empty();
  fields = json_object_prepend("output", json_string output, fields)
  fields = json_object_prepend("call_id", json_string call_id, fields)
  fields = json_object_prepend("type", json_string "function_call_output", fields)
  encode_json(json_object fields)
end;

return {
  .decode_model_event,
  .encode_user_message,
  .encode_tool_result,
};
