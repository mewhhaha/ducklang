module () where

const { .path_resolve } = import "duck:prelude/path" ();
const { .text_append } = import "duck:prelude/text" ();
const {} = import "./view_image_types.duck" ();

type ImagePolicyArgs = ViewImageArgs
type ImagePolicyDetail = ViewImageDetail
type ImagePolicyEnvironment = ViewImageEnvironment
type ImagePolicyEnvironmentSelection = ViewImageEnvironmentSelection
type ImagePolicyEnvironments = ViewImageEnvironments
type ImagePolicyPlan = ViewImageCallPlan
type ImagePolicyPrepared = ViewImagePreparedCall
type ImagePolicyTextOption = ViewImageTextOption

const select_view_image_environment: [ImagePolicyEnvironments, ImagePolicyTextOption] ->
  ImagePolicyEnvironmentSelection = (
    environments: ImagePolicyEnvironments,
    requested_id: ImagePolicyTextOption,
  ) => do
    let current = environments;
    let selection: ImagePolicyEnvironmentSelection =
      #SelectionFailed "view_image is unavailable in this session";
    let done = false;

    loop do
      if let #Cons node = current then
        let [environment, tail] = node;
        let matches = if let #ImageEnvironmentPresent environment_id = requested_id then
          environment.environment_id == environment_id
        else
          environment.is_primary
        end;

        if matches then
          selection = #Selected environment
          done = true
        else
          current = tail
        end;
      else
        done = true
      end;

      if done then
        break;
      end;
    end;

    if let #Selected environment = selection then
      #Selected environment
    else let #ImageEnvironmentPresent environment_id = requested_id then
      #SelectionFailed (
        text_append ["unknown turn environment id `", text_append [environment_id, "`"]]
      )
    else
      selection
    end;
  end;

const prepare_view_image: [Text, ImagePolicyArgs, ImagePolicyEnvironments, Bool] ->
  ImagePolicyPlan = (
    call_id: Text,
    args: ImagePolicyArgs,
    environments: ImagePolicyEnvironments,
    can_request_original_detail: Bool,
  ) => do
    let selection = select_view_image_environment(environments, args.environment_id);
    if let #Selected selected = selection then
      let detail: ImagePolicyDetail = #High;
      if let #ImageDetailPresent requested = args.detail then
        if can_request_original_detail then
          if let #Original = requested then
            detail = #Original
          end;
        end;
      end;

      let path = path_resolve(selected.cwd, args.path);
      let prepared: ImagePolicyPrepared = [
        .call_id = call_id,
        .environment_id = selected.environment_id,
        .path = path,
        .detail = detail,
      ];
      #ReadImage prepared
    else let #SelectionFailed message = selection then
      #RejectRequest message
    else
      #RejectRequest "view_image environment selection produced no result"
    end;
  end;

return {
  .prepare_view_image,
  .select_view_image_environment,
};
