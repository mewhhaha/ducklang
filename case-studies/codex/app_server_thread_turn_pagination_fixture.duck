module () where

const {
  .json_array_empty,
  .json_array_prepend,
  .json_object,
  .json_object_empty,
  .json_object_get,
  .json_object_prepend,
  .json_string,
} = import "duck:prelude/json/values" ();
const { .paginate_thread_turns } = import "./app_server_thread_turn_pagination.duck" ();
const {} = import "./app_server_turn_types.duck" ();
const {} = import "./app_server_types.duck" ();

type FixtureJson = AppServerJson
type FixtureJsonArray = JsonArray
type FixtureTurn = AppServerTurn
type FixtureTurns = AppServerTurns
type FixturePageResult = AppServerThreadTurnsCursorPageResult
type FixtureCursorOption = AppServerThreadTurnsCursorOption

const message: (Text, Text) -> FixtureJson = (item_type: Text, id: Text) => do
  let fields = json_object_empty();
  fields = json_object_prepend("id", json_string id, fields)
  fields = json_object_prepend("type", json_string item_type, fields)
  json_object fields
end;

const turn: (Text, FixtureJsonArray) -> FixtureTurn = (id: Text, items: FixtureJsonArray) => do
  [id, items, #Full, #Completed, #None, #None, #None, #None]
end;

const item_has_type: (FixtureJson, Text) -> Bool = (item: FixtureJson, expected: Text) => do
  if let #Object fields = item then
    if let #Found value = json_object_get("type", fields) then
      if let #String item_type = value then item_type == expected else false end;
    else false end;
  else false end;
end;

let first_items = json_array_empty();
first_items = json_array_prepend(message("toolCall", "tool-1"), first_items)
first_items = json_array_prepend(message("agentMessage", "agent-1"), first_items)
first_items = json_array_prepend(message("userMessage", "user-1"), first_items)
let second_items = json_array_prepend(message("agentMessage", "agent-2"), json_array_empty());
let third_items = json_array_prepend(message("userMessage", "user-3"), json_array_empty());
let first: FixtureTurn = turn("turn-1", first_items);
let second: FixtureTurn = turn("turn-2", second_items);
let third: FixtureTurn = turn("turn-3", third_items);
let history: FixtureTurns = #Cons ([first, #Cons ([second, #Cons ([third, #Nil])])]);

let score = 0;
let ascending: FixturePageResult = paginate_thread_turns (
  history,
  #None,
  2,
  #Ascending,
  #Summary,
);
let next_cursor: FixtureCursorOption = #None;
if let #Ok page = ascending then
  let [page_turns, next, backwards] = page;
  next_cursor = next
  if let #Cons first_node = page_turns then
    let [first_turn, tail] = first_node;
    if let #Cons second_node = tail then
      let [second_turn, finish] = second_node;
      let [first_id, first_summary, first_view, _, _, _, _, _] = first_turn;
      let [second_id, second_summary, second_view, _, _, _, _, _] = second_turn;
      let first_summary_valid = if let #Cons user_node = first_summary then
        let [user, after_user] = user_node;
        if let #Cons agent_node = after_user then
          let [agent, after_agent] = agent_node;
          if let #Nil = after_agent then item_has_type(user, "userMessage") && item_has_type(
            agent,
            "agentMessage",
          ) else false end;
        else false end;
      else false end;
      let second_summary_valid = if let #Cons agent_node = second_summary then
        let [agent, after_agent] = agent_node;
        if let #Nil = after_agent then item_has_type(agent, "agentMessage") else false end;
      else false end;
      let views_valid =
        if let #Summary = first_view then
          if let #Summary = second_view then true else false end;
        else false end;
      let end_valid = if let #Nil = finish then true else false end;
      let next_valid = if let #Some value = next then
        let [id, included] = value;
        id == "turn-2" && included == false
      else false end;
      let backwards_valid = if let #Some value = backwards then
        let [id, included] = value;
        id == "turn-1" && included
      else false end;
      if first_id == "turn-1" && second_id == "turn-2" && first_summary_valid
        && second_summary_valid && views_valid && end_valid && next_valid && backwards_valid then
          score = score + 100
        end;
    end;
  end;
end;

let second_page: FixturePageResult = paginate_thread_turns (
  history,
  next_cursor,
  2,
  #Ascending,
  #Full,
);
if let #Ok page = second_page then
  let [page_turns, next, backwards] = page;
  if let #Cons node = page_turns then
    let [only_turn, tail] = node;
    let [turn_id, _, view, _, _, _, _, _] = only_turn;
    let tail_valid = if let #Nil = tail then true else false end;
    let view_valid = if let #Full = view then true else false end;
    let next_valid = if let #None = next then true else false end;
    let backwards_valid = if let #Some value = backwards then
      let [id, included] = value;
      id == "turn-3" && included
    else false end;
    if turn_id == "turn-3" && tail_valid && view_valid && next_valid && backwards_valid then
      score = score + 1000
    end;
  end;
end;

let descending: FixturePageResult = paginate_thread_turns (
  history,
  #None,
  2,
  #Descending,
  #NotLoaded,
);
if let #Ok page = descending then
  let [page_turns, _, _] = page;
  if let #Cons first_node = page_turns then
    let [first_turn, tail] = first_node;
    if let #Cons second_node = tail then
      let [second_turn, _] = second_node;
      let [first_id, first_items_view, first_view, _, _, _, _, _] = first_turn;
      let [second_id, second_items_view, second_view, _, _, _, _, _] = second_turn;
      let first_empty = if let #Nil = first_items_view then true else false end;
      let second_empty = if let #Nil = second_items_view then true else false end;
      let views_valid =
        if let #NotLoaded = first_view then
          if let #NotLoaded = second_view then
            true else false end;
        else false end;
      if first_id == "turn-3" && second_id == "turn-2" && first_empty && second_empty
        && views_valid then
          score = score + 10000
        end;
    end;
  end;
end;

return { .score = score };
