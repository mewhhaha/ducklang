module () where

const {} = import "./tool_types.duck" ();
const { .list_available_plugins_to_install_definitions } =
  import "./list_plugin_install_registration.duck" ();

type FixtureDefinitions = ToolDefinitions

let score = 0;
let disabled: FixtureDefinitions = list_available_plugins_to_install_definitions(
  false,
  true,
  #ListTool,
);
let empty: FixtureDefinitions = list_available_plugins_to_install_definitions(
  true,
  false,
  #ListTool,
);
let recommended: FixtureDefinitions = list_available_plugins_to_install_definitions(
  true,
  true,
  #RecommendationContext,
);
if let #Nil = disabled then
  if let #Nil = empty then
    if let #Nil = recommended then
      score = score + 1
    end;
  end;
end;

let definitions: FixtureDefinitions = list_available_plugins_to_install_definitions(
  true,
  true,
  #ListTool,
);
if let #Cons node = definitions then
  let [definition, tail] = node;
  let [name, exposure, tool_handler, payload, parallel, waits] = definition;
  let [namespace, local_name] = name;
  if namespace == "" && local_name == "list_available_plugins_to_install" && !(parallel)
    && !(waits) then
      if let #Direct = exposure then
        if let #ListAvailablePluginsToInstall = tool_handler then
          if let #FunctionPayload = payload then
            if let #Nil = tail then
              score = score + 10
            end;
          end;
        end;
      end;
    end;
end;

return { .score = score };
