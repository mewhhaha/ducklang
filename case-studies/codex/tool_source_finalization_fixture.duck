const { .text_append } = import "duck:prelude/functional" ();
const { .finalize_tool_sources } = import "./tool_source_finalization.duck" ();
const {} = import "./tool_types.duck" ();

type FixtureDefinition = FinalizationDefinition
type FixtureDefinitions = FinalizationDefinitions
type FixtureSearchName = ToolSourceSearchName
type FixtureSearchNames = ToolSourceSearchNames
type FixtureTexts = ToolSourceTexts
type FixtureFacts = ToolSourceFinalizationFacts

const fixture_definitions: () -> FixtureDefinitions = () => do
  let direct: FixtureDefinition = [
    ["app", "direct"],
    #Direct,
    #Dynamic "direct",
    #FunctionPayload,
    false,
    false,
  ];
  let deferred: FixtureDefinition = [
    ["app", "deferred"],
    #Deferred,
    #Dynamic "deferred",
    #FunctionPayload,
    false,
    false,
  ];
  let hidden: FixtureDefinition = [
    ["app", "hidden"],
    #Hidden,
    #Dynamic "hidden",
    #FunctionPayload,
    false,
    false,
  ];
  let other: FixtureDefinition = [
    ["other", "search"],
    #Deferred,
    #Dynamic "search",
    #FunctionPayload,
    false,
    false,
  ];
  #Cons ([direct, #Cons ([deferred, #Cons ([hidden, #Cons ([other, #Nil])])])])
end;

const fixture_searchable_names: () -> FixtureSearchNames = () => do
  let app: FixtureSearchName = ["app", "deferred"];
  let other: FixtureSearchName = ["other", "search"];
  #Cons ([app, #Cons ([other, #Nil])])
end;

let namespaces: FixtureTexts = #Cons (["app", #Nil]);
let enabled_facts: FixtureFacts = [
  .search_tool_enabled = true,
  .searchable_names = fixture_searchable_names(),
  .direct_model_only_namespaces = namespaces,
];
let current = finalize_tool_sources(fixture_definitions(), enabled_facts);
let trace = "";
let direct_model_only_count = 0;
let deferred_count = 0;
let hidden_count = 0;
let tool_search_valid = false;
let done = false;

loop do
  if let #Cons node = current then
    let [definition, tail] = node;
    let [[namespace, local_name], exposure, tool_handler, payload, _, _] = definition;
    trace = text_append (
      text_append (text_append (text_append (trace, namespace), "."), local_name),
      "|",
    )
    if let #DirectModelOnly = exposure then
      direct_model_only_count = direct_model_only_count + 1 end;
    if let #Deferred = exposure then
      deferred_count = deferred_count + 1
    end;
    if let #Hidden = exposure then
      hidden_count = hidden_count + 1
    end;
    if local_name == "tool_search" then
      if let #ToolSearch = tool_handler then
        if let #ToolSearchPayload = payload then
          tool_search_valid = true
        end;
      end;
    end;
    current = tail
  else
    done = true
  end;

  if done then
    break;
  end;
end;

let score = 0;
let expected = "app.direct|app.deferred|app.hidden|other.search|.tool_search|";
if trace == expected then
  score = score + 1
end;
if direct_model_only_count == 2 && deferred_count == 1 && hidden_count == 1 then
  score = score + 10 end;
if tool_search_valid then
  score = score + 100
end;

let empty_namespaces: FixtureTexts = #Nil;
let disabled_facts: FixtureFacts = [
  .search_tool_enabled = false,
  .searchable_names = fixture_searchable_names(),
  .direct_model_only_namespaces = empty_namespaces,
];
current = finalize_tool_sources(fixture_definitions(), disabled_facts)
let disabled_count = 0;
let disabled_deferred_count = 0;
done = false
loop do
  if let #Cons node = current then
    let [definition, tail] = node;
    let [_, exposure, _, _, _, _] = definition;
    if let #Deferred = exposure then
      disabled_deferred_count = disabled_deferred_count + 1 end;
    disabled_count = disabled_count + 1
    current = tail
  else
    done = true
  end;

  if done then
    break;
  end;
end;

if disabled_count == 4 && disabled_deferred_count == 2 then
  score = score + 1000
end;
return { .score = score };
