const { .create_hosted_web_search_spec } = import "./hosted_web_search_spec.duck" ();

type FixtureDomains = HostedSpecDomains
type FixtureFilters = HostedSpecFilters
type FixtureLocation = HostedSpecUserLocation
type FixtureConfig = HostedSpecConfig
type FixtureTextOption = HostedSpecTextOption

let domains: FixtureDomains = #DomainsCons (["example.com", #DomainsNil]);
let filters: FixtureFilters = [.allowed_domains = #DomainsPresent domains];
let missing_text: FixtureTextOption = #SearchTextMissing;
let location: FixtureLocation = [
  .location_type = #Approximate,
  .country = #SearchTextPresent "US",
  .region = missing_text,
  .city = missing_text,
  .timezone = #SearchTextPresent "America/Los_Angeles"];
let config: FixtureConfig = [
  .filters = #FiltersPresent filters,
  .user_location = #UserLocationPresent location,
  .search_context_size = #ContextSizePresent (#Low)];

let score = 0;
let live = create_hosted_web_search_spec(#Live, #SearchConfigPresent config, #TextAndImage);
if let #LiveTextAndImage preserved = live then
  let config_valid = false;
  if let #SearchConfigPresent preserved_config = preserved then
    if let #FiltersPresent preserved_filters = preserved_config.filters then
      if let #DomainsPresent preserved_domains = preserved_filters.allowed_domains then
        if let #DomainsCons domain_node = preserved_domains then
          let [domain, tail] = domain_node;
          if domain == "example.com" then
            if let #DomainsNil = tail then
              if let #UserLocationPresent preserved_location = preserved_config.user_location then
                if let #SearchTextPresent country = preserved_location.country then
                  if let #SearchTextPresent timezone = preserved_location.timezone then
                    if country == "US" && timezone == "America/Los_Angeles" then
                      if let #ContextSizePresent context_size = preserved_config.search_context_size then
                        if let #Low = context_size then
                          config_valid = true
                        end;
                      end;
                    end;
                  end;
                end;
              end;
            end;
          end;
        end;
      end;
    end;
  end;
  if config_valid then
    score = score + 1
  end;
end;

return { .score = score };
