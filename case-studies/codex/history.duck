const aborted_output = () => do
  history_content_list.singleton(#InputText "aborted")
end;

const missing_output_for =
  (item: NormalizedHistoryItem, values: NormalizedHistoryItems) => if let #FunctionCall call = item then
    let [id, call_id, _, _] = call;

    if has_function_output(values, call_id) then
      #None
    else
      let synthetic_id = if id == "" then "" else text_append ["fco:", id] end;
      let output: NormalizedHistoryOutput = [synthetic_id, call_id, aborted_output()];
      #Some (#FunctionOutput output);
    end;
  else let #CustomCall call = item then
    let [id, call_id, _, _] = call;

    if has_custom_output(values, call_id) then
      #None
    else
      let synthetic_id = if id == "" then "" else text_append ["ctco:", id] end;
      let output: NormalizedHistoryOutput = [synthetic_id, call_id, aborted_output()];
      #Some (#CustomOutput output);
    end;
  else let #LocalShellCall call = item then
    let [id, call_id] = call;

    if call_id == "" || has_function_output(values, call_id) then
      #None
    else
      let synthetic_id = if id == "" then "" else text_append ["fco:", id] end;
      let output: NormalizedHistoryOutput = [synthetic_id, call_id, aborted_output()];
      #Some (#FunctionOutput output);
    end;
  else let #ToolSearchCall call = item then
    let [_, call_id] = call;

    if call_id == "" || has_tool_search_output(values, call_id) then
      #None
    else
      let output: NormalizedHistoryToolSearchOutput = [call_id, "client"];
      #Some (#ToolSearchOutput output);
    end;
  else
    #None
  end;

const ensure_call_outputs_present = (values: NormalizedHistoryItems) => do
  let current = values;
  let normalized_reversed: NormalizedHistoryItems = history_item_list.empty();
  let done = false;

  loop do
    if let #Cons node = current then
      let [item, tail] = node;
      normalized_reversed = history_item_list.prepend(item, normalized_reversed)
      let missing = missing_output_for(item, values);

      if let #Some output = missing then
        normalized_reversed = history_item_list.prepend(output, normalized_reversed)
      end;

      current = tail
    else
      done = true
    end;

    if done then
      break;
    end;
  end;

  history_item_list.reverse normalized_reversed
end;

const keep_history_item =
  (item: NormalizedHistoryItem, values: NormalizedHistoryItems) => if let #FunctionOutput output = item then
    let [_, call_id, _] = output;
    has_function_call(values, call_id)
  else let #CustomOutput output = item then
    let [_, call_id, _] = output;
    has_custom_call(values, call_id)
  else let #ToolSearchOutput output = item then
    let [call_id, execution] = output;

    if execution == "server" || call_id == "" then
      true
    else
      has_tool_search_call(values, call_id)
    end;
  else
    true
  end;

const remove_orphan_outputs = (values: NormalizedHistoryItems) => do
  let current = values;
  let kept_reversed: NormalizedHistoryItems = history_item_list.empty();
  let done = false;

  loop do
    if let #Cons node = current then
      let [item, tail] = node;

      if keep_history_item(item, values) then
        kept_reversed = history_item_list.prepend(item, kept_reversed)
      end;

      current = tail
    else
      done = true
    end;

    if done then
      break;
    end;
  end;

  history_item_list.reverse kept_reversed
end;

const normalize_message_content = (
  content: NormalizedHistoryContent,
  modalities: NormalizedInputModalities,
) => do
  let [supports_images, supports_audio] = modalities;

  if let #InputImage _ = content then
    if supports_images then
      content
    else
      #InputText "image content omitted because you do not support image input"
    end;
  else let #InputAudio _ = content then
    if supports_audio then
      content
    else
      #InputText "audio content omitted because you do not support audio input"
    end;
  else
    content
  end;
end;

const normalize_message_contents = (
  values: NormalizedHistoryContents,
  modalities: NormalizedInputModalities,
) => do
  let current = values;
  let normalized_reversed: NormalizedHistoryContents = history_content_list.empty();
  let done = false;

  loop do
    if let #Cons node = current then
      let [content, tail] = node;
      let normalized = normalize_message_content(content, modalities);

      normalized_reversed = history_content_list.prepend(normalized, normalized_reversed)
      current = tail
    else
      done = true
    end;

    if done then
      break;
    end;
  end;

  history_content_list.reverse normalized_reversed
end;

const normalize_output_content = (
  content: NormalizedHistoryContent,
  modalities: NormalizedInputModalities,
) => do
  let [supports_images, _] = modalities;

  if let #InputImage _ = content then
    if supports_images then
      content
    else
      #InputText "image content omitted because you do not support image input"
    end;
  else
    content
  end;
end;

const normalize_output_contents = (
  values: NormalizedHistoryContents,
  modalities: NormalizedInputModalities,
) => do
  let current = values;
  let normalized_reversed: NormalizedHistoryContents = history_content_list.empty();
  let done = false;

  loop do
    if let #Cons node = current then
      let [content, tail] = node;
      let normalized = normalize_output_content(content, modalities);

      normalized_reversed = history_content_list.prepend(normalized, normalized_reversed)
      current = tail
    else
      done = true
    end;

    if done then
      break;
    end;
  end;

  history_content_list.reverse normalized_reversed
end;

const normalize_item_modalities = (
  item: NormalizedHistoryItem,
  modalities: NormalizedInputModalities,
) => if let #Message message = item then
  let [role, contextual, contents] = message;
  let normalized_message: NormalizedHistoryMessage = [
    role,
    contextual,
    normalize_message_contents(contents, modalities),
  ];
  #Message normalized_message;
else let #AgentMessage contents = item then
  #AgentMessage (normalize_message_contents(contents, modalities))
else let #FunctionOutput output = item then
  let [id, call_id, contents] = output;
  let normalized_output: NormalizedHistoryOutput = [
    id,
    call_id,
    normalize_output_contents(contents, modalities),
  ];
  #FunctionOutput normalized_output;
else let #CustomOutput output = item then
  let [id, call_id, contents] = output;
  let normalized_output: NormalizedHistoryOutput = [
    id,
    call_id,
    normalize_output_contents(contents, modalities),
  ];
  #CustomOutput normalized_output;
else
  item
end;

const strip_unsupported_modalities = (
  values: NormalizedHistoryItems,
  modalities: NormalizedInputModalities,
) => do
  let current = values;
  let normalized_reversed: NormalizedHistoryItems = history_item_list.empty();
  let done = false;

  loop do
    if let #Cons node = current then
      let [item, tail] = node;
      let normalized = normalize_item_modalities(item, modalities);

      normalized_reversed = history_item_list.prepend(normalized, normalized_reversed)
      current = tail
    else
      done = true
    end;

    if done then
      break;
    end;
  end;

  history_item_list.reverse normalized_reversed
end;

const normalize_history =
  (values: NormalizedHistoryItems, modalities: NormalizedInputModalities) => do
    let paired = ensure_call_outputs_present values;
    let without_orphans = remove_orphan_outputs paired;
    strip_unsupported_modalities(without_orphans, modalities)
  end;

const is_instruction_turn = (item: NormalizedHistoryItem) => if let #AgentMessage _ = item then
  true
else let #Message message = item then
  let [role, contextual, _] = message;

  if role == "user" then
    if contextual then
      false
    else
      true
    end;
  else
    false
  end;
else
  false
end;

const is_context_update = (item: NormalizedHistoryItem) => if let #Message message = item then
  let [role, contextual, _] = message;
  contextual && (role == "user" || role == "developer")
else
  false
end;

const trim_context_updates_from_end = (values: NormalizedHistoryItems) => do
  let reversed = history_item_list.reverse values;
  let current = reversed;
  let done = false;

  loop do
    if let #Cons node = current then
      let [item, tail] = node;

      if is_context_update item then
        current = tail
      else
        done = true
      end;
    else
      done = true
    end;

    if done then
      break;
    end;
  end;

  history_item_list.reverse current
end;

const drop_last_user_turns = (values: NormalizedHistoryItems, count: I32) => do
  if count <= 0 then
    values
  else
    let turn_count = history_item_list.count(values, is_instruction_turn);

    if turn_count == 0 then
      values
    else
      let turns_to_keep = turn_count - count;

      if turns_to_keep < 0 then
        turns_to_keep = 0
      end;

      let current = values;
      let position = 0;
      let seen_turns = 0;
      let cut_position = history_item_list.length(values);
      let found_cut = false;
      let done = false;

      loop do
        if let #Cons node = current then
          let [item, tail] = node;

          if is_instruction_turn item then
            if seen_turns == turns_to_keep then
              cut_position = position
              found_cut = true
              done = true
            else
              seen_turns = seen_turns + 1
            end;
          end;

          if done then
            ()
          else
            position = position + 1
            current = tail
          end;
        else
          done = true
        end;

        if done then
          break;
        end;
      end;

      if found_cut then
        trim_context_updates_from_end(history_item_list.take(cut_position, values))
      else
        values
      end;
    end;
  end;
end;

const estimate_content_bytes =
  (content: NormalizedHistoryContent) => if let #InputText text = content then
    text_length text + 24
  else let #OutputText text = content then
    text_length text + 25
  else let #InputImage image = content then
    let [url, _] = image;
    text_length url + 32
  else let #InputAudio url = content then
    text_length url + 32
  else let #Encrypted encrypted = content then
    (text_length encrypted * 9 + 15) / 16
  else
    0
  end;

const estimate_encrypted_reasoning_bytes = (encrypted: Text) => do
  let bytes = (text_length encrypted * 3) / 4 - 650;

  if bytes < 0 then
    0
  else
    bytes
  end;
end;

const estimate_contents_bytes = (values: NormalizedHistoryContents) => do
  history_content_list.fold_i32(
    values,
    2,
    (total: I32, content: NormalizedHistoryContent) => total + estimate_content_bytes content + 1,
  )
end;

const estimate_item_bytes = (item: NormalizedHistoryItem) => if let #Message message = item then
  let [role, _, contents] = message;
  text_length role + estimate_contents_bytes contents + 32
else let #AgentMessage contents = item then
  estimate_contents_bytes contents + 32
else let #Reasoning encrypted = item then
  estimate_encrypted_reasoning_bytes encrypted
else let #FunctionCall call = item then
  let [id, call_id, name, arguments] = call;
  text_length id + text_length call_id + text_length name + text_length arguments + 72
else let #FunctionOutput output = item then
  let [id, call_id, contents] = output;
  text_length id + text_length call_id + estimate_contents_bytes contents + 56
else let #CustomCall call = item then
  let [id, call_id, name, input] = call;
  text_length id + text_length call_id + text_length name + text_length input + 72
else let #CustomOutput output = item then
  let [id, call_id, contents] = output;
  text_length id + text_length call_id + estimate_contents_bytes contents + 56
else let #LocalShellCall call = item then
  let [id, call_id] = call;
  text_length id + text_length call_id + 48
else let #ToolSearchCall call = item then
  let [id, call_id] = call;
  text_length id + text_length call_id + 48
else let #ToolSearchOutput output = item then
  let [call_id, execution] = output;
  text_length call_id + text_length execution + 48
else let #Compaction encrypted = item then
  estimate_encrypted_reasoning_bytes encrypted
else
  2
end;

const estimate_history_tokens: [Text, NormalizedHistoryItems] -> I32 = (base_instructions,
  values) => do
    let bytes = text_length base_instructions;
    bytes = history_item_list.fold_i32(
      values,
      bytes,
      (total: I32, item: NormalizedHistoryItem) => total + estimate_item_bytes item,
    )

    if bytes <= 0 then
      0
    else
      (bytes + 3) / 4
    end;
  end;

return {
  .normalize_history,
  .drop_last_user_turns,
  .estimate_history_tokens,
};
