  let current = values;
  let matched = false;
  let done = false;

  loop do
    if let #Cons node = current then
      let [item, tail] = node;
      let candidate = tool_search_output_call_id item;
      let candidate_matches = if let #Some existing_call_id = candidate then
        existing_call_id == call_id
      else
        false
      end;

      if candidate_matches then
        matched = true
        done = true
      else
        current = tail
      end;
    else
      done = true
    end;

    if done then
      break;
