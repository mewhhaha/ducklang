module () where

const { .text_append, .text_get, .text_length, .text_slice } = import "duck:prelude/runtime" ();

const normalize_code_mode_identifier: Text -> Text = (name: Text) => do
  let normalized: Text = "";
  for index in 0..text_length name do
    let byte = text_get [name, index];
    let valid = false;
    if byte == 95 then
      valid = true
    else byte == 36 then
      valid = true
    else byte >= 65 && byte <= 90 then
      valid = true
    else byte >= 97 && byte <= 122 then
      valid = true
    else index > 0 && byte >= 48 && byte <= 57 then
      valid = true
    end;

    if valid then
      normalized = text_append [normalized, text_slice [name, index, index + 1]]
    else byte < 128 || byte > 191 then
      normalized = text_append [normalized, "_"]
    end;
  end
  if normalized == "" then "_" else normalized end;
end;

return { .normalize_code_mode_identifier };
