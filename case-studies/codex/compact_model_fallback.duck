module () where

const {} = import "./compact_model_fallback_types.duck" ();
const { .compaction_implementation_tag, .compaction_reason_tag } =
  import "./compaction_tags.duck" ();

type ModelFallbackError = CompactionModelError
type ModelFallbackTextOption = CompactionFallbackTextOption
type ModelFallbackTelemetry = CompactionFallbackTelemetry
type ModelFallbackReason = CompactionReason
type ModelFallbackImplementation = CompactionImplementation

const should_retry_with_current_model: ModelFallbackError -> Bool = error => do
  if let #InvalidRequest _ = error then
    true
  else let #UnexpectedStatus _ = error then
    true
  else let #ContextWindowExceeded = error then
    true
  else let #UsageLimitReached _ = error then
    true
  else let #ServerOverloaded = error then
    true
  else let #InternalServerError = error then
    true
  else let #RetryLimit _ = error then
    true
  else
    false
  end;
end;

const model_fallback_telemetry: (
  Text,
  Text,
  ModelFallbackReason,
  ModelFallbackImplementation,
  ModelFallbackTextOption,
) -> ModelFallbackTelemetry = (
  previous_model,
  current_model,
  reason,
  implementation,
  fallback_error,
) => do
  let outcome = if let #None = fallback_error then "succeeded" else "failed" end;

  [
    .metric = "codex.compaction.model_fallback",
    .increment = 1,
    .previous_model = previous_model,
    .current_model = current_model,
    .reason = compaction_reason_tag reason,
    .implementation = compaction_implementation_tag implementation,
    .outcome = outcome,
    .fallback_error = fallback_error,
    .message = "previous-model compaction failed; retried with current model",
  ]
end;

return {
  .should_retry_with_current_model,
  .model_fallback_telemetry,
};
