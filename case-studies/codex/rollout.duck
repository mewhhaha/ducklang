module () where

const { .list, .option } = import "duck:prelude/functional" ();
const rollout_types_module = import "./rollout_types.duck";

type PersistHistoryMode = RolloutHistoryMode
type PersistResponse = RolloutResponse
type PersistCompletedItem = RolloutCompletedItem
type PersistEvent = RolloutEvent
type PersistItem = RolloutItem
type PersistItems = RolloutItems

const rollout_items = comptime list PersistItem;

const response_is_persisted = (response: PersistResponse) => do
  if let #AdditionalTools = response then
    false
  else let #CompactionTrigger = response then
    false
  else let #Other = response then
    false
  else
    true
  end;
end;

const response_is_persisted_for_memories = (response: PersistResponse) => do
  if let #Message message = response then
    let [role, _] = message;
    role != "developer"
  else let #AgentMessage = response then
    true
  else let #FunctionCall = response then
    true
  else let #FunctionOutput = response then
    true
  else let #ToolCall = response then
    true
  else let #ToolOutput = response then
    true
  else let #WebSearch = response then
    true
  else
    false
  end;
end;

const completed_item_is_persisted = (item: PersistCompletedItem, mode: PersistHistoryMode) => do
  if let #Paginated = mode then
    true
  else let #Plan = item then
    true
  else let #Sleep = item then
    true
  else
    false
  end;
end;

const event_is_persisted = (event: PersistEvent, mode: PersistHistoryMode) => do
  if let #ItemCompleted completed = event then
    let [_, item] = completed;
    completed_item_is_persisted(item, mode)
  else let #Durable = event then
    true
  else let #ThreadRolledBack = event then
    true
  else let #TurnStarted _ = event then
    true
  else let #TurnComplete _ = event then
    true
  else let #TurnAborted _ = event then
    true
  else let #LegacyOnly = event then
    if let #Legacy = mode then true else false end;
  else
    false
  end;
end;

const is_persisted_rollout_item = (item: PersistItem, mode: PersistHistoryMode) => do
  if let #Response response = item then
    response_is_persisted response
  else let #Event event = item then
    event_is_persisted(event, mode)
  else
    true
  end;
end;

const persisted_rollout_items = (values: PersistItems, mode: PersistHistoryMode) => do
  rollout_items.filter(values, (item: PersistItem) => is_persisted_rollout_item(item, mode))
end;

return {
  .response_is_persisted,
  .response_is_persisted_for_memories,
  .event_is_persisted,
  .is_persisted_rollout_item,
  .persisted_rollout_items,
};
