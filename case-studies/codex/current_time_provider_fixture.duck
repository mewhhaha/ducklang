module () where

const current_time_module = import "./current_time.duck";
const { .resolve_current_time_provider } = current_time_module();

let score = 0;
if let #SystemProvider = resolve_current_time_provider(#System, false) then
  score = score + 1 end;
if let #ExternalProvider = resolve_current_time_provider(#External, true) then
  score = score + 10
end;
if let #MissingExternalProvider message = resolve_current_time_provider(#External, false) then
  if message
    == "features.current_time_reminder.clock_source is external, but no external current-time provider is available" then
      score = score + 100
    end;
end;

return { .score = score };
