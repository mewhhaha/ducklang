module () where

const {} = import "./audio_preparation_types.duck" ();
const {} = import "./history_types.duck" ();

type AudioContentNode = ListNode HistoryContent
type AudioResponseNode = ListNode HistoryItem

type AudioContentRewriteStatus =
  | #AudioContentRewriteValid
  | #AudioContentRewriteInvalid AudioRewriteFailure

type AudioContentRewrite = [
  HistoryContents,
  AudioPreparationResults,
  AudioContentRewriteStatus,
  I32]

const audio_failure_placeholder: I32 -> Text = status_code => do
  if status_code == 3 then
    "audio content omitted because its format is not supported; use wav, mp3, m4a, webm, or ogg"
  else status_code == 4 then
    "audio content omitted because it exceeded the supported size limit; use a smaller audio file"
  else
    "audio content omitted because it could not be processed"
  end;
end;

const rewrite_audio_contents: [HistoryContents, AudioPreparationResults, I32] -> AudioContentRewrite =
  (
    values,
    results,
    first_audio_index,
  ) => do
    let current = values;
    let remaining_results = results;
    let reversed: List HistoryContent = #Nil;
    let status: AudioContentRewriteStatus = #AudioContentRewriteValid;
    let audio_index = first_audio_index;

    loop do
      if let #AudioContentRewriteInvalid _ = status then
        break;
      end;
      if let #Cons node = current then
        let [content, tail] = node;
        let rewritten = content;

        if let #InputAudio _ = content then
          if let #AudioResultsCons result_node = remaining_results then
            let [result, remaining] = result_node;
            let [result_status_code, result_url, _, _, _, _] = result;
            remaining_results = remaining
            if result_status_code == 0 then
              rewritten = #InputAudio result_url
              audio_index = audio_index + 1
            else result_status_code >= 1 && result_status_code <= 4 then
              rewritten = #InputText (audio_failure_placeholder result_status_code)
              audio_index = audio_index + 1
            else
              status = #AudioContentRewriteInvalid (
                #InvalidAudioPreparationStatus result_status_code
              )
            end;
          else
            status = #AudioContentRewriteInvalid (#MissingAudioPreparation audio_index)
          end;
        end;

        if let #AudioContentRewriteValid = status then
          let rewritten_node: AudioContentNode = [rewritten, reversed];
          reversed = #Cons rewritten_node
          current = tail
        end;
      else
        break;
      end;
    end;

    let rewritten_values: List HistoryContent = #Nil;
    if let #AudioContentRewriteValid = status then
      loop do
        if let #Cons node = reversed then
          let [content, tail] = node;
          let rewritten_node: AudioContentNode = [content, rewritten_values];
          rewritten_values = #Cons rewritten_node
          reversed = tail
        else
          break;
        end;
      end;
    end;

    [rewritten_values, remaining_results, status, audio_index]
  end;

const apply_audio_preparation_results: [HistoryItems, AudioPreparationResults] -> AudioRewriteResult =
  (
    responses,
    results,
  ) => do
    let current = responses;
    let remaining_results = results;
    let reversed: List HistoryItem = #Nil;
    let status: AudioContentRewriteStatus = #AudioContentRewriteValid;
    let audio_index = 0;

    loop do
      if let #AudioContentRewriteInvalid _ = status then
        break;
      end;
      if let #Cons node = current then
        let [response, tail] = node;
        let rewritten = response;

        if let #Message message = response then
          let [role, developer, contents] = message;
          let rewrite = rewrite_audio_contents(contents, remaining_results, audio_index);
          let [rewritten_contents, remaining, next_status, next_audio_index] = rewrite;
          remaining_results = remaining
          status = next_status
          audio_index = next_audio_index
          if let #AudioContentRewriteValid = status then
            rewritten = #Message ([role, developer, rewritten_contents])
          end;
        else let #FunctionOutput output = response then
          let [identifier, call_id, contents] = output;
          let rewrite = rewrite_audio_contents(contents, remaining_results, audio_index);
          let [rewritten_contents, remaining, next_status, next_audio_index] = rewrite;
          remaining_results = remaining
          status = next_status
          audio_index = next_audio_index
          if let #AudioContentRewriteValid = status then
            rewritten = #FunctionOutput ([identifier, call_id, rewritten_contents])
          end;
        else let #CustomOutput output = response then
          let [identifier, call_id, contents] = output;
          let rewrite = rewrite_audio_contents(contents, remaining_results, audio_index);
          let [rewritten_contents, remaining, next_status, next_audio_index] = rewrite;
          remaining_results = remaining
          status = next_status
          audio_index = next_audio_index
          if let #AudioContentRewriteValid = status then
            rewritten = #CustomOutput ([identifier, call_id, rewritten_contents])
          end;
        end;

        if let #AudioContentRewriteValid = status then
          let rewritten_node: AudioResponseNode = [rewritten, reversed];
          reversed = #Cons rewritten_node
          current = tail
        end;
      else
        break;
      end;
    end;

    if let #AudioContentRewriteInvalid failure = status then
      #RejectedAudioRewrite failure
    else let #AudioResultsCons _ = remaining_results then
      let extra_count = 0;
      let counting = remaining_results;
      loop do
        if let #AudioResultsCons node = counting then
          let [_, tail] = node;
          extra_count = extra_count + 1
          counting = tail
        else
          break;
        end;
      end;
      #RejectedAudioRewrite (#ExtraAudioPreparations extra_count)
    else
      let rewritten_responses: List HistoryItem = #Nil;
      loop do
        if let #Cons node = reversed then
          let [response, tail] = node;
          let rewritten_node: AudioResponseNode = [response, rewritten_responses];
          rewritten_responses = #Cons rewritten_node
          reversed = tail
        else
          break;
        end;
      end;
      #PreparedAudioResponses rewritten_responses
    end;
  end;

return { .apply_audio_preparation_results };
