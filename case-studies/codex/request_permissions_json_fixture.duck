module () where

const { .parse_request_permissions_args, .parse_request_permissions_environment_id } =
  import "./request_permissions_json.duck" ();

let document =
  "{\"environmentId\":\"remote\",\"reason\":\"read inputs\",\"permissions\":{\"network\":{\"enabled\":false},\"file_system\":{\"read\":[\"docs\"],\"write\":[\"/tmp/output\"]}}}";
let score = 0;

if let #ParsedEnvironmentId environment_id = parse_request_permissions_environment_id document then
  if let #Some value = environment_id then
    if value == "remote" then
      score = score + 1
    end;
  end;
end;

if let #Parsed args = parse_request_permissions_args(document, "/workspace") then
  if let #Some environment_id = args.environment_id then
    if environment_id == "remote" then
      if let #Some reason = args.reason then
        if reason == "read inputs" then
          if let #NetworkPresent network = args.permissions.network then
            if let #Some enabled = network.enabled then
              if !(enabled) then
                if let #FileSystemPresent file_system = args.permissions.file_system then
                  if let #Cons read_node = file_system.entries then
                    let [read, tail] = read_node;
                    if read.path == "/workspace/docs" then
                      if let #Read = read.access then
                        if let #Cons write_node = tail then
                          let [write, finish] = write_node;
                          if write.path == "/tmp/output" then
                            if let #Write = write.access then
                              if let #Nil = finish then
                                score = score + 10
                              end;
                            end;
                          end;
                        end;
                      end;
                    end;
                  end;
                end;
              end;
            end;
          end;
        end;
      end;
    end;
  end;
end;

return { .score = score };
