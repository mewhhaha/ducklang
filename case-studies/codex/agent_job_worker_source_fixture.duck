module () where

const { .agent_job_worker_source_enabled } = import "./agent_job_worker_source.duck" ();

let score = 0;
if agent_job_worker_source_enabled "agent_job:42" then
  score = score + 1
end;
if !(agent_job_worker_source_enabled "agent:42") then
  score = score + 10
end;

return { .score = score };
