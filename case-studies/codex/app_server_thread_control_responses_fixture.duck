const { .json_object_get } = import "duck:prelude/json/values" ();
const { .materialize_thread_elicitation_response, .materialize_thread_name_updated_notification } =
  import "./app_server_thread_controls.duck" ();

let score = 0;
let resumed = materialize_thread_elicitation_response 0i64;
if let #Object fields = resumed then
  let count_valid = false;
  let count_lookup = json_object_get("count", fields);
  if let #Found value = count_lookup then
    if let #Number count = value then
      count_valid = count == "0" end;
  end;
  let paused_valid = false;
  let paused_lookup = json_object_get("paused", fields);
  if let #Found value = paused_lookup then
    if let #Bool paused = value then
      if paused then () else
        paused_valid = true end;
    end;
  end;
  if count_valid && paused_valid then
    score = score + 1
  end;
end;

let notification = materialize_thread_name_updated_notification("thread-1", "Work");
if let #Object fields = notification then
  let id_valid = false;
  let id_lookup = json_object_get("threadId", fields);
  if let #Found value = id_lookup then
    if let #String id = value then
      id_valid = id == "thread-1" end;
  end;
  let name_valid = false;
  let name_lookup = json_object_get("threadName", fields);
  if let #Found value = name_lookup then
    if let #String name = value then
      name_valid = name == "Work" end;
  end;
  if id_valid && name_valid then
    score = score + 10
  end;
end;

return { .score = score };
