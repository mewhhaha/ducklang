module () where

const agent_types_module = import "./agent_types.duck";
const { .agent_status_json } = import "./agent_status_json.duck" ();

type FixtureStatus = AgentStatus
type FixtureTextOption = AgentTextOption

let score = 0;
let no_message: FixtureTextOption = #None;
let pending: FixtureStatus = #PendingInit;
let running: FixtureStatus = #Running;
let interrupted: FixtureStatus = #Interrupted;
let completed: FixtureStatus = #Completed no_message;
let errored: FixtureStatus = #Errored "bad \"input\"";
let shutdown: FixtureStatus = #Shutdown;
let missing: FixtureStatus = #NotFound;

if agent_status_json pending == "\"pending_init\"" then
  score = score + 1
end;
if agent_status_json running == "\"running\"" then
  score = score + 10
end;
if agent_status_json interrupted == "\"interrupted\"" then
  score = score + 100
end;
if agent_status_json completed == "{\"completed\":null}" then
  score = score + 1000
end;
if agent_status_json errored == "{\"errored\":\"bad \\\"input\\\"\"}" then
  score = score + 10000 end;
if agent_status_json shutdown == "\"shutdown\"" then
  score = score + 100000
end;
if agent_status_json missing == "\"not_found\"" then
  score = score + 1000000
end;

return { .score = score };
