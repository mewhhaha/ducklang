module () where

const { .list } = import "duck:prelude/functional" ();
const { .parse_cli } = import "./cli.duck" ();
const {} = import "./cli_types.duck" ();

type FixtureArgs = CodexCliArgs
type FixturePlan = CodexCliPlan

const args = comptime list Text;
let input: FixtureArgs = args.prepend(
  "app-server",
  args.prepend("proxy", args.prepend("--sock", args.singleton("codex.sock"))),
);
let plan: FixturePlan = parse_cli input;
let score = 0;

if let #ManageAppServer command = plan then
  if let #ProxyAppServer socket_path = command then
    if let #Some path = socket_path then
      if path == "codex.sock" then
        score = 1
      end;
    end;
  end;
end;

return { .score = score };
