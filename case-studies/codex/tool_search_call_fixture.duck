module () where

const {} = import "./tool_search_types.duck" ();
const { .plan_tool_search_call, .tool_search_sources } = import "./tool_search_call.duck" ();
const { .searchable_function } = import "./tool_search_value.duck" ();

type FixtureInfo = ToolSearchInfo
type FixtureInfos = ToolSearchInfos
type FixtureSource = ToolSearchSourceInfo
type FixtureSources = ToolSearchSourceInfos
type FixtureSpec = ToolSpec

let source: FixtureSource = [.name = "calendar", .description = #Some "Calendar tools."];
let spec: FixtureSpec = [
  ["", "create_event"],
  #FunctionSpec,
  "Create calendar events.",
  "{}",
  #ToolOutputSchemaMissing,
  false,
];
let values: FixtureInfos = searchable_function(spec, #SearchSourcePresent source);

let score = 0;
let valid = plan_tool_search_call(
  #SearchToolRequest [.query = " calendar ", .limit = #SearchLimitMissing],
  values,
);
if let #ReturnTools output = valid then
  if output.status == "completed" && output.execution == "client" then
    if let #Cons _ = output.tools then
      score = score + 1
    end;
  end;
end;

let empty = plan_tool_search_call(
  #SearchToolRequest [.query = "  ", .limit = #SearchLimitMissing],
  values,
);
if let #RejectRequest message = empty then
  if message == "query must not be empty" then
    score = score + 10
  end;
end;

let zero = plan_tool_search_call(
  #SearchToolRequest [.query = "calendar", .limit = #SearchLimitPresent 0],
  values,
);
if let #RejectRequest message = zero then
  if message == "limit must be greater than zero" then
    score = score + 100
  end;
end;

let unsupported = plan_tool_search_call(#UnsupportedToolSearchPayload, values);
if let #Fatal message = unsupported then
  if message == "tool_search handler received unsupported payload" then
    score = score + 1000 end;
end;

let searchable_sources: FixtureSources = tool_search_sources values;
if let #Cons source_node = searchable_sources then
  let [_, source_tail] = source_node;
  if let #Nil = source_tail then
    score = score + 10000
  end;
end;

return { .score = score };
