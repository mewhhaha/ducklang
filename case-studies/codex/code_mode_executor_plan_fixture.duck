const { .build_code_mode_executor_plan } = import "./code_mode_executor_plan.duck" ();
const {} = import "./tool_types.duck" ();

type FixtureRuntime = CodeModePlanRuntime
type FixtureRuntimes = CodeModePlanRuntimes
type FixtureTexts = CodeModePlanTexts
type FixtureDefinitions = CodeModePlanDefinitions
type FixtureNamespaces = CodeModePlanNamespaceDescriptions
type FixtureFacts = CodeModePlanFacts
type FixturePlan = CodeModeExecutorPlan

let zeta: FixtureRuntime = [["", "zeta"], #Direct, #CodeFunctionSpec, "Zeta tool", ""];
let beta: FixtureRuntime = [
  ["beta", "lookup"],
  #Direct,
  #CodeFunctionSpec,
  "Beta lookup",
  "Beta tools",
];
let alpha_zulu: FixtureRuntime = [
  ["alpha", "zulu"],
  #Direct,
  #CodeFunctionSpec,
  "Alpha zulu",
  "",
];
let alpha_first: FixtureRuntime = [
  ["alpha", "alpha"],
  #Direct,
  #CodeFunctionSpec,
  "Alpha first",
  "Alpha tools",
];
let deferred: FixtureRuntime = [
  ["search", "lookup"],
  #Deferred,
  #CodeFunctionSpec,
  "Search lookup",
  "Search tools",
];
let hidden: FixtureRuntime = [["", "hidden"], #Hidden, #CodeFunctionSpec, "Hidden", ""];
let direct_model_only: FixtureRuntime = [
  ["direct", "only"],
  #DirectModelOnly,
  #CodeFunctionSpec,
  "Direct only",
  "Direct tools",
];
let excluded: FixtureRuntime = [
  ["excluded", "lookup"],
  #Direct,
  #CodeFunctionSpec,
  "Excluded",
  "Excluded tools",
];
let tool_search: FixtureRuntime = [
  ["", "tool_search"],
  #Direct,
  #CodeToolSearchSpec,
  "Search tools",
  "",
];
let exec: FixtureRuntime = [["", "exec"], #Direct, #CodeFreeformSpec, "Code executor", ""];
let wait: FixtureRuntime = [["", "wait"], #Direct, #CodeFunctionSpec, "Wait", ""];
let runtimes: FixtureRuntimes = #CodeRuntimesCons (
  [
    zeta,
    #CodeRuntimesCons (
      [
        beta,
        #CodeRuntimesCons (
          [
            alpha_zulu,
            #CodeRuntimesCons (
              [
                alpha_first,
                #CodeRuntimesCons (
                  [
                    deferred,
                    #CodeRuntimesCons (
                      [
                        hidden,
                        #CodeRuntimesCons (
                          [
                            direct_model_only,
                            #CodeRuntimesCons (
                              [
                                excluded,
                                #CodeRuntimesCons (
                                  [
                                    tool_search,
                                    #CodeRuntimesCons (
                                      [exec, #CodeRuntimesCons ([wait, #CodeRuntimesNil])]
                                    ),
                                  ]
                                ),
                              ]
                            ),
                          ]
                        ),
                      ]
                    ),
                  ]
                ),
              ]
            ),
          ]
        ),
      ]
    ),
  ]
);
let excluded_namespaces: FixtureTexts = #CodeTextsCons (["excluded", #CodeTextsNil]);
let facts: FixtureFacts = [
  .mode = #CodeModeOnly,
  .deferred_guidance = true,
  .excluded_namespaces = excluded_namespaces,
];
let plan: FixturePlan = build_code_mode_executor_plan(runtimes, facts);
let score = 0;

let executor_trace = "";
let names = plan.executor_names;
let done = false;
loop do
  if let #CodeTextsCons node = names then
    let [name, tail] = node;
    executor_trace = executor_trace <> name <> "|"
    names = tail
  else
    done = true
  end;
  if done then
    break;
  end;
end;
if plan.code_mode_only && executor_trace == "exec|wait|" then
  score = score + 1
end;

let nested_trace = "";
let nested = plan.nested_runtimes;
done = false
loop do
  if let #CodeRuntimesCons node = nested then
    let [runtime, tail] = node;
    let [[namespace, local_name], _, _, _, _] = runtime;
    nested_trace = nested_trace <> namespace <> "." <> local_name <> "|"
    nested = tail
  else
    done = true
  end;
  if done then
    break;
  end;
end;
if nested_trace
  == ".zeta|beta.lookup|alpha.zulu|alpha.alpha|search.lookup|.tool_search|.exec|.wait|" then
    score = score + 10
  end;

let enabled_trace = "";
let enabled: FixtureDefinitions = plan.enabled_tools;
done = false
loop do
  if let #CodeDefinitionsCons node = enabled then
    let [[name, _, _, _], tail] = node;
    enabled_trace = enabled_trace <> name <> "|"
    enabled = tail
  else
    done = true
  end;
  if done then
    break;
  end;
end;
if enabled_trace == "zeta|alpha__alpha|alpha__zulu|beta__lookup|" then
  score = score + 100
end;

let deferred_trace = "";
let deferred_definitions: FixtureDefinitions = plan.deferred_tools;
done = false
loop do
  if let #CodeDefinitionsCons node = deferred_definitions then
    let [[name, _, _, _], tail] = node;
    deferred_trace = deferred_trace <> name <> "|"
    deferred_definitions = tail
  else
    done = true
  end;
  if done then
    break;
  end;
end;
if deferred_trace == "search__lookup|" then
  score = score + 1000
end;

let namespace_trace = "";
let namespaces: FixtureNamespaces = plan.namespace_descriptions;
done = false
loop do
  if let #CodeNamespacesCons node = namespaces then
    let [[namespace, description], tail] = node;
    namespace_trace = namespace_trace <> namespace <> ":" <> description <> "|"
    namespaces = tail
  else
    done = true
  end;
  if done then
    break;
  end;
end;
if namespace_trace == "alpha:Alpha tools|beta:Beta tools|" then
  score = score + 10000
end;

let direct_facts: FixtureFacts = [
  .mode = #DirectTools,
  .deferred_guidance = true,
  .excluded_namespaces = excluded_namespaces,
];
let direct_plan: FixturePlan = build_code_mode_executor_plan(runtimes, direct_facts);
if !(direct_plan.code_mode_only) then
  if let #CodeTextsNil = direct_plan.executor_names then
    if let #CodeRuntimesNil = direct_plan.nested_runtimes then
      if let #CodeDefinitionsNil = direct_plan.enabled_tools then
        score = score + 100000
      end;
    end;
  end;
end;

let no_guidance_facts: FixtureFacts = [
  .mode = #CodeMode,
  .deferred_guidance = false,
  .excluded_namespaces = excluded_namespaces,
];
let no_guidance: FixturePlan = build_code_mode_executor_plan(runtimes, no_guidance_facts);
let nested_kept = false;
let no_guidance_nested = no_guidance.nested_runtimes;
done = false
loop do
  if let #CodeRuntimesCons node = no_guidance_nested then
    let [runtime, tail] = node;
    let [[namespace, local_name], _, _, _, _] = runtime;
    if namespace == "search" && local_name == "lookup" then
      nested_kept = true
    end;
    no_guidance_nested = tail
  else
    done = true
  end;
  if done then
    break;
  end;
end;
if !(no_guidance.code_mode_only) && nested_kept then
  if let #CodeDefinitionsNil = no_guidance.deferred_tools then
    score = score + 1000000
  end;
end;

return { .score = score };
