module () where

const {} = import "./tool_types.duck" ();
const {
  .list_mcp_resource_templates_definition,
  .list_mcp_resources_definition,
  .read_mcp_resource_definition,
} = import "./mcp_resource_registration.duck" ();

let score = 0;
let [list_name, list_exposure, list_handler, list_payload, list_parallel, list_waits] =
  list_mcp_resources_definition();
let [list_namespace, list_local_name] = list_name;
let list_exposure_valid = if let #Direct = list_exposure then true else false end;
let list_handler_valid = if let #ListMcpResources = list_handler then true else false end;
let list_payload_valid = if let #FunctionPayload = list_payload then true else false end;
if list_namespace == "" && list_local_name == "list_mcp_resources" && list_exposure_valid
  && list_handler_valid && list_payload_valid && list_parallel && !(
    list_waits
  ) then
    score = score + 1
  end;

let [template_name, _, template_handler, _, template_parallel, template_waits] =
  list_mcp_resource_templates_definition();
let [template_namespace, template_local_name] = template_name;
let template_handler_valid = if let #ListMcpResourceTemplates = template_handler then true else
  false end;
if template_namespace == "" && template_local_name == "list_mcp_resource_templates"
  && template_handler_valid && template_parallel && !(
    template_waits
  ) then
    score = score + 10
  end;

let [read_name, _, read_handler, _, read_parallel, read_waits] = read_mcp_resource_definition();
let [read_namespace, read_local_name] = read_name;
let read_handler_valid = if let #ReadMcpResource = read_handler then true else false end;
if read_namespace == "" && read_local_name == "read_mcp_resource" && read_handler_valid
  && read_parallel && !(
    read_waits
  ) then
    score = score + 100
  end;

return { .score = score };
