module () where

const {
  .json_null,
  .json_number,
  .json_object,
  .json_object_empty,
  .json_object_prepend,
  .json_string,
} =
  import "duck:prelude/json/values" ();
const { .decode_test_sync_value } = import "./test_sync_value.duck" ();

let barrier_fields = json_object_prepend(
  "id",
  json_string "shared",
  json_object_prepend(
    "participants",
    json_number "2",
    json_object_prepend("ignored", json_string "allowed", json_object_empty()),
  ),
);
let fields = json_object_prepend(
  "sleep_before_ms",
  json_number "0002",
  json_object_prepend(
    "sleep_after_ms",
    json_null(),
    json_object_prepend(
      "barrier",
      json_object barrier_fields,
      json_object_prepend("unknown", json_string "ignored", json_object_empty()),
    ),
  ),
);
let score = 0;

if let #Parsed args = decode_test_sync_value(json_object fields) then
  if let #SyncDurationPresent before = args.sleep_before_ms then
    if before == "2" then
      if let #SyncDurationMissing = args.sleep_after_ms then
        if let #SyncBarrierPresent barrier = args.barrier then
          if barrier.id == "shared" && barrier.participants == "2" && barrier.timeout_ms
            == "1000" then
              score = score + 1 end;
        end;
      end;
    end;
  end;
end;

let maximum_fields = json_object_prepend(
  "sleep_after_ms",
  json_number "18446744073709551615",
  json_object_empty(),
);
if let #Parsed args = decode_test_sync_value(json_object maximum_fields) then
  if let #SyncDurationPresent maximum = args.sleep_after_ms then
    if maximum == "18446744073709551615" then
      score = score + 10
    end;
  end;
end;

let overflow_fields = json_object_prepend(
  "sleep_before_ms",
  json_number "18446744073709551616",
  json_object_empty(),
);
if let #ParseFailed message = decode_test_sync_value(json_object overflow_fields) then
  if message == "failed to parse function arguments: sleep_before_ms number exceeds U64" then
    score = score + 100
  end;
end;

let duplicate_fields = json_object_prepend(
  "sleep_before_ms",
  json_number "1",
  json_object_prepend("sleep_before_ms", json_number "2", json_object_empty()),
);
if let #ParseFailed message = decode_test_sync_value(json_object duplicate_fields) then
  if message == "failed to parse function arguments: sleep_before_ms must appear at most once" then
    score = score + 1000 end;
end;

return { .score = score };
