module () where

const { .list } = import "duck:prelude/functional" ();
const { .parse_cli } = import "./cli.duck" ();
const {} = import "./cli_types.duck" ();

type FixtureArgs = CodexCliArgs
type FixturePlan = CodexCliPlan

const args = comptime list Text;
let input: FixtureArgs = args.prepend("debug", args.prepend("models", args.singleton("--bundled")));
let plan: FixturePlan = parse_cli input;
let score = 0;

if let #ManageDebug command = plan then
  if let #DebugModels bundled = command then
    if bundled then
      score = 1
    end;
  end;
end;

return { .score = score };
