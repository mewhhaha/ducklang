module () where

const {} = import "./compaction_types.duck" ();

type CompactionTagsTrigger = CompactionTrigger
type CompactionTagsReason = CompactionReason
type CompactionTagsImplementation = CompactionImplementation
type CompactionTagsPhase = CompactionPhase

const compaction_trigger_tag: CompactionTagsTrigger -> Text = trigger => do
  if let #Manual = trigger then "manual" else "auto" end;
end;

const compaction_reason_tag: CompactionTagsReason -> Text = reason => do
  if let #UserRequested = reason then
    "user_requested"
  else let #ContextLimit = reason then
    "context_limit"
  else let #ModelDownshift = reason then
    "model_downshift"
  else
    "comp_hash_changed"
  end;
end;

const compaction_implementation_tag: CompactionTagsImplementation -> Text = implementation => do
  if let #Responses = implementation then
    "responses"
  else let #ResponsesCompactionV2 = implementation then
    "responses_compaction_v2"
  else
    "responses_compact"
  end;
end;

const compaction_phase_tag: CompactionTagsPhase -> Text = phase => do
  if let #StandaloneTurn = phase then
    "standalone_turn"
  else let #PreTurn = phase then
    "pre_turn"
  else
    "mid_turn"
  end;
end;

return {
  .compaction_trigger_tag,
  .compaction_reason_tag,
  .compaction_implementation_tag,
  .compaction_phase_tag,
};
