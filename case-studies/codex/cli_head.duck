module () where

const {} = import "./cli_types.duck" ();

type CliHeadArgs = CodexCliArgs
type CliHeadCommand = CodexCliCommand

const classify_cli_head: CliHeadArgs -> CliHeadCommand = (args: CliHeadArgs) => do
  if let #Cons node = args then
    let [name, tail] = node;
    if name == "exec" || name == "e" then
      #Exec tail
    else name == "review" then
      #Review tail
    else name == "login" then
      #Login tail
    else name == "logout" then
      #Logout tail
    else name == "mcp" then
      #Mcp tail
    else name == "plugin" then
      #Plugin tail
    else name == "mcp-server" then
      #McpServer tail
    else name == "app-server" then
      #AppServer tail
    else name == "remote-control" then
      #RemoteControl tail
    else name == "app" then
      #App tail
    else name == "completion" then
      #Completion tail
    else name == "update" then
      #Update tail
    else name == "doctor" then
      #Doctor tail
    else name == "sandbox" then
      #Sandbox tail
    else name == "debug" then
      #Debug tail
    else name == "execpolicy" then
      #Execpolicy tail
    else name == "apply" || name == "a" then
      #Apply tail
    else name == "resume" then
      #Resume tail
    else name == "archive" then
      #Archive tail
    else name == "delete" then
      #Delete tail
    else name == "unarchive" then
      #Unarchive tail
    else name == "fork" then
      #Fork tail
    else name == "cloud" || name == "cloud-tasks" then
      #Cloud tail
    else name == "responses-api-proxy" then
      #ResponsesApiProxy tail
    else name == "stdio-to-uds" then
      #StdioToUds tail
    else name == "exec-server" then
      #ExecServer tail
    else name == "features" then
      #Features tail
    else
      #Interactive args
    end;
  else
    #Interactive args
  end;
end;

return {
  .classify_cli_head,
};
