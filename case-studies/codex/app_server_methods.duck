module () where

const { .json_object_get } = import "duck:prelude/json" ();
const { .list, .text_get, .text_length } = import "duck:prelude/functional" ();
const {} = import "./app_server_types.duck" ();
const {
  .decode_thread_archive,
  .decode_thread_compact_start,
  .decode_thread_delete,
  .decode_thread_fork,
  .decode_thread_items_list,
  .decode_thread_metadata_update,
  .decode_thread_resume,
  .decode_thread_settings_update,
  .decode_thread_start,
  .decode_thread_turns_list,
  .decode_thread_unarchive,
  .decode_thread_unsubscribe,
} = import "./app_server_thread_methods.duck" ();
const { .decode_thread_control_method } = import "./app_server_thread_control_methods.duck" ();
const { .decode_thread_goal_clear, .decode_thread_goal_get, .decode_thread_goal_set } =
  import "./app_server_goal_methods.duck" ();

type MethodJson = AppServerJson
type MethodJsonObject = JsonObject
type MethodJsonArray = JsonArray
type MethodJsonLookup = JsonLookupResult
type MethodTextOption = AppServerTextOption
type MethodI32Option = AppServerI32Option
type MethodBoolOption = AppServerBoolOption
type MethodTexts = AppServerTexts
type MethodThreadSortKey = AppServerThreadSortKey
type MethodSortDirection = AppServerSortDirection
type MethodThreadSourceKind = AppServerThreadSourceKind
type MethodThreadSourceKinds = AppServerThreadSourceKinds
type MethodThreadListParams = AppServerThreadListParams
type MethodThreadReadParams = AppServerThreadReadParams
type MethodUserInput = AppServerUserInput
type MethodUserInputs = AppServerUserInputs
type MethodTurnStartParams = AppServerTurnStartParams
type MethodTurnSteerParams = AppServerTurnSteerParams
type MethodTurnInterruptParams = AppServerTurnInterruptParams
type MethodUnknown = AppServerUnknownMethod
type Method = AppServerMethod
type MethodDecodeResult = AppServerMethodDecodeResult
type MethodTextResult = Result Text Text
type MethodTextOptionResult = Result Text MethodTextOption
type MethodI32Result = Result Text I32
type MethodI32OptionResult = Result Text MethodI32Option
type MethodBoolResult = Result Text Bool
type MethodBoolOptionResult = Result Text MethodBoolOption
type MethodTextsResult = Result Text MethodTexts
type MethodThreadSortKeyResult = Result Text MethodThreadSortKey
type MethodSortDirectionResult = Result Text MethodSortDirection
type MethodThreadSourceKindResult = Result Text MethodThreadSourceKind
type MethodThreadSourceKindsResult = Result Text MethodThreadSourceKinds
type MethodUserInputResult = Result Text MethodUserInput
type MethodUserInputsResult = Result Text MethodUserInputs

const texts = comptime list Text;
const source_kinds = comptime list MethodThreadSourceKind;
const user_inputs = comptime list MethodUserInput;

const missing_text: () -> MethodTextOption = () => #None;
const missing_i32: () -> MethodI32Option = () => #None;
const missing_bool: () -> MethodBoolOption = () => #None;

const required_text: (MethodJsonObject, Text, Text) -> MethodTextResult = (
  object: MethodJsonObject,
  key: Text,
  context: Text,
) => do
  let lookup: MethodJsonLookup = json_object_get(key, object);

  if let #Found value = lookup then
    if let #String text = value then
      #Ok text
    else
      #Err (context <> "." <> key <> " must be a string")
    end;
  else
    #Err (context <> "." <> key <> " is required")
  end;
end;

const optional_text: (MethodJsonObject, Text, Text) -> MethodTextOptionResult = (
  object: MethodJsonObject,
  key: Text,
  context: Text,
) => do
  let lookup: MethodJsonLookup = json_object_get(key, object);

  if let #Found value = lookup then
    if let #Null = value then
      #Ok (missing_text())
    else let #String text = value then
      #Ok (#Some text)
    else
      #Err (context <> "." <> key <> " must be a string or null")
    end;
  else
    #Ok (missing_text())
  end;
end;

const optional_bool: (MethodJsonObject, Text, Text) -> MethodBoolOptionResult = (
  object: MethodJsonObject,
  key: Text,
  context: Text,
) => do
  let lookup: MethodJsonLookup = json_object_get(key, object);

  if let #Found value = lookup then
    if let #Null = value then
      #Ok (missing_bool())
    else let #Bool boolean = value then
      #Ok (#Some boolean)
    else
      #Err (context <> "." <> key <> " must be a boolean or null")
    end;
  else
    #Ok (missing_bool())
  end;
end;

const default_bool: (MethodJsonObject, Text, Text, Bool) -> MethodBoolResult = (
  object: MethodJsonObject,
  key: Text,
  context: Text,
  fallback: Bool,
) => do
  let lookup: MethodJsonLookup = json_object_get(key, object);

  if let #Found value = lookup then
    if let #Bool boolean = value then
      #Ok boolean
    else
      #Err (context <> "." <> key <> " must be a boolean")
    end;
  else
    #Ok fallback
  end;
end;

const json_nonnegative_i32: MethodJson -> MethodI32Result = (value: MethodJson) => do
  if let #Number number = value then
    let valid = text_length number > 0;
    let parsed = 0;
    let exceeds_i32 = false;
    let index = 0;

    loop do
      if index >= text_length number then
        break;
      end;
      let byte = text_get (number, index);

      if byte < 48 || byte > 57 then
        valid = false
      else valid then
        let digit = byte - 48;
        if parsed > 214748364 || parsed == 214748364 && digit > 7 then
          valid = false
          exceeds_i32 = true
        else
          parsed = parsed * 10 + digit
        end;
      end;

      index = index + 1
    end;

    if valid then
      #Ok parsed
    else exceeds_i32 then
      #Err "number exceeds I32"
    else
      #Err "must be a non-negative integer"
    end;
  else
    #Err "must be a non-negative integer"
  end;
end;

const optional_i32: (MethodJsonObject, Text, Text) -> MethodI32OptionResult = (
  object: MethodJsonObject,
  key: Text,
  context: Text,
) => do
  let lookup: MethodJsonLookup = json_object_get(key, object);

  if let #Found value = lookup then
    if let #Null = value then
      #Ok (missing_i32())
    else
      let decoded = json_nonnegative_i32 value;
      if let #Ok number = decoded then
        #Ok (#Some number)
      else let #Err reason = decoded then
        #Err (context <> "." <> key <> " " <> reason)
      else
        #Err (context <> "." <> key <> " could not be decoded")
      end;
    end;
  else
    #Ok (missing_i32())
  end;
end;

let rec decode_text_values: (MethodJsonArray, MethodTexts, Text) -> MethodTextsResult = (
  values: MethodJsonArray,
  reversed: MethodTexts,
  context: Text,
) => do
  if let #Cons node = values then
    let [value, tail] = node;

    if let #String text = value then
      decode_text_values(tail, texts.prepend(text, reversed), context)
    else
      #Err (context <> " must contain only strings")
    end;
  else
    #Ok (texts.reverse reversed)
  end;
end;

const optional_texts: (MethodJsonObject, Text, Text) -> MethodTextsResult = (
  object: MethodJsonObject,
  key: Text,
  context: Text,
) => do
  let lookup: MethodJsonLookup = json_object_get(key, object);

  if let #Found value = lookup then
    if let #Null = value then
      #Ok (texts.empty())
    else let #Array values = value then
      decode_text_values(values, texts.empty(), context <> "." <> key)
    else
      #Err (context <> "." <> key <> " must be an array or null")
    end;
  else
    #Ok (texts.empty())
  end;
end;

const optional_cwd: (MethodJsonObject, Text) -> MethodTextsResult = (
  object: MethodJsonObject,
  context: Text,
) => do
  let lookup: MethodJsonLookup = json_object_get("cwd", object);

  if let #Found value = lookup then
    if let #Null = value then
      #Ok (texts.empty())
    else let #String cwd = value then
      #Ok (texts.singleton cwd)
    else let #Array values = value then
      decode_text_values(values, texts.empty(), context <> ".cwd")
    else
      #Err (context <> ".cwd must be a string, array, or null")
    end;
  else
    #Ok (texts.empty())
  end;
end;

const decode_sort_key: MethodJsonObject -> MethodThreadSortKeyResult =
  (object: MethodJsonObject) => do
    let lookup: MethodJsonLookup = json_object_get("sortKey", object);

    if let #Found value = lookup then
      if let #Null = value then
        #Ok (#CreatedAt)
      else let #String key = value then
        if key == "created_at" then
          #Ok (#CreatedAt)
        else key == "updated_at" then
          #Ok (#UpdatedAt)
        else key == "recency_at" then
          #Ok (#RecencyAt)
        else
          #Err ("thread/list.params.sortKey has unknown value " <> key)
        end;
      else
        #Err "thread/list.params.sortKey must be a string or null"
      end;
    else
      #Ok (#CreatedAt)
    end;
  end;

const decode_sort_direction: MethodJsonObject -> MethodSortDirectionResult = (
  object: MethodJsonObject) => do
    let lookup: MethodJsonLookup = json_object_get("sortDirection", object);

    if let #Found value = lookup then
      if let #Null = value then
        #Ok (#Descending)
      else let #String direction = value then
        if direction == "asc" then
          #Ok (#Ascending)
        else direction == "desc" then
          #Ok (#Descending)
        else
          #Err ("thread/list.params.sortDirection has unknown value " <> direction)
        end;
      else
        #Err "thread/list.params.sortDirection must be a string or null"
      end;
    else
      #Ok (#Descending)
    end;
  end;

const source_kind_from_text: Text -> MethodThreadSourceKindResult = (value: Text) => do
  if value == "cli" then
    #Ok (#Cli)
  else value == "vscode" then
    #Ok (#VsCode)
  else value == "exec" then
    #Ok (#Exec)
  else value == "appServer" then
    #Ok (#AppServer)
  else value == "subAgent" then
    #Ok (#SubAgent)
  else value == "subAgentReview" then
    #Ok (#SubAgentReview)
  else value == "subAgentCompact" then
    #Ok (#SubAgentCompact)
  else value == "subAgentThreadSpawn" then
    #Ok (#SubAgentThreadSpawn)
  else value == "subAgentOther" then
    #Ok (#SubAgentOther)
  else value == "unknown" then
    #Ok (#Unknown)
  else
    #Err ("thread/list.params.sourceKinds has unknown value " <> value)
  end;
end;

let rec decode_source_kind_values: (MethodJsonArray, MethodThreadSourceKinds) -> MethodThreadSourceKindsResult =
  (
    values: MethodJsonArray,
    reversed: MethodThreadSourceKinds,
  ) => do
    if let #Cons node = values then
      let [value, tail] = node;

      if let #String text = value then
        let decoded = source_kind_from_text text;
        if let #Ok source_kind = decoded then
          decode_source_kind_values(tail, source_kinds.prepend(source_kind, reversed))
        else let #Err reason = decoded then
          #Err reason
        else
          #Err "thread/list.params.sourceKinds could not be decoded"
        end;
      else
        #Err "thread/list.params.sourceKinds must contain only strings"
      end;
    else
      #Ok (source_kinds.reverse reversed)
    end;
  end;

const decode_source_kinds: MethodJsonObject -> MethodThreadSourceKindsResult = (
  object: MethodJsonObject) => do
    let lookup: MethodJsonLookup = json_object_get("sourceKinds", object);

    if let #Found value = lookup then
      if let #Null = value then
        #Ok (source_kinds.empty())
      else let #Array values = value then
        decode_source_kind_values(values, source_kinds.empty())
      else
        #Err "thread/list.params.sourceKinds must be an array or null"
      end;
    else
      #Ok (source_kinds.empty())
    end;
  end;

const decode_thread_list: MethodJson -> MethodDecodeResult = (params: MethodJson) => do
  if let #Object object = params then
    let cursor = optional_text(object, "cursor", "thread/list.params");
    let limit = optional_i32(object, "limit", "thread/list.params");
    let sort_key = decode_sort_key object;
    let sort_direction = decode_sort_direction object;
    let model_providers = optional_texts(object, "modelProviders", "thread/list.params");
    let kinds = decode_source_kinds object;
    let archived = optional_bool(object, "archived", "thread/list.params");
    let cwd = optional_cwd(object, "thread/list.params");
    let state_db_only = default_bool(object, "useStateDbOnly", "thread/list.params", false);
    let search_term = optional_text(object, "searchTerm", "thread/list.params");
    let parent = optional_text(object, "parentThreadId", "thread/list.params");
    let ancestor = optional_text(object, "ancestorThreadId", "thread/list.params");

    if let #Err reason = cursor then
      #MethodError reason
    else let #Err reason = limit then
      #MethodError reason
    else let #Err reason = sort_key then
      #MethodError reason
    else let #Err reason = sort_direction then
      #MethodError reason
    else let #Err reason = model_providers then
      #MethodError reason
    else let #Err reason = kinds then
      #MethodError reason
    else let #Err reason = archived then
      #MethodError reason
    else let #Err reason = cwd then
      #MethodError reason
    else let #Err reason = state_db_only then
      #MethodError reason
    else let #Err reason = search_term then
      #MethodError reason
    else let #Err reason = parent then
      #MethodError reason
    else let #Err reason = ancestor then
      #MethodError reason
    else let #Ok parent_id = parent then
      if let #Ok ancestor_id = ancestor then
        let both_relations = false;
        if let #Some _ = parent_id then
          if let #Some _ = ancestor_id then
            both_relations = true
          end;
        end;

        if both_relations then
          #MethodError "thread/list.params.parentThreadId and ancestorThreadId are mutually exclusive"
        else let #Ok cursor_value = cursor then
          if let #Ok limit_value = limit then
            if let #Ok sort_key_value = sort_key then
              if let #Ok sort_direction_value = sort_direction then
                if let #Ok provider_values = model_providers then
                  if let #Ok kind_values = kinds then
                    if let #Ok archived_value = archived then
                      if let #Ok cwd_values = cwd then
                        if let #Ok state_db_value = state_db_only then
                          if let #Ok search_value = search_term then
                            let decoded: MethodThreadListParams = [
                              cursor_value,
                              limit_value,
                              sort_key_value,
                              sort_direction_value,
                              provider_values,
                              kind_values,
                              archived_value,
                              cwd_values,
                              state_db_value,
                              search_value,
                              parent_id,
                              ancestor_id,
                            ];
                            #MethodOk (#ThreadList decoded);
                          else #MethodError "thread/list.params.searchTerm could not be decoded" end;
                        else #MethodError "thread/list.params.useStateDbOnly could not be decoded" end;
                      else #MethodError "thread/list.params.cwd could not be decoded" end;
                    else #MethodError "thread/list.params.archived could not be decoded" end;
                  else #MethodError "thread/list.params.sourceKinds could not be decoded" end;
                else #MethodError "thread/list.params.modelProviders could not be decoded" end;
              else #MethodError "thread/list.params.sortDirection could not be decoded" end;
            else #MethodError "thread/list.params.sortKey could not be decoded" end;
          else #MethodError "thread/list.params.limit could not be decoded" end;
        else #MethodError "thread/list.params.cursor could not be decoded" end;
      else #MethodError "thread/list.params.ancestorThreadId could not be decoded" end;
    else
      #MethodError "thread/list.params.parentThreadId could not be decoded"
    end;
  else
    #MethodError "thread/list.params must be an object"
  end;
end;

const decode_thread_read: MethodJson -> MethodDecodeResult = (params: MethodJson) => do
  if let #Object object = params then
    let thread_id = required_text(object, "threadId", "thread/read.params");
    let include_turns = default_bool(object, "includeTurns", "thread/read.params", false);

    if let #Err reason = thread_id then
      #MethodError reason
    else let #Err reason = include_turns then
      #MethodError reason
    else let #Ok id = thread_id then
      if let #Ok include_turns_value = include_turns then
        let decoded: MethodThreadReadParams = [id, include_turns_value];
        #MethodOk (#ThreadRead decoded);
      else #MethodError "thread/read.params.includeTurns could not be decoded" end;
    else
      #MethodError "thread/read.params.threadId could not be decoded"
    end;
  else
    #MethodError "thread/read.params must be an object"
  end;
end;

const decode_user_input: MethodJson -> MethodUserInputResult = (value: MethodJson) => do
  if let #Object object = value then
    let input_type = required_text(object, "type", "turn/start.params.input entry");

    if let #Err reason = input_type then
      #Err reason
    else let #Ok kind = input_type then
      if kind == "text" then
        let text = required_text(object, "text", "turn/start.params.input text");
        if let #Ok content = text then
          let text_elements: MethodJson = #Array (#Nil);
          let lookup: MethodJsonLookup = json_object_get("textElements", object);
          if let #Found elements = lookup then
            text_elements = elements
          end;
          if let #Array _ = text_elements then #Ok (#TextInput ([content, text_elements])) else
            #Err "turn/start.params.input text.textElements must be an array" end;
        else let #Err reason = text then #Err reason else #Err "turn/start.params.input text could not be decoded" end;
      else kind == "image" || kind == "localImage" then
        let field = if kind == "image" then "url" else "path" end;
        let location = required_text(object, field, "turn/start.params.input image");
        let detail = optional_text(object, "detail", "turn/start.params.input image");
        if let #Err reason = location then #Err reason else let #Err reason = detail then #Err reason
        else let #Ok place = location then
          if let #Ok detail_value = detail then
            if kind == "image" then #Ok (#ImageInput ([detail_value, place])) else #Ok (
              #LocalImageInput ([detail_value, place])
            ) end;
          else #Err "turn/start.params.input image.detail could not be decoded" end;
        else #Err "turn/start.params.input image location could not be decoded" end;
      else kind == "audio" || kind == "localAudio" then
        let field = if kind == "audio" then "url" else "path" end;
        let location = required_text(object, field, "turn/start.params.input audio");
        if let #Ok place = location then
          if kind == "audio" then #Ok (#AudioInput place) else #Ok (#LocalAudioInput place) end;
        else let #Err reason = location then #Err reason else #Err "turn/start.params.input audio location could not be decoded" end;
      else kind == "skill" || kind == "mention" then
        let name = required_text(object, "name", "turn/start.params.input reference");
        let path = required_text(object, "path", "turn/start.params.input reference");
        if let #Err reason = name then #Err reason else let #Err reason = path then #Err reason
        else let #Ok reference_name = name then
          if let #Ok reference_path = path then
            if kind == "skill" then #Ok (#SkillInput ([reference_name, reference_path])) else #Ok (
              #MentionInput ([reference_name, reference_path])
            ) end;
          else #Err "turn/start.params.input reference.path could not be decoded" end;
        else #Err "turn/start.params.input reference.name could not be decoded" end;
      else
        #Err ("turn/start.params.input has unknown type " <> kind)
      end;
    else
      #Err "turn/start.params.input type could not be decoded"
    end;
  else
    #Err "turn/start.params.input entries must be objects"
  end;
end;

let rec decode_user_inputs: (MethodJsonArray, MethodUserInputs) -> MethodUserInputsResult = (
  values: MethodJsonArray,
  reversed: MethodUserInputs,
) => do
  if let #Cons node = values then
    let [value, tail] = node;
    let decoded = decode_user_input value;

    if let #Ok input = decoded then
      decode_user_inputs(tail, user_inputs.prepend(input, reversed))
    else let #Err reason = decoded then
      #Err reason
    else
      #Err "turn/start.params.input entry could not be decoded"
    end;
  else
    #Ok (user_inputs.reverse reversed)
  end;
end;

const decode_turn_start: MethodJson -> MethodDecodeResult = (params: MethodJson) => do
  if let #Object object = params then
    let thread_id = required_text(object, "threadId", "turn/start.params");
    let client_id = optional_text(object, "clientUserMessageId", "turn/start.params");
    let input_lookup: MethodJsonLookup = json_object_get("input", object);
    let inputs: MethodUserInputsResult = #Err "turn/start.params.input is required";

    if let #Found input_value = input_lookup then
      if let #Array values = input_value then
        inputs = decode_user_inputs(values, user_inputs.empty())
      else
        inputs = #Err "turn/start.params.input must be an array"
      end;
    end;

    if let #Err reason = thread_id then
      #MethodError reason
    else let #Err reason = client_id then
      #MethodError reason
    else let #Err reason = inputs then
      #MethodError reason
    else let #Ok id = thread_id then
      if let #Ok client_id_value = client_id then
        if let #Ok input_values = inputs then
          let decoded: MethodTurnStartParams = [id, client_id_value, input_values, params];
          #MethodOk (#TurnStart decoded);
        else #MethodError "turn/start.params.input could not be decoded" end;
      else #MethodError "turn/start.params.clientUserMessageId could not be decoded" end;
    else
      #MethodError "turn/start.params.threadId could not be decoded"
    end;
  else
    #MethodError "turn/start.params must be an object"
  end;
end;

const decode_turn_steer: MethodJson -> MethodDecodeResult = (params: MethodJson) => do
  if let #Object object = params then
    let thread_id = required_text(object, "threadId", "turn/steer.params");
    let expected_turn_id = required_text(object, "expectedTurnId", "turn/steer.params");
    let client_id = optional_text(object, "clientUserMessageId", "turn/steer.params");
    let input_lookup: MethodJsonLookup = json_object_get("input", object);
    let inputs: MethodUserInputsResult = #Err "turn/steer.params.input is required";

    if let #Found input_value = input_lookup then
      if let #Array values = input_value then
        inputs = decode_user_inputs(values, user_inputs.empty())
      else
        inputs = #Err "turn/steer.params.input must be an array"
      end;
    end;

    if let #Err reason = thread_id then
      #MethodError reason
    else let #Err reason = expected_turn_id then
      #MethodError reason
    else let #Err reason = client_id then
      #MethodError reason
    else let #Err reason = inputs then
      #MethodError reason
    else let #Ok id = thread_id then
      if let #Ok expected = expected_turn_id then
        if let #Ok client_id_value = client_id then
          if let #Ok input_values = inputs then
            let decoded: MethodTurnSteerParams = [
              id,
              expected,
              client_id_value,
              input_values,
              params,
            ];
            #MethodOk (#TurnSteer decoded);
          else #MethodError "turn/steer.params.input could not be decoded" end;
        else #MethodError "turn/steer.params.clientUserMessageId could not be decoded" end;
      else #MethodError "turn/steer.params.expectedTurnId could not be decoded" end;
    else
      #MethodError "turn/steer.params.threadId could not be decoded"
    end;
  else
    #MethodError "turn/steer.params must be an object"
  end;
end;

const decode_turn_interrupt: MethodJson -> MethodDecodeResult = (params: MethodJson) => do
  if let #Object object = params then
    let thread_id = required_text(object, "threadId", "turn/interrupt.params");
    let turn_id = required_text(object, "turnId", "turn/interrupt.params");

    if let #Err reason = thread_id then
      #MethodError reason
    else let #Err reason = turn_id then
      #MethodError reason
    else let #Ok thread = thread_id then
      if let #Ok turn = turn_id then
        let decoded: MethodTurnInterruptParams = [thread, turn];
        #MethodOk (#TurnInterrupt decoded);
      else #MethodError "turn/interrupt.params.turnId could not be decoded" end;
    else
      #MethodError "turn/interrupt.params.threadId could not be decoded"
    end;
  else
    #MethodError "turn/interrupt.params must be an object"
  end;
end;

const decode_app_server_method: (Text, MethodJson) -> MethodDecodeResult = (
  name: Text,
  params: MethodJson,
) => do
  if name == "thread/list" then
    decode_thread_list params
  else name == "thread/read" then
    decode_thread_read params
  else name == "thread/start" then
    decode_thread_start params
  else name == "thread/resume" then
    decode_thread_resume params
  else name == "thread/fork" then
    decode_thread_fork params
  else name == "thread/archive" then
    decode_thread_archive params
  else name == "thread/unarchive" then
    decode_thread_unarchive params
  else name == "thread/delete" then
    decode_thread_delete params
  else name == "thread/unsubscribe" then
    decode_thread_unsubscribe params
  else name == "thread/compact/start" then
    decode_thread_compact_start params
  else name == "thread/metadata/update" then
    decode_thread_metadata_update params
  else name == "thread/settings/update" then
    decode_thread_settings_update params
  else name == "thread/turns/list" then
    decode_thread_turns_list params
  else name == "thread/items/list" then
    decode_thread_items_list params
  else name == "thread/name/set" then
    decode_thread_control_method(#SetThreadName, params)
  else name == "thread/increment_elicitation" then
    decode_thread_control_method(#IncrementThreadElicitation, params)
  else name == "thread/decrement_elicitation" then
    decode_thread_control_method(#DecrementThreadElicitation, params)
  else name == "thread/goal/set" then
    decode_thread_goal_set params
  else name == "thread/goal/get" then
    decode_thread_goal_get params
  else name == "thread/goal/clear" then
    decode_thread_goal_clear params
  else name == "turn/start" then
    decode_turn_start params
  else name == "turn/steer" then
    decode_turn_steer params
  else name == "turn/interrupt" then
    decode_turn_interrupt params
  else
    let unknown: MethodUnknown = [name, params];
    #MethodOk (#UnknownMethod unknown);
  end;
end;

return {
  .decode_app_server_method,
  .decode_thread_list,
  .decode_thread_read,
  .decode_thread_start,
  .decode_thread_resume,
  .decode_thread_fork,
  .decode_thread_archive,
  .decode_thread_unarchive,
  .decode_thread_delete,
  .decode_thread_unsubscribe,
  .decode_thread_compact_start,
  .decode_thread_metadata_update,
  .decode_thread_settings_update,
  .decode_thread_turns_list,
  .decode_thread_items_list,
  .decode_thread_control_method,
  .decode_thread_goal_set,
  .decode_thread_goal_get,
  .decode_thread_goal_clear,
  .decode_turn_start,
  .decode_turn_steer,
  .decode_turn_interrupt,
};
