module () where

const {} = import "./agent_job_spawn_types.duck" ();
const { .decode_agent_job_spawn_text_options } = import "./agent_job_spawn_json_text.duck" ();

type FixtureArgs = AgentJobSpawnDecodedArgs

let base: FixtureArgs = [
  .csv_path = "input.csv",
  .instruction = "Review {path}",
  .id_column = #None,
  .output_path = #None,
  .output_schema_json = #None,
  .max_concurrency = #None,
  .max_workers = #None,
  .max_runtime_seconds = #None,
];
let score = 0;
let valid = decode_agent_job_spawn_text_options(
  "{\"id_column\":\"id\",\"output_csv_path\":\"out.csv\"}",
  base,
);
if let #SpawnDecoded args = valid then
  let id_valid = if let #Some value = args.id_column then value == "id" else false end;
  let output_valid = if let #Some value = args.output_path then value == "out.csv" else false end;
  if id_valid && output_valid then
    score = 1
  end;
end;
let invalid = decode_agent_job_spawn_text_options("{\"id_column\":42}", base);
if let #SpawnDecodeFailed reason = invalid then
  if reason == "id_column must be a string" then
    score = score + 10
  end;
end;

return { .score = score };
